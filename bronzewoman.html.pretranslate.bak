              <div class="adx-meta-field__label">Country</div>
              <div class="adx-meta-field__value"><span class="adx-meta-pill" id="adxCountry">—</span></div>
            </div>
            <div class="adx-meta-field">
              <div class="adx-meta-field__label">Magazine</div>
