        </aside>
        <div class="adx-split-image">
          <a href="#" id="adxImageLink" data-adx-lightbox>
            <img id="adxImage" src="" alt="" loading="lazy" decoding="async">
          </a>
          <div id="adx-doc-nav" aria-label="Document navigation">
