</script>

<script>
(function () {
  var canvas = document.getElementById('dot-grid-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var SPACING = 30;
  var PLUS_SIZE = 6;
  var raf = null;

  var INTRO_THEME = { bg: '#0048f5', plus: '#f7f7f5', opacity: 0.22 };
  var CANVAS_THEME = { bg: '#F7F7F5', plus: '#a8b3dd', opacity: 0.35 };

  function themeForIntro() {
    var intro = document.body.classList.contains('intro-active');
    return intro ? INTRO_THEME : CANVAS_THEME;
  }

  function drawPlus(cx, cy, size) {
    var half = size * 0.5;
    ctx.beginPath();
    ctx.moveTo(cx - half, cy);
    ctx.lineTo(cx + half, cy);
    ctx.moveTo(cx, cy - half);
    ctx.lineTo(cx, cy + half);
    ctx.stroke();
  }

  function drawPatternWithTheme(theme) {
    var dpr = window.devicePixelRatio || 1;
    var w = window.innerWidth;
    var h = window.innerHeight;
    canvas.width = Math.ceil(w * dpr);
    canvas.height = Math.ceil(h * dpr);
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.fillStyle = theme.bg;
    ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = theme.plus;
    ctx.lineWidth = 1;
    ctx.lineCap = 'square';
    ctx.globalAlpha = theme.opacity;
    for (var y = SPACING * 0.5; y < h; y += SPACING) {
      for (var x = SPACING * 0.5; x < w; x += SPACING) {
        drawPlus(x, y, PLUS_SIZE);
      }
    }
    ctx.globalAlpha = 1;
  }

  function drawPattern() {
    drawPatternWithTheme(themeForIntro());
  }

  function scheduleDraw() {
    if (raf) return;
    raf = requestAnimationFrame(function () {
      raf = null;
      drawPattern();
    });
  }

  drawPattern();
  window.redrawDotGrid = drawPattern;
  window.addEventListener('resize', scheduleDraw);
})();
</script>

</body>
</html>
