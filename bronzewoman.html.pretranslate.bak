    <div class="adx-lightbox" id="adxLightbox">
      <img id="adxLightboxImg" src="" alt="" loading="lazy" decoding="async">
    </div>

    <!-- ───────── Artifact panel (bottom-left) ───────── -->
    <div class="artifact-stack" id="artifactStack">
      <button type="button" class="artifact-index-tab" id="artifactIndexTab" aria-label="Open index">
        <span class="artifact-index-tab__icon" aria-hidden="true"></span>
        <span class="artifact-index-tab__label">INDEX</span>
        <span class="artifact-index-tab__back" aria-hidden="true">←</span>
      </button>

      <aside class="artifact-card" id="artifactCard" aria-label="Document information">
        <header class="artifact-card__head">
          <span class="artifact-card__eyebrow">
            <span class="artifact-card__dot" aria-hidden="true"></span>
            ARTIFACT
          </span>
          <button type="button" class="artifact-card__close" id="artifactCardClose" aria-label="Close panel">×</button>
        </header>

        <div class="artifact-card__body">
          <h2 class="artifact-card__title" id="artifactTitle">On the Impulse to Notate</h2>
          <p class="artifact-card__subtitle" id="artifactSubtitle">Darwish Alami Library</p>
          <p class="artifact-card__meta" id="artifactMeta">ARCHIVE, RESEARCH, DESIGN</p>
          <p class="artifact-card__period" id="artifactPeriod">2024 — PRESENT</p>
          <p class="artifact-card__desc" id="artifactDesc">A scattered field of Arab magazine clippings — portraits, advertisements, street scenes, and leisure pages from mid-century print culture.</p>
          <ol class="artifact-card__notes" id="artifactNotes"></ol>
        </div>

        <div class="artifact-card__sections">
          <button type="button" class="artifact-section__toggle" data-section="details" aria-expanded="false" aria-controls="artifactDetailsPanel">
            <span class="artifact-section__icon" aria-hidden="true">☰</span>
            <span>DETAILS</span>
            <span class="artifact-section__plus" aria-hidden="true">+</span>
          </button>
          <div class="artifact-section__panel" id="artifactDetailsPanel" hidden>
            <div id="artifactFilterRows">
              <div class="artifact-filter-row active" data-cat="all">
                <span class="artifact-filter-row__name">All</span>
                <span class="artifact-filter-row__count" data-count="0">—</span>
              </div>
              <div class="artifact-filter-row" data-cat="People">
                <span class="artifact-filter-row__name">People</span>
                <span class="artifact-filter-row__count" data-count="0">0</span>
              </div>
              <div class="artifact-filter-row" data-cat="Desires">
                <span class="artifact-filter-row__name">Desires</span>
                <span class="artifact-filter-row__count" data-count="0">0</span>
              </div>
              <div class="artifact-filter-row" data-cat="Leisure">
                <span class="artifact-filter-row__name">Leisure</span>
                <span class="artifact-filter-row__count" data-count="0">0</span>
              </div>
              <div class="artifact-filter-row" data-cat="Street">
                <span class="artifact-filter-row__name">Street</span>
                <span class="artifact-filter-row__count" data-count="0">0</span>
              </div>
            </div>
          </div>

          <button type="button" class="artifact-section__toggle" data-section="reading" aria-expanded="false" aria-controls="artifactReadingPanel">
            <span class="artifact-section__icon" aria-hidden="true">↗</span>
            <span>FURTHER READING</span>
            <span class="artifact-section__plus" aria-hidden="true">+</span>
          </button>
          <div class="artifact-section__panel" id="artifactReadingPanel" hidden>
            <p id="artifactReadingText">Select a category in Details to read its description.</p>
          </div>
        </div>
      </aside>
    </div>

    <!-- ───────── Category explanation page ───────── -->
    <section class="category-page" id="categoryPage" aria-hidden="true" hidden>
      <div class="category-page__inner">
        <h1 class="category-page__title" id="categoryPageTitle"></h1>
        <p class="category-page__tagline" id="categoryPageTagline"></p>
        <div class="category-page__body" id="categoryPageBody"></div>
      </div>
      <div class="category-page__images" id="categoryPageImages"></div>
      <button type="button" class="category-page__next" id="categoryPageNext">[NEXT]</button>
    </section>


    <!-- ───────── MAIN ───────── -->
    <div id="main" class="sc-beqWNU sc-kgKWtt hjrenG etumZA" style="opacity:1; transform: translate(calc(-4500px + 50vw), calc(-3000px + 50vh)) scale(1); transform-origin: 0 0;">
      <!-- title-opening -->
      <div class="story-section-title" id="title-opening"><h2>In His Presence</h2></div>

      <!-- fragment-intro -->
      <div id="fragment-intro" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This page is not a passive historical record; it is an attempt to reconstruct the visual subconscious of a generation—including that of my grandfather. In the mid-20th century, these magazines were not just paper; they were the architects of daily trends and shared dreams that permanently engraved themselves into people's memories, becoming an inseparable part of who they were.</p>
          <p class="sc-fsQjcA bQLSfx">What you see here is a forensic excavation into an inherited mind. We step back into their memory to see how they perceived people, streets, politics, and consumerism. By isolating these fragments, we uncover the manufactured desires and intimate stories that shaped their everyday lives.</p>
        </div>
      </div>


      <!-- fragment-ch1 -->
      <div id="fragment-ch1" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">The modern project began with the face. <span class="sc-qRuZU bDzMCU">People</span> isolates the highly stylized, heavily retouched studio portraits and magazine covers that dominated the era's aesthetics. These were the exact faces my grandfather and his peers looked up to on newsstands, accepting them as the gold standard of modern style and beauty. We look past the individuals to expose the industrialized gaze that dictated how a generation was taught to perceive itself.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-Kawakib/kawakib_0019.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[001]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-ch2 -->
      <div id="fragment-ch2" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">Behind the perfect faces lay the promises of a better life. <span class="sc-qRuZU bDzMCU">Desires</span> merges commercial advertisements with the glossy lifestyle pages of publications like <span class="sc-qRuZU bDzMCU" style="font-style:italic;">Al-Mawed</span>. These images fully furnished the domestic aspirations of the time—the modern appliance, the sleek car, the celebrity lifestyle. We map how commercial goods became intimate, urgent longings, permanently etched into their minds as the very definition of a successful, modern life.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-ethnayn%20wa%20aldonya%203/ethnayn3_0340.jpeg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[002]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-ch3 -->
      <div id="fragment-ch3" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">Modernity did not just organize labor; it strictly manufactured free time. <span class="sc-qRuZU bDzMCU">Leisure</span> interrogates the manufactured spaces of escape—the beaches, cinemas, and concert halls. These fragments reveal how print media taught the middle class how to enjoy their modern temporalities. These highly aestheticized rituals of public joy became the brightest shards in their memory, offering a curated refuge from daily routines and political anxieties.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-alam/alam_0055.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[003]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-ch4 -->
      <div id="fragment-ch4" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">Finally, the manufactured dream collides with the literal asphalt my grandfather walked upon. <span class="sc-qRuZU bDzMCU">Street</span> captures the public sphere—its political friction, workers' labor, and rising modernist architecture. The street was the volatile stage where editorial illusions met raw reality. Here, we see the city through their eyes, tracing the exact moments where grand political ideologies intersected with the quiet struggle of daily life.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-alam/alam_0062.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[004]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-cases-intro -->
      <div id="fragment-cases-intro" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">What follows is a series of visual deconstructions — fifteen pages pulled from across the archive and read for the shared grammar of mid-century print: the gossip headline, the imported beauty standard, the lifestyle promise, the manufactured pleasure, the political shock. Each case isolates the callouts that did the work — typography, central image, framing — and analyses the desire being engineered.</p>
        </div>
      </div>

      <!-- title-cases-people -->
      <div class="story-section-title" id="title-cases-people"><h2>People</h2></div>

      <!-- fragment-case-01 -->
      <div id="fragment-case-01" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">In this example, we witness the industrial production of celebrity obsession. The bold, hand-drawn Arabic typography poses a highly provocative, sensational question. Print media wasn't just selling static faces; it was offering my grandfather's generation a backstage pass into the romantic conflicts and private decisions of stars, converting their intimate lives into mass-market trends and essential daily social chatter.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-Mawed/mawed_0112.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[005]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-02 -->
      <div id="fragment-case-02" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This double-page spread captures how global cinematic trends and progressive discourse infiltrated the local subconscious. The sensationalist headline links 'Existentialism after divorce' directly to local actresses, benchmarking them against Western icons like Marilyn Monroe. For my grandfather's generation, these layouts were the visual stage of a shifting society, where the female body and modern emancipation were framed as both shock and style.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-Mawed/mawed_0167.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[006]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-03 -->
      <div id="fragment-case-03" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This fragment represents the peak of globalized fan hysteria. The image captures international pop idol Paul Anka signing autographs directly onto the legs of female fans in Italy. Translating and publishing these provocative cultural shocks in Arabic kept my grandfather and his peers directly plugged into the global zeitgeist, cross-contaminating local societies with Western visual hysteria.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-Mawed/mawed_0242.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[007]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- title-cases-desires -->
      <div class="story-section-title" id="title-cases-desires"><h2>Desires</h2></div>

      <!-- fragment-case-04 -->
      <div id="fragment-case-04" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This 1947 cover of <em>Al-Ithnayn</em> functions as the literal gateway of imported modern desire into the local subconscious. By placing Hollywood star Susan Hayward on the cover alongside the promise of a 'New Year Gift,' print media created a visual trend that intertwined global celebrity glamour with local optimism for the future, training my grandfather's generation to consume international beauty.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-ethnayn%20wa%20aldonya%203/ethnayn3_0125.jpeg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[008]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-05 -->
      <div id="fragment-case-05" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This illustrated advertisement for <em>Rawda Soap</em> redefines personal hygiene as a sensual, modern ritual of self-care. Showcasing a woman relaxing in a bubble bath was the ultimate display of consumerist allure for the era. This layout wasn't selling a bar of soap to my grandfather's generation; it was engineering an intimate desire for modern luxury.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-ethnayn%20wa%20aldonya%203/ethnayn3_0293.jpeg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[009]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-06 -->
      <div id="fragment-case-06" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This bold advertisement for <em>FAB</em> captures the manufacturing of desire through the myth of Western technological superiority, explicitly stating it is 'The miracle laundry powder from America.' For my grandfather and his peers, anything labeled 'American' carried a psychological promise of liberation, packaging domestic chore not as labor, but as an exciting lifestyle upgrade.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-alam/alam_0017.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[010]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-07 -->
      <div id="fragment-case-07" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This sophisticated color advertisement for <em>Surf</em> elevates consumerist longing into the realm of high-society prestige. Pairing a laundry detergent with two impeccably dressed men in premium white suits and bow ties is a masterclass in psychological class mobility, defining cleanliness as a direct ticket to 'social pride' and modern masculinity.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-alam/alam_0020.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[011]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- title-cases-leisure -->
      <div class="story-section-title" id="title-cases-leisure"><h2>Leisure</h2></div>

      <!-- fragment-case-08 -->
      <div id="fragment-case-08" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This advertisement for the 'Chammass Dance Institute' in Lebanon captures the literal institutionalization of modern leisure. Free time wasn't framed as spontaneous, but as a structured civic ritual requiring proper mastery of Western trends (Mambo, Cha-Cha-Cha, Ballet). It visualized the strict training of the Arab body to perform Western social etiquette.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-Mawed/mawed_0090.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[012]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-09 -->
      <div id="fragment-case-09" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This vivid, sun-drenched color photograph of a woman on the coast captures the media's deliberate construction of 'summer escapism.' The beach is framed not as natural geography, but as a glossy, cinematic stage for sensual freedom and leisure, teaching my grandfather's generation how to visualize the perfect vacation away from political anxieties.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-alam/alam_0107.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[013]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-10 -->
      <div id="fragment-case-10" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This layout features a 'complete dance by Nagwa Fouad,' presenting public performance and physical movement as the ultimate expressions of nightlife and modern entertainment. The kinetic energy of the dancer framed by hand-drawn stars captured the manufactured euphoria of the stage, offering a rhythmic, visual escape into the glamorous spaces of modern theater.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-Mawed/mawed_0153.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[014]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-11 -->
      <div id="fragment-case-11" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This dramatic, cyan-toned feature on Lebanon's <em>Jeita Grotto</em> exemplifies how print media manufactured local tourism into an elite leisure ritual. Framing a natural cave as the 'Eighth Wonder of the World' re-imagined local geography through a highly aestheticized, modern lens, training my grandfather's generation to consume their own landscape as a sublime spectacle.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-alam/alam_0064.jpg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[015]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- title-cases-street -->
      <div class="story-section-title" id="title-cases-street"><h2>Street</h2></div>

      <!-- fragment-case-12 -->
      <div id="fragment-case-12" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">In this fragment, the glossy commercial illusion of the printing press shatters to reveal genuine urban anxiety. The sensational headline, 'Suicide of an Egyptian Model!' alongside the phrase 'The Unknown Future,' captures the darker undertones and psychological friction of rapid modernization within the public sphere, mirroring real-world socio-economic fears.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-ethnayn%20wa%20aldonya%203/ethnayn3_0056.jpeg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[016]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-13 -->
      <div id="fragment-case-13" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This layout shifts the lens entirely back to the heavy political and ideological battles of the Arab street. The feature titled 'The Mufti of Palestine Disappears 7 Times!' documents how mid-century print media functioned as a vital engine for anti-colonial mobilization, directly shaping the daily political consciousness of my grandfather's peers.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-ethnayn%20wa%20aldonya%203/ethnayn3_0067.jpeg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[017]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-14 -->
      <div id="fragment-case-14" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This example illustrates how the entire fabric of society—specifically young women and students—was mobilized to support the public front. The feature 'To Entertain Our Heroes' details female school students preparing care packages for wartime soldiers. The inclusion of hand-written letters within the layout adds an intimate, authentic emotional layer of vernacular solidarity.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-ethnayn%20wa%20aldonya%203/ethnayn3_0224.jpeg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[018]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-case-15 -->
      <div id="fragment-case-15" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">This is the precise moment where the editorial dream completely collapses into hot dust and literal ruin. The page titled 'The Battle of Jerusalem...' provides a stark, un-retouched photographic documentation of shelling, structural urban destruction, and trench warfare, visualizing the brutal geography and erasure that my grandfather's generation witnessed firsthand.</p>
        </div>
        <div class="sc-fbJSV sc-ktEKgv cMpCWD eJya-DH">
          <span class="sc-qRuZU bDzMCU"><figure class="sc-gLDymS kDaSRJ"><div class="sc-eDDOjk emRKAu"><img alt="" data-fixed-src="true" src="Al-ethnayn%20wa%20aldonya%203/ethnayn3_0071.jpeg" loading="lazy" class="sc-jTrOVX bVdezp" decoding="async"></div><figcaption><p>[019]</p></figcaption></figure></span>
        </div>
      </div>

      <!-- fragment-conclusion -->
      <div id="fragment-conclusion" class="sc-blLrKi sc-dKfzUc hcVcSx hVgjre">
        <div class="sc-hAtFlw sc-fGFvMH hlmnvF kOvvMA">
          <p class="sc-fsQjcA bQLSfx">Ultimately, this interactive archive is not an act of romantic nostalgia; it is an urgency to rescue an inherited visual subconscious from vanishing, using the tools of contemporary design. By ripping these images from the forgotten pages of mid-century print and transforming them into floating digital shards, we are not just rearranging papers—we are reconstructing the architecture of memory that shaped my grandfather and his peers.</p>
          <p class="sc-fsQjcA bQLSfx">This project invites both the global and local user to contemplate how fleeting trends and commercial promises crystallize over time into intimate personal histories, and how a manufactured illusion can become an inseparable part of our authentic identity.</p>
        </div>
      </div>

    </div><!-- /#main -->
  </div><!-- /.sc-BKzFX -->
</div><!-- /#root -->

<!-- ── Taxonomy filter (bottom-left, body-level so it stays fixed) ── -->
<!-- ───────── Gallery action bar ───────── -->
<div id="gallery-action-bar">
  <button class="gab-filter" id="gab-filter-btn">[TEXT]</button>
  <button class="gab-grid" id="gab-grid-btn">GRID</button>
</div>

<aside class="taxonomy-bar" id="taxonomyBar" aria-label="Filter">

  <!-- Category panel: opens above the bar when Category tab is clicked -->
  <div class="taxonomy-bar__panel" id="catPanel" data-for="cat">
    <ul class="taxonomy-bar__list" role="tablist">
      <li><button type="button" class="taxonomy-bar__btn is-active" data-cat="all" role="tab" aria-selected="true">All</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-cat="People" role="tab" aria-selected="false">People</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-cat="Desires" role="tab" aria-selected="false">Desires</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-cat="Leisure" role="tab" aria-selected="false">Leisure</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-cat="Street" role="tab" aria-selected="false">Street</button></li>
    </ul>
  </div>

  <!-- Magazine panel: opens above the bar when Magazine tab is clicked (gallery mode only) -->
  <div class="taxonomy-bar__panel taxonomy-bar__panel--mag" id="magPanel" data-for="mag">
    <ul class="taxonomy-bar__list">
      <li><button type="button" class="taxonomy-bar__btn" data-mag="all">All</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-mag="Al-Kawakib">Al-Kawakib</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-mag="Al-Mawed">Al-Mawed</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-mag="Al-Rissalah">Al-Rissalah</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-mag="Al-Thqafa">Al-Thqafa</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-mag="Al-Alam">Al-Alam</button></li>
      <li><button type="button" class="taxonomy-bar__btn" data-mag="Al-Ethnayn wa Aldonya">Al-Ethnayn</button></li>
    </ul>
  </div>

  <!-- Single-row tab strip -->
  <div class="taxonomy-bar__tabs">
    <button type="button" class="taxonomy-bar__tab" data-panel="cat">Category</button>
    <button type="button" class="taxonomy-bar__tab taxonomy-bar__tab--mag" data-panel="mag">Magazine</button>
    <button type="button" class="taxonomy-bar__tab taxonomy-bar__tab--grid" id="order-btn" aria-label="Toggle grid view">
      <span class="taxonomy-bar__circle">○</span>
      <span class="taxonomy-bar__btn-label">Grid</span>
    </button>
  </div>

</aside>

<!-- ───────── Slide-out panel ───────── -->
<aside id="index-panel" class="index-panel" aria-hidden="true">
  <button type="button" class="index-close" data-close aria-label="Close index panel">[CLOSE]</button>
  <img id="index-preview" alt="" class="index-preview" hidden loading="lazy" decoding="async">
  <div id="index-meta" class="index-meta" aria-hidden="true">
    <h3 id="meta-name"></h3>
    <dl>
      <dt>Publisher</dt><dd id="meta-publisher"></dd>
      <dt>Editor</dt><dd id="meta-editor"></dd>
      <dt>Country</dt><dd id="meta-country"></dd>
      <dt>Date</dt><dd id="meta-date"></dd>
      <dt>Volume</dt><dd id="meta-volume"></dd>
    </dl>
  </div>
  <div class="index-table">
    <div class="index-row index-head">
      <div class="col-ref">REFERENCE <span class="sort-arrow active">&uarr;</span></div>
      <div class="col-medium">CATEGORY <span class="sort-arrow">&uarr;</span></div>
      <div class="col-section">MAGAZINE <span class="sort-arrow">&uarr;</span></div>
    </div>
    <!-- rows populated by JS -->
  </div>
</aside>

<!-- Archive categories generated from library/csv/archive_classification_*.csv -->
<script src="archive_categories.js"></script>
<!-- Per-document captions for Al-Kawakib, generated from women_analysis_Al-Kawakib.csv -->
<script src="kawakib_descriptions.js"></script>

<script>
  // ── Swap placeholder image paths with the full local archive ──────────
  // Pulls from all 8 magazine folders (1272 images total) and assigns them
  // to figures via a deterministic shuffle so each refresh is stable.
  (function loadAllArchiveImages() {
    const sets = [
      { folder: 'Al-Kawakib',                prefix: 'kawakib_',                       count: 23,  ext: 'jpg',  pad: 4 },
      { folder: 'Al-Mawed',                  prefix: 'mawed_',                         count: 246, ext: 'jpg',  pad: 4 },
      { folder: 'Al-Rissalah',               prefix: 'الرسالة_', count: 36,  ext: 'JPG',  pad: 0 },
      { folder: 'Al-Thqafa',                 prefix: 'CamScanner 18-05-2026 13.33_',   count: 9,   ext: 'JPG',  pad: 0 },
      { folder: 'Al-alam',                   prefix: 'alam_',                          count: 144, ext: 'jpg',  pad: 4 },
      { folder: 'Al-ethnayn wa Aldonya',     prefix: 'ethnayn_',                       count: 36,  ext: 'jpg',  pad: 4 },
      { folder: 'Al-ethnayn wa aldonya 2',   prefix: 'ethnayn2_',                      count: 430, ext: 'jpeg', pad: 4 },
      { folder: 'Al-ethnayn wa aldonya 3',   prefix: 'ethnayn3_',                      count: 348, ext: 'jpeg', pad: 4 },
    ];

    // Build the full path list (URL-encode each part so spaces / Arabic / dots are safe)
    const paths = [];
    sets.forEach((s) => {
      for (let i = 1; i <= s.count; i++) {
        const num = s.pad > 0 ? String(i).padStart(s.pad, '0') : String(i);
        const filename = s.prefix + num + '.' + s.ext;
        paths.push(encodeURIComponent(s.folder) + '/' + encodeURIComponent(filename));
      }
    });

    // Local deterministic rand (don't depend on `rand` hoisting order)
    const r = (n) => {
      const x = Math.sin(n * 12.9898) * 43758.5453;
      return x - Math.floor(x);
    };
    // Fisher–Yates with seeded random → stable across reloads, varied selection
    for (let i = paths.length - 1; i > 0; i--) {
      const j = Math.floor(r(i + 91) * (i + 1));
      const tmp = paths[i]; paths[i] = paths[j]; paths[j] = tmp;
    }

    // The canvas renders every document at ~170px wide, but the scans are
    // ~1200×1800 (over 1GB total). Decoding/rescaling those full-res bitmaps
    // is what made click/drag/pan stutter — so figures display a 512px thumb
    // from thumbs/<folder>/<file>, and detail/lightbox views resolve back to
    // the original via FULL_SRC().
    const THUMB_PREFIX = 'thumbs/';
    window.FULL_SRC = function (src) {
      return (src || '').replace(/(^|\/)thumbs\//, '$1');
    };
    // If a thumbnail is missing (not generated yet), quietly fall back to the
    // full-res scan so no document ever renders broken.
    document.getElementById('main').addEventListener('error', (e) => {
      const img = e.target;
      if (img && img.tagName === 'IMG' && /(^|\/)thumbs\//.test(img.getAttribute('src') || '')) {
        img.src = window.FULL_SRC(img.getAttribute('src'));
      }
    }, true);

    // Assign as many paths as we have existing figures — but skip any image
    // that opts out via `data-fixed-src` (e.g. the STORY case-study images
    // pair with a specific archive scan and should NOT be reshuffled).
    const existingImgs = document.querySelectorAll('#main img');
    let assignIdx = 0;
    // Assign shuffled paths to non-fixed figures and give each a caption ref.
    let nextRef = 20;
    existingImgs.forEach((img) => {
      if (img.hasAttribute('data-fixed-src')) {
        // Fixed-src story images still swap their *display* source to the thumb.
        const cur = img.getAttribute('src') || '';
        if (cur && !/(^|\/)thumbs\//.test(cur)) img.src = THUMB_PREFIX + cur;
        return;
      }
      img.src = THUMB_PREFIX + paths[assignIdx % paths.length];
      assignIdx++;
      const fig = img.closest('figure');
      if (fig) {
        let fc = fig.querySelector('figcaption');
        if (!fc) {
          fc = document.createElement('figcaption');
          fig.appendChild(fc);
        }
        let cap = fc.querySelector('p');
        if (!cap) {
          cap = document.createElement('p');
          fc.appendChild(cap);
        }
        cap.textContent = '[' + String(nextRef).padStart(3, '0') + ']';
        nextRef++;
      }
    });

    // Append remaining paths as "extra" figures so every archive image gets
    // used. `used` counts how many paths actually got consumed by the loop
    // above (skipping data-fixed-src imgs), not the raw existing-img count.
    const used = assignIdx;
    const remaining = paths.length - used;
    if (remaining > 0) {
      const main = document.getElementById('main');
      const extras = document.createElement('div');
      extras.className = 'image-extras';
      let html = '';
      const START_REF = nextRef;
      for (let i = 0; i < remaining; i++) {
        const src = THUMB_PREFIX + paths[used + i];
        const refNum = String(START_REF + i).padStart(3, '0');
        html +=
          '<span class="sc-qRuZU bDzMCU">' +
            '<figure class="sc-gLDymS kDaSRJ">' +
              '<div class="sc-eDDOjk emRKAu">' +
                '<img alt="" loading="lazy" class="sc-jTrOVX bVdezp" src="' + src + '" decoding="async">' +
              '</div>' +
              '<figcaption><p>[' + refNum + ']</p></figcaption>' +
            '</figure>' +
          '</span>';
      }
      extras.innerHTML = html;
      main.appendChild(extras);
    }
  })();

  // ── Tag every other text+image fragment with `.alt` so the catalogue layout
  //    alternates image-right / image-left down the page. CSS handles the
  //    actual reorder via `order` on the grid items.
  (function tagAlternatingFragments() {
    document.querySelectorAll('#main > .sc-blLrKi').forEach((frag, idx) => {
      if (idx % 2 === 1) frag.classList.add('alt');
    });
  })();

  // ── Tag landscape (horizontal) figures so they can take a wider grid track
  //    in ORDER view. Runs once per image after it loads — once tagged, the
  //    `.is-landscape` class persists so it works for every entry to ORDER mode.
  // ── Tag every figure with its magazine name. The catalogue (ORDER) view
  //    renders this via the figure's `::before` pseudo-element, which reads
  //    `attr(data-magazine)`. The lookup mirrors the same folder slug → label
  //    map used elsewhere in the page.
  (function tagFigureMagazines() {
    const MAGAZINE_LABELS = {
      'Al-Kawakib': 'Al-Kawakib',
      'Al-Mawed': 'Al-Mawed',
      'Al-Rissalah': 'Al-Rissalah',
      'Al-Thqafa': 'Al-Thqafa',
      'Al-alam': 'Al-Alam',
      'Al-ethnayn wa Aldonya': 'Al-Ethnayn wa Aldonya',
      'Al-ethnayn wa aldonya 2': 'Al-Ethnayn wa Aldonya',
      'Al-ethnayn wa aldonya 3': 'Al-Ethnayn wa Aldonya',
    };
    document.querySelectorAll('#main .sc-gLDymS').forEach((fig) => {
      const img = fig.querySelector('img');
      if (!img) return;
      const raw = img.getAttribute('src') || img.src || '';
      if (!raw) return;
      const path = raw.split(/[?#]/)[0];
      const parts = path.split('/').filter(Boolean);
      if (parts.length < 2) return;
      const folder = decodeURIComponent(parts[parts.length - 2]);
      fig.setAttribute('data-magazine', MAGAZINE_LABELS[folder] || folder);
    });
  })();

  // Exposed so the taxonomy-bar click handler can filter the gallery by magazine.
  window.filterGalleryByMagazine = function (mag) {
    const figs = document.querySelectorAll('#main .sc-gLDymS');
    if (mag === 'all') {
      figs.forEach((f) => f.classList.remove('filter-hidden'));
    } else {
      figs.forEach((f) => {
        const m = f.getAttribute('data-magazine') || '';
        if (m === mag) f.classList.remove('filter-hidden');
        else f.classList.add('filter-hidden');
      });
    }
  };

  (function tagLandscapeFigures() {
    const LANDSCAPE_RATIO = 1.15;   // > 1 = landscape; small margin skips near-square pages
    function tagFromImg(img) {
      if (!img.naturalWidth || !img.naturalHeight) return;
      if (img.naturalWidth / img.naturalHeight < LANDSCAPE_RATIO) return;
      const fig = img.closest('.sc-gLDymS');
      if (fig) fig.classList.add('is-landscape');
    }
    document.querySelectorAll('#main img').forEach((img) => {
      if (img.complete) tagFromImg(img);
      else img.addEventListener('load', () => tagFromImg(img), { once: true });
    });
  })();

  // Fade figures in as they enter the viewport
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    });
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });

  document.querySelectorAll('.sc-eDDOjk').forEach((el) => {
    // strip any inline opacity that came from the React paste
    el.style.opacity = '';
    io.observe(el);
  });

  // Panel toggles
  const indexBtn = document.getElementById('index-btn');
  const indexPanel = document.getElementById('index-panel');

  function closeAll() {
    if (indexPanel) indexPanel.classList.remove('open');
    indexBtn.textContent = '[INDEX]';
  }
  function staggerIndexRows() {
    // Rows fade in after the panel has started sliding — base delay lets the
    // drawer motion read first, then a slower cascade (~110 ms per row).
    const ROW_BASE_MS = 320;
    const ROW_STEP_MS = 110;
    const rows = indexPanel.querySelectorAll('.index-row:not(.index-head)');
    rows.forEach((row, i) => {
      row.style.animationDelay = (i < 25 ? ROW_BASE_MS + i * ROW_STEP_MS : 0) + 'ms';
    });
  }
  indexBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = indexPanel.classList.contains('open');
    closeAll();
    if (!open) {
      staggerIndexRows();
      indexPanel.classList.add('open');
      indexBtn.textContent = '[CLOSE]';
    }
  });
  document.querySelectorAll('[data-close]').forEach(btn =>
    btn.addEventListener('click', closeAll)
  );
  document.addEventListener('click', (e) => {
    // Close only when the click lands outside the index panel *and* outside
    // the [INDEX] button — the original selector was the wrong class
    // (`.panel`) which meant clicks inside the panel were also closing it.
    if (!e.target.closest('.index-panel') && !e.target.closest('#index-btn') && !e.target.closest('.artifact-index-tab')) {
      closeAll();
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });

  // ── Build the tabular INDEX from existing DOM data ────────────────────
  (function buildIndexTable() {
    const table = document.querySelector('#index-panel .index-table');
    const archiveData = (typeof window !== 'undefined' && window.ARCHIVE_CATEGORY_DATA) || null;
    if (!archiveData) {
      console.warn('[bronzewoman] ARCHIVE_CATEGORY_DATA not loaded — index categories will be empty');
    }

    // Recover the "library/<magazine>/|<filename>" key (the format used by
    // archive_categories.js) from an img element's src attribute. The image
    // path was set by loadAllArchiveImages() to "<encoded folder>/<encoded file>"
    // and the browser resolves it to a full URL on read — decode and take the
    // last two segments to rebuild the key.
    function archiveKeyFromImg(img) {
      if (!img) return '';
      const raw = img.getAttribute('src') || img.src || '';
      if (!raw) return '';
      const path = raw.split(/[?#]/)[0];
      const parts = path.split('/').filter(Boolean);
      if (parts.length < 2) return '';
      const file = decodeURIComponent(parts[parts.length - 1]);
      const folder = decodeURIComponent(parts[parts.length - 2]);
      return `library/${folder}/|${file}`;
    }

    function categoryForImg(img) {
      if (!archiveData) return '';
      const entry = archiveData[archiveKeyFromImg(img)];
      return (entry && entry.primary) || '';
    }

    // Folder slug on disk → human-readable magazine name shown in the index.
    // The three Al-ethnayn folders are intentionally collapsed to a single
    // label — they're the same magazine split into multiple scan batches.
    const MAGAZINE_LABELS = {
      'Al-Kawakib': 'Al-Kawakib',
      'Al-Mawed': 'Al-Mawed',
      'Al-Rissalah': 'Al-Rissalah',
      'Al-Thqafa': 'Al-Thqafa',
      'Al-alam': 'Al-Alam',
      'Al-ethnayn wa Aldonya': 'Al-Ethnayn wa Aldonya',
      'Al-ethnayn wa aldonya 2': 'Al-Ethnayn wa Aldonya',
      'Al-ethnayn wa aldonya 3': 'Al-Ethnayn wa Aldonya',
    };
    // Publication metadata per magazine, transcribed from
    // `ExportBlock.../books documentation ..._all.csv`. The three Al-ethnayn
    // folder slugs all point to the same magazine record.
    window.MAGAZINE_META = {
      'Al-Kawakib': {
        name: 'Al-Kawakib', arabic: 'الكواكب', translation: 'The Planets',
        date: '1961', editor: 'Majd Fahmi', publisher: 'Dar-Alhilal',
        volume: '460', country: 'Egypt',
      },
      'Al-Mawed': {
        name: 'Al-Mawed', arabic: 'الموعد', translation: 'The Rendezvous',
        date: '1955–1960', editor: 'Mohamed Badih Serbey', publisher: 'Al-Mawed Magazine',
        volume: '15–99', country: 'Lebanon',
      },
      'Al-Rissalah': {
        name: 'Al-Rissalah', arabic: 'الرسالة', translation: 'The Message',
        date: '1942', editor: 'Ahmed Hassan Al-Zayyat', publisher: 'Al-Risalah Press',
        volume: '450–465', country: 'Egypt',
      },
      'Al-Thqafa': {
        name: 'Al-Thqafa', arabic: 'الثقافة', translation: 'Culture',
        date: '1939', editor: 'Ahmad Ameen',
        publisher: 'Committee of Composition, Translation and Publication',
        volume: '5–7', country: 'Egypt',
      },
      'Al-alam': {
        name: 'Al-Alam', arabic: 'العالم', translation: 'The World',
        date: '1957', editor: 'Ali Kamal', publisher: 'Al-Hilal',
        volume: '139', country: 'Egypt',
      },
      'Al-ethnayn wa Aldonya': {
        name: 'Al-Ethnayn wa Aldonya', arabic: 'الاثنين والدنيا', translation: 'Monday and the World',
        date: '1956', editor: 'Emil Zeidan', publisher: 'Dar-Alhilal',
        volume: '255–821', country: 'Egypt',
      },
      'Al-ethnayn wa aldonya 2': {
        name: 'Al-Ethnayn wa Aldonya', arabic: 'الاثنين والدنيا', translation: 'Monday and the World',
        date: '1956', editor: 'Emil Zeidan', publisher: 'Dar-Alhilal',
        volume: '255–821', country: 'Egypt',
      },
      'Al-ethnayn wa aldonya 3': {
        name: 'Al-Ethnayn wa Aldonya', arabic: 'الاثنين والدنيا', translation: 'Monday and the World',
        date: '1956', editor: 'Emil Zeidan', publisher: 'Dar-Alhilal',
        volume: '255–821', country: 'Egypt',
      },
    };
    const MAGAZINE_META = window.MAGAZINE_META;
    function folderSlugForImg(img) {
      if (!img) return '';
      const raw = img.getAttribute('src') || img.src || '';
      if (!raw) return '';
      const path = raw.split(/[?#]/)[0];
      const parts = path.split('/').filter(Boolean);
      if (parts.length < 2) return '';
      return decodeURIComponent(parts[parts.length - 2]);
    }
    function magazineForImg(img) {
      const folder = folderSlugForImg(img);
      return MAGAZINE_LABELS[folder] || folder;
    }
    function refNumFromLabel(label) {
      const text = (label || '').trim();
      if (!text || text === '—') return Number.MAX_SAFE_INTEGER;
      if (/^\d+$/.test(text)) return parseInt(text, 10);
      const lead = text.match(/^(\d+)/);
      if (lead) return parseInt(lead[1], 10);
      const digits = text.match(/\d+/);
      return digits ? parseInt(digits[0], 10) : Number.MAX_SAFE_INTEGER;
    }

    // Walk every unique archive figure in the page (main content + extras).
    const seenSrc = new Set();
    const rows = [];
    document.querySelectorAll('#main .sc-gLDymS').forEach((fig) => {
      const img = fig.querySelector('img');
      if (!img) return;
      const imgSrc = img.getAttribute('src') || img.src || '';
      if (!imgSrc || seenSrc.has(imgSrc)) return;
      seenSrc.add(imgSrc);

      const frag = fig.closest('.sc-blLrKi, .image-extras');
      let section = '';
      let page = '';
      if (frag) {
        const h3 = frag.querySelector('.sc-irTrJD');
        if (h3) {
          const text = h3.textContent.trim();
          const m = text.match(/^(.+?),\s*P\.\s*(.+)$/);
          if (m) {
            section = m[1].trim();
            page = 'P. ' + m[2].trim().padStart(3, '0');
          } else {
            section = text;
          }
        }
      }

      const cap = fig.querySelector('figcaption p')?.textContent.trim() || '';
      const refMatch = cap.match(/\[(.+?)\]/);
      const refLabel = refMatch ? refMatch[1] : '—';
      rows.push({
        ref: refLabel,
        refNum: refNumFromLabel(refLabel),
        section,
        page,
        imgSrc,
        category: categoryForImg(img),
        magazine: magazineForImg(img),
        folder: folderSlugForImg(img),
        anchorId: frag && frag.id ? frag.id : '',
      });
    });

    rows.sort((a, b) => {
      const aStory = a.refNum >= 1 && a.refNum <= 19;
      const bStory = b.refNum >= 1 && b.refNum <= 19;
      if (aStory && bStory && a.refNum !== b.refNum) return a.refNum - b.refNum;
      if (aStory !== bStory) return aStory ? -1 : 1;
      return a.imgSrc.localeCompare(b.imgSrc);
    });

    // Renumber every unique archive image 1…N so the index has no gaps.
    rows.forEach((r, i) => {
      r.refNum = i + 1;
      r.ref = String(i + 1).padStart(3, '0');
    });

    // Render
    const html = rows.map((r) => {
      const category = (r.category || '—').toUpperCase();
      return `<div class="index-row" data-anchor="${r.anchorId}" data-img="${r.imgSrc}" data-folder="${r.folder || ''}" data-ref-num="${r.refNum}">
        <div class="col-ref">[${r.ref}]</div>
        <div class="col-medium">${category}</div>
        <div class="col-section">${r.magazine || ''}</div>
      </div>`;
    }).join('');
    table.insertAdjacentHTML('beforeend', html);

    // ── Click-to-sort on the REFERENCE, CATEGORY and MAGAZINE column
    //    headers. Each column cycles: its own sort ↔ random. The active
    //    column shows the `↑` arrow; clicking any other column moves the
    //    arrow there. Initial state is REFERENCE (rows are inserted in
    //    document order, which IS reference order).
    const headEl = table.querySelector('.index-head');
    const refHead = headEl ? headEl.querySelector('.col-ref') : null;
    const catHead = headEl ? headEl.querySelector('.col-medium') : null;
    const magHead = headEl ? headEl.querySelector('.col-section') : null;
    const arrows = {
      reference: refHead ? refHead.querySelector('.sort-arrow') : null,
      category:  catHead ? catHead.querySelector('.sort-arrow') : null,
      magazine:  magHead ? magHead.querySelector('.sort-arrow') : null,
    };
    let currentSort = 'reference';

    function rowEls() {
      return Array.from(table.querySelectorAll('.index-row:not(.index-head)'));
    }
    function reattach(orderedRows) {
      orderedRows.forEach((row) => table.appendChild(row));
    }
    function sortByText(cellClass) {
      const rows = rowEls();
      rows.sort((a, b) => {
        const av = (a.querySelector('.' + cellClass)?.textContent || '').trim().toLowerCase();
        const bv = (b.querySelector('.' + cellClass)?.textContent || '').trim().toLowerCase();
        return av.localeCompare(bv);
      });
      reattach(rows);
    }
    function sortByReference() {
      const rows = rowEls();
      rows.sort((a, b) => {
        const an = parseInt(a.getAttribute('data-ref-num') || '', 10);
        const bn = parseInt(b.getAttribute('data-ref-num') || '', 10);
        if (isFinite(an) && isFinite(bn) && an !== bn) return an - bn;
        const av = (a.querySelector('.col-ref')?.textContent || '').trim();
        const bv = (b.querySelector('.col-ref')?.textContent || '').trim();
        return av.localeCompare(bv);
      });
      reattach(rows);
    }
    function shuffleAll() {
      const rows = rowEls();
      for (let i = rows.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const tmp = rows[i]; rows[i] = rows[j]; rows[j] = tmp;
      }
      reattach(rows);
    }
    function updateArrow(activeKey) {
      Object.keys(arrows).forEach((k) => {
        const arrow = arrows[k];
        if (!arrow) return;
        arrow.classList.toggle('active', k === activeKey);
      });
    }
    // Replay the same fade-and-slide-up entrance the rows use when the panel
    // first opens, but re-triggered after a sort/shuffle so the newly ordered
    // list cascades in. The entrance animation lives on the `.index-panel.open
    // .index-row` stylesheet rule; moving rows in the DOM doesn't restart a CSS
    // animation, so we force a restart: set `animation:none`, flush one reflow,
    // then clear it (reviving the stylesheet rule) with a fresh stagger delay.
    // No 320ms drawer lead-in here — the panel is already open — and only the
    // first rows stagger (the rest share delay 0), matching staggerIndexRows.
    function replayIndexRowsIn() {
      if (!indexPanel.classList.contains('open')) return;
      const rows = table.querySelectorAll('.index-row:not(.index-head)');
      const STEP_MS = 70, STAGGER_CAP = 20;
      for (let i = 0; i < rows.length; i++) rows[i].style.animation = 'none';
      void table.offsetWidth; // commit the reset so re-adding the rule restarts it
      for (let i = 0; i < rows.length; i++) {
        rows[i].style.animation = '';   // revert to the .open stylesheet rule
        rows[i].style.animationDelay = (i < STAGGER_CAP ? i * STEP_MS : 0) + 'ms';
      }
    }
    function wireSort(headerCell, columnKey, sortFn) {
      if (!headerCell) return;
      headerCell.style.cursor = 'pointer';
      headerCell.style.userSelect = 'none';
      headerCell.addEventListener('click', () => {
        if (currentSort === columnKey) {
          shuffleAll();
          currentSort = 'random';
        } else {
          sortFn();
          currentSort = columnKey;
        }
        updateArrow(currentSort);
        replayIndexRowsIn();
      });
    }
    wireSort(refHead, 'reference', sortByReference);
    wireSort(catHead, 'category',  () => sortByText('col-medium'));
    wireSort(magHead, 'magazine',  () => sortByText('col-section'));
    updateArrow(currentSort);

    // Hover preview + magazine metadata
    const preview = document.getElementById('index-preview');
    const metaPanel = document.getElementById('index-meta');
    const metaFields = {
      name:      document.getElementById('meta-name'),
      publisher: document.getElementById('meta-publisher'),
      editor:    document.getElementById('meta-editor'),
      country:   document.getElementById('meta-country'),
      date:      document.getElementById('meta-date'),
      volume:    document.getElementById('meta-volume'),
    };
    function showMeta(folderSlug) {
      const meta = MAGAZINE_META[folderSlug];
      if (!meta || !metaPanel) {
        if (metaPanel) metaPanel.classList.remove('visible');
        return;
      }
      metaFields.name.textContent      = meta.name || '';
      metaFields.publisher.textContent = meta.publisher || '';
      metaFields.editor.textContent    = meta.editor || '';
      metaFields.country.textContent   = meta.country || '';
      metaFields.date.textContent      = meta.date || '';
      metaFields.volume.textContent    = meta.volume || '';
      metaPanel.classList.add('visible');
    }
    function hideMeta() {
      if (metaPanel) metaPanel.classList.remove('visible');
    }
    table.addEventListener('mouseover', (e) => {
      const row = e.target.closest('.index-row:not(.index-head)');
      if (!row) return;
      const src = row.dataset.img;
      if (src) {
        preview.src = src;
        preview.hidden = false;
      }
      showMeta(row.dataset.folder);
    });
    table.addEventListener('mouseleave', () => {
      preview.hidden = true;
      hideMeta();
    });

    // Click a row → open the full document detail view (Info, Keywords,
    // Magazine metadata, full-size scan, related documents).
    table.addEventListener('click', (e) => {
      const row = e.target.closest('.index-row:not(.index-head)');
      if (!row) return;
      closeAll();
      if (window.openArchiveDoc) window.openArchiveDoc(row);
    });
  })();

  // ── Archive document detail overlay ──────────────────────────────────────
  // Populates the ISI-style detail view (Info, Keywords, Magazine metadata,
  // full-size scan, related documents) from an .index-row element, using the
  // same data already on the row (ref / category / magazine / img / folder)
  // plus KAWAKIB_DESCRIPTIONS and MAGAZINE_META looked up by filename/folder.
  (function setupArchiveDocOverlay() {
    const overlay   = document.getElementById('adxOverlay');
    const closeBtn  = document.getElementById('adxClose');
    const titleEl    = document.getElementById('adxTitle');
    const publisherEl = document.getElementById('adxPublisher');
    const yearEl     = document.getElementById('adxYear');
    const countryEl  = document.getElementById('adxCountry');
    const magazineEl = document.getElementById('adxMagazine');
    const tagsEl     = document.getElementById('adxTags');
    const imageLink  = document.getElementById('adxImageLink');
    const imageEl    = document.getElementById('adxImage');
    const prevBtn    = document.getElementById('adxPrevBtn');
    const nextBtn    = document.getElementById('adxNextBtn');
    if (!overlay) return;

    let currentAdxRow = null;

    const lightbox = document.getElementById('adxLightbox');
    const lightboxImg = document.getElementById('adxLightboxImg');

    /* Mouse parallax on the preview image — same feel as canvas / read pages. */
    const PARALLAX_MAX_X = 110;
    const PARALLAX_MAX_Y = 70;
    const PARALLAX_EASE = 0.062;
    const PARALLAX_DEPTH = 0.7;
    let parallaxNX = 0.5;
    let parallaxNY = 0.5;
    let parallaxCX = 0;
    let parallaxCY = 0;
    let parallaxTickActive = false;

    function parallaxLerp(a, b, t) { return a + (b - a) * t; }

    function resetAdxParallax() {
      parallaxCX = 0;
      parallaxCY = 0;
      if (imageLink) imageLink.style.removeProperty('transform');
    }

    function adxParallaxTick() {
      parallaxTickActive = false;
      if (!overlay.classList.contains('is-open') || !imageLink) return;
      const dx = parallaxNX - 0.5;
      const dy = parallaxNY - 0.5;
      const tx = -dx * PARALLAX_MAX_X * PARALLAX_DEPTH;
      const ty = -dy * PARALLAX_MAX_Y * PARALLAX_DEPTH;
      parallaxCX = parallaxLerp(parallaxCX, tx, PARALLAX_EASE);
      parallaxCY = parallaxLerp(parallaxCY, ty, PARALLAX_EASE);
      imageLink.style.transform =
        'translate3d(' + parallaxCX.toFixed(2) + 'px,' + parallaxCY.toFixed(2) + 'px,0)';
      if (Math.abs(parallaxCX - tx) > 0.05 || Math.abs(parallaxCY - ty) > 0.05) {
        parallaxTickActive = true;
        requestAnimationFrame(adxParallaxTick);
      }
    }

    function kickAdxParallax() {
      if (!parallaxTickActive) {
        parallaxTickActive = true;
        requestAnimationFrame(adxParallaxTick);
      }
    }

    window.addEventListener('mousemove', function (e) {
      if (!overlay.classList.contains('is-open')) return;
      parallaxNX = e.clientX / window.innerWidth;
      parallaxNY = e.clientY / window.innerHeight;
      kickAdxParallax();
    }, { passive: true });

    function filenameFromSrc(src) {
      if (!src) return '';
      const path = src.split(/[?#]/)[0];
      return decodeURIComponent(path.split('/').filter(Boolean).pop() || '');
    }

    function rowData(row) {
      const ref = (row.querySelector('.col-ref')?.textContent || '').replace(/[[\]]/g, '').trim();
      const category = (row.querySelector('.col-medium')?.textContent || '').trim();
      const magazine = (row.querySelector('.col-section')?.textContent || '').trim();
      const imgSrc = row.dataset.img || '';
      const folder = row.dataset.folder || '';
      return { ref, category, magazine, imgSrc, folder, file: filenameFromSrc(imgSrc) };
    }

    // Cached, pre-sorted base list of nav rows (all 1272). Built once because
    // the index-panel table is built once at load and doesn't change during
    // interaction. Preview-page filtering still runs per-call, but the sort
    // and the initial 1272-element querySelectorAll are amortized to zero.
    let _navRowsCache = null;
    function getNavigationRows() {
      if (!_navRowsCache) {
        const table = document.querySelector('#index-panel .index-table');
        if (!table) return [];
        _navRowsCache = Array.from(table.querySelectorAll('.index-row:not(.index-head)'))
          .sort((a, b) => {
            const an = parseInt(a.getAttribute('data-ref-num') || '0', 10);
            const bn = parseInt(b.getAttribute('data-ref-num') || '0', 10);
            return an - bn;
          });
      }
      const previewPage = document.getElementById('preview-page');
      if (previewPage && previewPage.classList.contains('is-open')) {
        const pvWrap = document.getElementById('pv-table-wrap');
        if (pvWrap) {
          const visibleImgs = new Set(
            Array.from(pvWrap.querySelectorAll('.pv-row:not(.pv-row-head)'))
              .filter((r) => r.style.display !== 'none')
              .map((r) => r.getAttribute('data-img'))
          );
          return _navRowsCache.filter((r) => visibleImgs.has(r.getAttribute('data-img')));
        }
      }
      return _navRowsCache;
    }

    function updateAdxNavButtons() {
      if (!prevBtn || !nextBtn) return;
      const rows = getNavigationRows();
      const idx = currentAdxRow
        ? rows.findIndex((r) => r.dataset.img === currentAdxRow.dataset.img)
        : -1;
      prevBtn.disabled = idx <= 0;
      nextBtn.disabled = idx < 0 || idx >= rows.length - 1;
    }

    function navigateAdx(delta) {
      const rows = getNavigationRows();
      const idx = currentAdxRow
        ? rows.findIndex((r) => r.dataset.img === currentAdxRow.dataset.img)
        : -1;
      if (idx < 0) return;
      const target = rows[idx + delta];
      if (target) openArchiveDoc(target, { animate: false });
    }

    function syncAdxIndexNavLabel(isOpen) {
      const indexNav = document.querySelector('#canvas-nav .cn-item[data-cn-sub="index"]');
      if (!indexNav) return;
      if (!indexNav.dataset.defaultLabel) {
        indexNav.dataset.defaultLabel = indexNav.textContent.trim() || 'Index';
      }
      indexNav.textContent = isOpen ? '[index]' : indexNav.dataset.defaultLabel;
    }

    function renderArchiveDoc(row) {
      currentAdxRow = row;
      const d = rowData(row);
      // Two independent annotation sources, both keyed differently:
      //  - KAWAKIB_DESCRIPTIONS: narrative en/ar captions, filename-keyed, Al-Kawakib only (23 docs)
      //  - TRANSLATIONS: a short English `headline` + the `arabic` original, "folder/file"-keyed,
      //    covers Al-Kawakib AND Al-Mawed (211 docs) — purpose-built as a headline field
      const caption = (window.KAWAKIB_DESCRIPTIONS || {})[d.file] || null;
      const translation = (window.TRANSLATIONS || {})[d.folder + '/' + d.file] || null;
      const meta = (window.MAGAZINE_META || {})[d.folder] || null;

      const headline = (translation && translation.headline) || null;

      titleEl.textContent = headline || (caption && caption.en) || (d.ref ? '[' + d.ref + ']' : 'Untitled document');
      publisherEl.textContent = (meta && meta.publisher) ? meta.publisher : '—';
      yearEl.textContent = (meta && meta.date) ? meta.date : '—';
      countryEl.textContent = (meta && meta.country) ? meta.country : '—';
      magazineEl.textContent = d.magazine || d.folder || '—';
      tagsEl.innerHTML = d.category
        ? '<span class="adx-meta-pill">' + d.category + '</span>'
        : '—';

      const fullImgSrc = window.FULL_SRC ? window.FULL_SRC(d.imgSrc) : d.imgSrc;
      imageLink.setAttribute('href', fullImgSrc);
      imageEl.src = fullImgSrc;
      imageEl.alt = d.file;
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      const metaPanel = overlay.querySelector('.adx-split-meta');
      if (metaPanel) metaPanel.scrollTop = 0;
      resetAdxParallax();
      kickAdxParallax();
      updateAdxNavButtons();
      syncAdxIndexNavLabel(true);
    }

    function openArchiveDoc(row, opts) {
      opts = opts || {};
      const alreadyOpen = overlay.classList.contains('is-open');
      if (alreadyOpen || opts.animate === false || opts.instant) {
        renderArchiveDoc(row);
        return;
      }
      const run = typeof window.withPageTransition === 'function'
        ? window.withPageTransition
        : function (cb) { if (cb) cb(); return Promise.resolve(); };
      run(function () { renderArchiveDoc(row); });
    }
    window.openArchiveDoc = openArchiveDoc;

    if (prevBtn) prevBtn.addEventListener('click', function () { navigateAdx(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { navigateAdx(1); });

    // Locate the .index-row (built once from the full 1272-image archive)
    // matching a given <img loading="lazy" decoding="async"> src, so any other grid (Organise/Scatter, etc.)
    // can open the same rich detail view without rebuilding row data.
    // O(1) lookup: build a Map<folder|file, row> once. Before this cache,
    // every click did a linear scan through ~1272 rows with a regex per row.
    let _indexRowMap = null;
    window.findIndexRowByImg = function (src) {
      if (!_indexRowMap) {
        _indexRowMap = new Map();
        const table = document.querySelector('#index-panel .index-table');
        if (table) {
          table.querySelectorAll('.index-row:not(.index-head)').forEach((r) => {
            _indexRowMap.set(r.dataset.folder + '|' + filenameFromSrc(r.dataset.img), r);
          });
        }
      }
      const file = filenameFromSrc(src);
      const path = (src || '').split(/[?#]/)[0];
      const parts = path.split('/').filter(Boolean);
      const folder = parts.length >= 2 ? decodeURIComponent(parts[parts.length - 2]) : '';
      return _indexRowMap.get(folder + '|' + file) || null;
    };

    function closeArchiveDoc(opts) {
      opts = opts || {};
      if (!overlay.classList.contains('is-open')) return;
      const doClose = function () {
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        currentAdxRow = null;
        resetAdxParallax();
        syncAdxIndexNavLabel(false);
      };
      if (opts.instant || opts.animate === false) {
        doClose();
        return;
      }
      const run = typeof window.withPageTransition === 'function'
        ? window.withPageTransition
        : function (cb) { if (cb) cb(); return Promise.resolve(); };
      run(doClose);
    }
    window.closeArchiveDoc = closeArchiveDoc;

    closeBtn.addEventListener('click', function () { closeArchiveDoc(); });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeArchiveDoc();
    });

    document.querySelectorAll('[data-adx-lightbox]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        lightboxImg.src = link.getAttribute('href');
        lightbox.classList.add('is-open');
      });
    });
    function closeLightbox() { lightbox.classList.remove('is-open'); lightboxImg.src = ''; }
    lightbox.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') {
        if (overlay.classList.contains('is-open') && !lightbox.classList.contains('is-open')) {
          if (e.key === 'ArrowLeft') { e.preventDefault(); navigateAdx(-1); return; }
          if (e.key === 'ArrowRight') { e.preventDefault(); navigateAdx(1); return; }
        }
        return;
      }
      if (lightbox.classList.contains('is-open')) { closeLightbox(); return; }
      if (overlay.classList.contains('is-open')) closeArchiveDoc();
    });
  })();

  // ── Mode switching (TEXT / IMAGE / TEXT+IMAGE) ───────────────────────────
  const body = document.body;
  const modeTabs = document.querySelectorAll('.mode-tabs button');

  // Deterministic pseudo-random in [0,1) from a seed
  function rand(seed) {
    const x = Math.sin(seed * 12.9898) * 43758.5453;
    return x - Math.floor(x);
  }

  function applyImageScatter(seedOffset) {
    seedOffset = seedOffset || 0;
    _scatterCache = [];
    // Scatter always uses the default map; undo any grid-mode canvas growth.
    if (window._setCanvasBounds) window._setCanvasBounds(9000, 6000);
    // ALL figures (regular + scatter sections + extras) spread across the 9000×6000 map.
    // Placement: rejection sampling against each figure's MEASURED bounding box,
    // so tall magazine pages don't tile into vertical strips. No grid, no overlap.
    const figs = Array.from(document.querySelectorAll('#main .sc-gLDymS'));
    const N = figs.length;
    if (!N) return;
    const X_MIN = 60,   X_MAX = 8750;   // leaves gutters
    const Y_MIN = 60,   Y_MAX = 5750;
    const PADDING = 26;                 // min clear gap between any two figures
    const MAX_TRIES = 220;

    // Measure each figure's actual rendered footprint. offsetWidth/Height are
    // independent of the absolute left/top, so this is safe to do up front.
    const dims = figs.map((f) => ({
      w: f.offsetWidth  || 180,
      h: f.offsetHeight || 240,
    }));

    const placed = [];   // [{x, y, w, h}]

    // While the welcome title is visible, keep figures out of the viewport
    // centre. Once the intro is dismissed, re-scatter fills the whole map.
    const introActive = document.body.classList.contains('intro-active');
    const EX_PAD = 180;
    const EX = introActive ? {
      x: 4500 - (innerWidth  / 2) - EX_PAD,
      y: 3000 - (innerHeight / 2) - EX_PAD,
      w: innerWidth  + EX_PAD * 2,
      h: innerHeight + EX_PAD * 2,
    } : null;

    function collides(x, y, w, h) {
      // Reject if figure overlaps the intro-text exclusion zone.
      if (EX && x < EX.x + EX.w && x + w > EX.x &&
          y < EX.y + EX.h && y + h > EX.y) return true;
      for (let k = 0; k < placed.length; k++) {
        const p = placed[k];
        if (x < p.x + p.w + PADDING &&
            x + w + PADDING > p.x &&
            y < p.y + p.h + PADDING &&
            y + h + PADDING > p.y) return true;
      }
      return false;
    }

    figs.forEach((fig, idx) => {
      const { w, h } = dims[idx];
      const i = idx + seedOffset;
      const xRange = Math.max(1, X_MAX - X_MIN - w);
      const yRange = Math.max(1, Y_MAX - Y_MIN - h);

      let x = X_MIN, y = Y_MIN, found = false;
      // 1) Random tries.
      for (let t = 0; t < MAX_TRIES; t++) {
        const sx = rand(i + 1 + t * 3.17);
        const sy = rand(i + 100.7 + t * 5.91);
        const cx = X_MIN + sx * xRange;
        const cy = Y_MIN + sy * yRange;
        if (!collides(cx, cy, w, h)) { x = cx; y = cy; found = true; break; }
      }
      // 2) Coarse scan fallback: guarantees a spot if one exists.
      if (!found) {
        const STEP = 70;
        outer: for (let yy = Y_MIN; yy <= Y_MAX - h; yy += STEP) {
          for (let xx = X_MIN; xx <= X_MAX - w; xx += STEP) {
            if (!collides(xx, yy, w, h)) { x = xx; y = yy; found = true; break outer; }
          }
        }
      }
      // 3) Last resort: drop it at a random spot even if overlapping (shouldn't happen).
      if (!found) {
        x = X_MIN + rand(i + 1) * xRange;
        y = Y_MIN + rand(i + 100.7) * yRange;
      }

      placed.push({ x, y, w, h });
      const z = String(Math.floor(rand(i + 17.1) * 200));
      fig.style.left = x + 'px';
      fig.style.top = y + 'px';
      fig.style.zIndex = z;
      _scatterCache.push({ el: fig, left: x + 'px', top: y + 'px', zIndex: z });
    });
  }

  // Cache last scatter so returning to gallery skips the expensive re-scatter.
  var _scatterCache = [];

  function restoreScatterFromCache() {
    if (!_scatterCache.length) return false;
    // Cached positions are on the default map; undo any grid-mode growth.
    if (window._setCanvasBounds) window._setCanvasBounds(9000, 6000);
    _scatterCache.forEach(function (s) {
      s.el.style.left = s.left;
      s.el.style.top = s.top;
      s.el.style.zIndex = s.zIndex;
    });
    return true;
  }

  function clearImageScatter() {
    document.querySelectorAll('#main .sc-gLDymS').forEach((fig) => {
      fig.style.left = '';
      fig.style.top = '';
      fig.style.zIndex = '';
    });
  }

  // ── Compact re-pack for filtered views ─────────────────────────────────
  // A filter only hides the non-matching documents; the survivors keep their
  // original scatter coordinates, which are spread across the whole 9000×6000
  // map. For a small result set (e.g. Al-Kawakib = 24) that looks nearly empty
  // and you can land on a region with nothing in it. This gathers the visible
  // figures into one compact cluster at the map centre, frames the canvas on
  // it, and replays the pop-in cascade. Clearing the filter restores every
  // figure's original position from the scatter cache.
  //
  // Only small/medium results are re-packed — large sets are already dense
  // enough in their natural spread, and pulling hundreds of figures into the
  // centre would be worse, not better.
  const REPACK_MAX = 160;
  let _filterRepacked = false;

  function _restoreAfterFilter() {
    if (!_filterRepacked) return;
    restoreScatterFromCache();
    _filterRepacked = false;
    resetPopInState();
    if (window.centerCanvas) window.centerCanvas();
    requestAnimationFrame(() => requestAnimationFrame(triggerPopIn));
  }

  function repackVisibleFigures() {
    // Only meaningful in the free scatter canvas (not grid / ordered / intro).
    if (!document.body.classList.contains('mode-image')) return;
    if (document.body.classList.contains('ordered') ||
        document.body.classList.contains('canvas-gridorder') ||
        document.body.classList.contains('intro-active')) return;

    const all = Array.from(document.querySelectorAll('#main .sc-gLDymS:not(.is-uncategorized)'));
    const visible = all.filter((f) => !f.classList.contains('filter-hidden'));
    const N = visible.length;

    // No active filter (everything shows), or a large set → use the natural
    // spread; just undo any previous re-pack.
    if (!N || N === all.length || N > REPACK_MAX) { _restoreAfterFilter(); return; }

    // Measure the visible footprints.
    const dims = visible.map((f) => ({ w: f.offsetWidth || 180, h: f.offsetHeight || 240 }));
    let avgW = 0, avgH = 0;
    for (let i = 0; i < N; i++) { avgW += dims[i].w; avgH += dims[i].h; }
    avgW /= N; avgH /= N;

    // Viewport, with fallbacks — window.innerWidth/Height can momentarily read
    // 0 (e.g. a backgrounded/pre-paint tab); a sane default keeps the region
    // shape and fit-zoom correct instead of collapsing to a sliver.
    const vw = window.innerWidth || document.documentElement.clientWidth || 1280;
    const vh = window.innerHeight || document.documentElement.clientHeight || 800;

    // Size a region that keeps the airy density of the full scatter and roughly
    // matches the viewport aspect, so the cluster fills the frame.
    const PADDING = 30;
    const DENSITY = 2.0;                    // × raw footprint area → breathing room
    const totalArea = (avgW + PADDING) * (avgH + PADDING) * DENSITY * N;
    const aspect = Math.max(0.9, vw / vh);
    let regionW = Math.max(avgW * 2 + PADDING, Math.sqrt(totalArea * aspect));
    let regionH = Math.max(avgH * 2 + PADDING, totalArea / regionW);

    const MC_X = 4500, MC_Y = 3000;         // map centre (bounds stay 9000×6000)
    if (window._setCanvasBounds) window._setCanvasBounds(9000, 6000);
    const X_MIN = MC_X - regionW / 2, X_MAX = MC_X + regionW / 2;
    const Y_MIN = MC_Y - regionH / 2, Y_MAX = MC_Y + regionH / 2;

    const placed = [];
    function collides(x, y, w, h) {
      for (let k = 0; k < placed.length; k++) {
        const p = placed[k];
        if (x < p.x + p.w + PADDING && x + w + PADDING > p.x &&
            y < p.y + p.h + PADDING && y + h + PADDING > p.y) return true;
      }
      return false;
    }

    const MAX_TRIES = 240;
    const results = [];
    let bMinX = Infinity, bMinY = Infinity, bMaxX = -Infinity, bMaxY = -Infinity;
    visible.forEach((fig, idx) => {
      const w = dims[idx].w, h = dims[idx].h;
      const xRange = Math.max(1, (X_MAX - X_MIN) - w);
      const yRange = Math.max(1, (Y_MAX - Y_MIN) - h);
      let x = X_MIN, y = Y_MIN, found = false;
      for (let t = 0; t < MAX_TRIES; t++) {
        const cx = X_MIN + Math.random() * xRange;
        const cy = Y_MIN + Math.random() * yRange;
        if (!collides(cx, cy, w, h)) { x = cx; y = cy; found = true; break; }
      }
      if (!found) {
        const STEP = 60;
        outer: for (let yy = Y_MIN; yy <= Y_MAX - h; yy += STEP) {
          for (let xx = X_MIN; xx <= X_MAX - w; xx += STEP) {
            if (!collides(xx, yy, w, h)) { x = xx; y = yy; found = true; break outer; }
          }
        }
      }
      placed.push({ x, y, w, h });
      results.push({ fig, x, y });
      if (x < bMinX) bMinX = x;
      if (y < bMinY) bMinY = y;
      if (x + w > bMaxX) bMaxX = x + w;
      if (y + h > bMaxY) bMaxY = y + h;
    });

    // Shift the whole cluster so its real bounding box is centred on the map
    // centre — then centerCanvas() frames it exactly.
    const shiftX = MC_X - (bMinX + bMaxX) / 2;
    const shiftY = MC_Y - (bMinY + bMaxY) / 2;
    results.forEach((r) => {
      r.fig.style.left = (r.x + shiftX) + 'px';
      r.fig.style.top  = (r.y + shiftY) + 'px';
    });
    _filterRepacked = true;

    // Fit the cluster's bounding box in the viewport, clamped to the zoom-out
    // floor and no closer than the default zoom.
    const MARGIN = 120;
    const clusterW = (bMaxX - bMinX) + MARGIN * 2;
    const clusterH = (bMaxY - bMinY) + MARGIN * 2;
    let fit = Math.min(vw / clusterW, vh / clusterH);
    fit = Math.max(0.78, Math.min(1.4, fit));

    resetPopInState();
    if (window.centerCanvas) window.centerCanvas(fit);
    requestAnimationFrame(() => requestAnimationFrame(triggerPopIn));
  }
  window.repackCanvasForFilter = repackVisibleFigures;

  // ── Continuous ordered grid layout on the canvas ────────────────────────
  // Places every figure into a single neat grid in document order ([001] →
  // [676], left-to-right, top-to-bottom), centred on the same 9000×6000 map
  // the scatter uses. Because it stays in the unordered-canvas mode (no
  // `.ordered` class), pan / drag / 0.82 opacity / pop-in all keep working —
  // only the coordinates change. Deliberately does NOT write _scatterCache,
  // so toggling back to Scatter restores the previous scattered positions.
  function applyImageGridOrder() {
    const figs = Array.from(document.querySelectorAll('#main .sc-gLDymS'));
    const N = figs.length;
    if (!N) return;
    // Mirror the airy ordered field from themanufacturedface: large cells with
    // generous whitespace + light organic jitter, as one continuous grid in
    // document order. No clusters/labels, no black bg, no connective visual.
    const CELL_W = 630, CELL_H = 490;   // same cell footprint as the reference
    const MARGIN = 400;
    const COLS = Math.max(4, Math.round(Math.sqrt(N * 1.6)));
    const rows = Math.ceil(N / COLS);
    const gridW = COLS * CELL_W;
    const gridH = rows * CELL_H;
    // Grow the pannable canvas so the whole grid fits, then centre it.
    const mapW = Math.max(9000, gridW + MARGIN * 2);
    const mapH = Math.max(6000, gridH + MARGIN * 2);
    if (window._setCanvasBounds) window._setCanvasBounds(mapW, mapH);
    const originX = (mapW - gridW) / 2 + CELL_W / 2;
    const originY = (mapH - gridH) / 2 + CELL_H / 2;
    // Per-row horizontal drift so rows don't line up rigidly (as in the ref).
    const rowShifts = [];
    for (let r = 0; r < rows; r++) rowShifts.push((rand(r * 3.7 + 1) - 0.5) * CELL_W);

    figs.forEach((fig, i) => {
      const col = i % COLS;
      const row = Math.floor(i / COLS);
      const jx = (rand(i + 3.1) - 0.5) * 110;
      const jy = (rand(i + 9.7) - 0.5) * 200;
      const x = originX + col * CELL_W + rowShifts[row] + jx;
      const y = originY + row * CELL_H + jy;
      fig.style.left = Math.round(x) + 'px';
      fig.style.top  = Math.round(y) + 'px';
      fig.style.zIndex = '1';
    });
  }

  // [TEXT] mode always uses the scattered canvas — snap out of any organised
  // layout (on-canvas grid or category columns) before showing text cards.
  function forceCanvasScatter() {
    const body = document.body;
    let changed = false;

    if (body.classList.contains('canvas-gridorder')) {
      body.classList.remove('canvas-gridorder');
      const gabGrid = document.getElementById('gab-grid-btn');
      if (gabGrid) gabGrid.textContent = 'Organise';
      document.querySelectorAll('#main .sc-gLDymS').forEach((f) => {
        f.style.transition = '';
        f.style.transform = '';
        f.style.transformOrigin = '';
      });
      if (!restoreScatterFromCache()) applyImageScatter();
      changed = true;
    }

    if (body.classList.contains('ordered')) {
      body.classList.remove('ordered');
      const orderBtn = document.getElementById('order-btn');
      if (orderBtn) {
        orderBtn.classList.remove('active');
        const btnLabel = orderBtn.querySelector('.taxonomy-bar__btn-label');
        if (btnLabel) btnLabel.textContent = 'Grid';
        else orderBtn.textContent = 'Grid';
      }
      if (window.resetOrderDocFocus) window.resetOrderDocFocus();
      restoreFiguresOriginalOrder();
      resetGridLayout();
      if (!restoreScatterFromCache()) applyImageScatter();
      changed = true;
    }

    if (changed) {
      if (window.centerCanvas) window.centerCanvas();
      resetPopInState();
      requestAnimationFrame(() => requestAnimationFrame(triggerPopIn));
    }
    return changed;
  }

  window.forceCanvasScatter = forceCanvasScatter;

  // ── Category buckets for ORDER mode ─────────────────────────────────────
  // When the user toggles ORDER on, every figure is re-parented into #main
  // grouped under its archive_classification Primary_Category, with a small
  // descriptive header before each group. Toggling ORDER off (or switching
  // out of IMAGE mode) restores every figure to its original parent.
  const ARCHIVE_DATA_REF =
    (typeof window !== 'undefined' && window.ARCHIVE_CATEGORY_DATA) || null;
  const CATEGORY_ORDER = [
    'People',
    'Desires',
    'Leisure',
    'Street',
  ];
  const CATEGORY_DESCRIPTIONS = {
    'People':
      'Close-up portraits, magazine cover faces, studio headshots, fashion close-ups — pages where a single individual holds the frame. Clean backgrounds, studio lighting, attention on face, hairstyle and dress.',
    'Desires':
      'Commercial advertisements, product showcases and high-society features — domestic appliances, cosmetics, soaps, cigarettes, luxury cars, glamorous indoor banquets. Pages where typography sells alongside the image.',
    'Leisure':
      'Escapism and public relaxation — beach scenes, swimming pools, cinema halls, theatre stages, concerts and musicians, cafés and nightlife. Non-work temporalities.',
    'Street':
      'The public sphere — political demonstrations, street signage, active workplaces and labour, open squares, modernist architecture, traffic and daily street photography.',
  };
  window.CATEGORY_DESCRIPTIONS = CATEGORY_DESCRIPTIONS;
  const CATEGORY_PAGE_CONTENT = {
    'People': {
      subcategory: 'Portraits, Cover Faces & Studio Headshots',
      paragraphs: [
        CATEGORY_DESCRIPTIONS['People'],
        'These pages isolate the face as a site of memory — how a generation learned to see itself through studio lighting, fashion spreads, and the close-up as a unit of recognition. The individual holds the frame when the archive wants you to remember a person before anything else.',
      ],
    },
    'Desires': {
      subcategory: 'Advertising, Products & High-Society Features',
      paragraphs: [
        CATEGORY_DESCRIPTIONS['Desires'],
        'Desire here is manufactured and printed — products, lifestyles, and social aspiration arranged for the eye. Typography and image work together to sell a future that readers were meant to want, remember, and return to.',
      ],
    },
    'Leisure': {
      subcategory: 'Beaches, Cinemas, Stages & Nightlife',
      paragraphs: [
        CATEGORY_DESCRIPTIONS['Leisure'],
        'Leisure marks time outside labour: beaches, cinemas, cafés, and stages where the body rests in public. These documents trace how magazines pictured pleasure, escape, and the hours that did not belong to work.',
      ],
    },
    'Street': {
      subcategory: 'Demonstrations, Labour, Signage & Public Life',
      paragraphs: [
        CATEGORY_DESCRIPTIONS['Street'],
        'The street is where politics, labour, and daily life meet the camera — demonstrations, signage, traffic, and architecture read as collective memory. These pages hold the city as something seen, crossed, and contested together.',
      ],
    },
  };

  function getCategoryForFig(fig) {
    if (!ARCHIVE_DATA_REF || !fig) return '';
    const img = fig.querySelector('img');
    if (!img) return '';
    const raw = img.getAttribute('src') || img.src || '';
    if (!raw) return '';
    const path = raw.split(/[?#]/)[0];
    const parts = path.split('/').filter(Boolean);
    if (parts.length < 2) return '';
    const folder = decodeURIComponent(parts[parts.length - 2]);
    const file = decodeURIComponent(parts[parts.length - 1]);
    const entry = ARCHIVE_DATA_REF[`library/${folder}/|${file}`];
    return (entry && entry.primary) || '';
  }

  let _originalFigPositions = null;

  function groupFiguresByCategory() {
    if (_originalFigPositions) return; // already grouped
    const main = document.getElementById('main');
    const figs = Array.from(main.querySelectorAll('.sc-gLDymS'));
    // Snapshot original DOM positions so we can restore exactly on exit.
    _originalFigPositions = figs.map((fig) => ({
      fig,
      parent: fig.parentNode,
      next: fig.nextSibling,
    }));
    // Bucket by primary category, in the canonical visual order:
    // People → Desires → Leisure → Street. Figures whose image is not in
    // the archive_classification data get tagged `.is-uncategorized` so the
    // CSS hides them entirely in ORDER view.
    const groups = new Map();
    CATEGORY_ORDER.forEach((c) => groups.set(c, []));
    figs.forEach((fig) => {
      const cat = getCategoryForFig(fig);
      if (!cat || !groups.has(cat)) {
        fig.classList.add('is-uncategorized');
        return;
      }
      groups.get(cat).push(fig);
    });
    const orderFragment = document.createDocumentFragment();
    CATEGORY_ORDER.forEach((cat) => {
      const figList = groups.get(cat);
      if (!figList || !figList.length) return;
      figList.forEach((fig) => orderFragment.appendChild(fig));
    });
    main.insertBefore(orderFragment, main.firstChild);
  }

  function restoreFiguresOriginalOrder() {
    if (!_originalFigPositions) return;
    document
      .querySelectorAll('#main .cat-section-header')
      .forEach((el) => el.remove());
    document
      .querySelectorAll('#main .sc-gLDymS.is-uncategorized')
      .forEach((el) => el.classList.remove('is-uncategorized'));
    // Re-attach in the original order. If the recorded next-sibling is no
    // longer in its old parent (e.g. it was also moved), fall back to append.
    _originalFigPositions.forEach(({ fig, parent, next }) => {
      if (next && next.parentNode === parent) {
        parent.insertBefore(fig, next);
      } else {
        parent.appendChild(fig);
      }
    });
    _originalFigPositions = null;
  }

  function setMode(mode) {
    body.classList.remove('mode-text', 'mode-image', 'mode-text-image');
    body.classList.add('mode-' + mode);
    // Any mode switch re-lays-out the figures (scatter on gallery return, or
    // clears them otherwise), so drop the on-canvas ordered-grid state and
    // reset the GRID button label so it doesn't get out of sync.
    if (body.classList.contains('canvas-gridorder')) {
      body.classList.remove('canvas-gridorder');
      const _gabGrid = document.getElementById('gab-grid-btn');
      if (_gabGrid) _gabGrid.textContent = 'Organise';
    }
    // Leaving image mode → drop ordered state too
    if (mode !== 'image') {
      body.classList.remove('ordered');
      restoreFiguresOriginalOrder();
    }
    modeTabs.forEach((b) =>
      b.classList.toggle('active', b.dataset.mode === mode)
    );
    const orderBtn = document.getElementById('order-btn');
    orderBtn.classList.toggle(
      'active',
      mode === 'image' && body.classList.contains('ordered')
    );
    if (mode === 'image' && !body.classList.contains('ordered')) {
      body.classList.add('is-gallery-ready');
      // Restore saved positions if available — avoids expensive re-scatter on
      // every gallery return and keeps the transition smooth.
      const _fromCache = restoreScatterFromCache();
      if (!_fromCache) {
        applyImageScatter();
      }
      requestAnimationFrame(() => {
        if (window.centerCanvas) window.centerCanvas();
        triggerPopIn();
      });
    } else {
      clearImageScatter();
      if (window.resetCanvas) window.resetCanvas();
    }
    closeAll();
  }

  // ── Pop-in queue: figures animate one at a time, nearest to viewport first
  let _popQueue = [];
  let _popTimer = null;
  let _popCheckTimer = null;
  const POP_INTERVAL = 22;  // ms between each figure

  function _processPopQueue() {
    if (_popQueue.length === 0) { _popTimer = null; return; }
    const fig = _popQueue.shift();
    // Skip figures already revealed by _afterPan (instant reveal during pan)
    if (fig && !fig.classList.contains('order-revealed') && !fig.classList.contains('popping-in')) {
      fig.classList.add('popping-in', 'order-revealed');
    }
    _popTimer = setTimeout(_processPopQueue, POP_INTERVAL);
  }

  function queueVisibleFigures() {
    if (!body.classList.contains('mode-image')) return;
    if (body.classList.contains('intro-active')) return;
    const W = window.innerWidth, H = window.innerHeight;
    document.querySelectorAll('#main .sc-gLDymS:not(.popping-in):not(.order-revealed):not(.is-uncategorized):not(.filter-hidden)').forEach((fig) => {
      if (_popQueue.indexOf(fig) !== -1) return;
      const r = fig.getBoundingClientRect();
      if (r.top < H && r.bottom > 0 && r.left < W && r.right > 0) {
        _popQueue.push(fig);
      }
    });
    if (_popQueue.length > 0 && !_popTimer) _processPopQueue();
  }

  function resetPopInState() {
    _popQueue = [];
    if (_popTimer) { clearTimeout(_popTimer); _popTimer = null; }
    document.querySelectorAll('#main .sc-gLDymS').forEach((fig) => {
      fig.classList.remove('popping-in', 'order-revealed');
    });
  }

  function triggerPopIn() {
    if (body.classList.contains('intro-active')) return;
    _popQueue = [];
    if (_popTimer) { clearTimeout(_popTimer); _popTimer = null; }
    // Reset all figures to hidden
    document.querySelectorAll('#main .sc-gLDymS').forEach((fig) => {
      fig.classList.remove('order-revealed', 'popping-in');
    });
    void document.body.offsetWidth;
    // Sort all eligible figures by distance from viewport centre — nearest first,
    // so the pop-in wave radiates outward from what the user is looking at.
    // Distances are computed ONCE per figure before sorting (from inline
    // left/top + pan transform where possible). The old comparator called
    // getBoundingClientRect per comparison — ~13k forced-layout reads — which
    // froze the page every time the canvas was (re-)entered.
    const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
    const view = window._canvasView ? window._canvasView() : null;
    const figs = Array.from(document.querySelectorAll(
      '#main .sc-gLDymS:not(.is-uncategorized):not(.filter-hidden)'
    ));
    const entries = figs.map((fig) => {
      let mx, my;
      const l = view ? parseFloat(fig.style.left) : NaN;
      if (view && !isNaN(l)) {
        const t = parseFloat(fig.style.top) || 0;
        mx = l * view.scale + view.x + 100 * view.scale;
        my = t * view.scale + view.y + 120 * view.scale;
      } else {
        const r = fig.getBoundingClientRect();
        mx = (r.left + r.right) / 2;
        my = (r.top + r.bottom) / 2;
      }
      return { fig, d: Math.hypot(mx - cx, my - cy) };
    });
    entries.sort((a, b) => a.d - b.d);
    _popQueue = entries.map((e) => e.fig);
    _processPopQueue();
  }

  let _galleryBootComplete = false;

  function bootGallery() {
    if (_galleryBootComplete) return;
    if (!body.classList.contains('mode-image') || body.classList.contains('ordered')) return;
    _galleryBootComplete = true;
    applyImageScatter();
    if (window.centerCanvas) window.centerCanvas();
    body.classList.add('is-gallery-ready');
    if (!body.classList.contains('intro-active')) triggerPopIn();
  }

  // Hook for the canvas pan code — called whenever the viewport moves.
  // Instantly reveals figures that enter the viewport during a pan (no animation),
  // and pulls them from the background pop-in queue so they aren't processed twice.
  window._afterPan = function () {
    if (!body.classList.contains('mode-image') || body.classList.contains('ordered')) return;
    if (body.classList.contains('intro-active')) return;
    if (_popCheckTimer) return;
    _popCheckTimer = setTimeout(() => {
      _popCheckTimer = null;
      const W = window.innerWidth, H = window.innerHeight;
      // Visibility is computed from each figure's inline left/top (set by the
      // scatter/grid layout) and the current pan transform — pure math, no
      // getBoundingClientRect. The old gBCR loop forced a synchronous layout
      // of ~1272 absolute figures every 80ms during a pan, which was the main
      // source of pan stutter. FIG_MAX over-estimates the figure footprint;
      // revealing a touch early is invisible, measuring exactly is not.
      const view = window._canvasView ? window._canvasView() : null;
      const FIG_MAX = 560;
      const candidates = document.querySelectorAll('#main .sc-gLDymS:not(.order-revealed):not(.popping-in):not(.is-uncategorized):not(.filter-hidden)');
      const toReveal = [];
      for (let i = 0; i < candidates.length; i++) {
        const fig = candidates[i];
        let visible;
        const l = view ? parseFloat(fig.style.left) : NaN;
        if (view && !isNaN(l)) {
          const t = parseFloat(fig.style.top) || 0;
          const sx = l * view.scale + view.x;
          const sy = t * view.scale + view.y;
          const ext = FIG_MAX * view.scale;
          visible = sx < W && sx + ext > 0 && sy < H && sy + ext > 0;
        } else {
          const r = fig.getBoundingClientRect();
          visible = r.top < H && r.bottom > 0 && r.left < W && r.right > 0;
        }
        if (visible) toReveal.push(fig);
      }
      for (let i = 0; i < toReveal.length; i++) {
        const fig = toReveal[i];
        const qi = _popQueue.indexOf(fig);
        if (qi !== -1) _popQueue.splice(qi, 1);
        fig.classList.add('order-revealed');
      }
    }, 80);
  };

  let _orderScrollTimer = null;
  window.addEventListener('scroll', () => {
    if (!body.classList.contains('mode-image') || !body.classList.contains('ordered')) return;
    if (body.classList.contains('order-doc-active') || body.classList.contains('order-doc-shrinking')) return;
    if (_orderScrollTimer) return;
    _orderScrollTimer = setTimeout(() => {
      _orderScrollTimer = null;
      queueVisibleFigures();
    }, 80);
  }, { passive: true });

  // ── Figure hover tooltip ──────────────────────────────────────────────
  (function setupHoverTooltip() {
    const tooltip = document.createElement('div');
    tooltip.className = 'img-tooltip';
    tooltip.innerHTML =
      '<div class="tip-category"></div>' +
      '<div class="tip-body">' +
        '<div class="tip-magazine"></div>' +
        '<div class="tip-translation"></div>' +
      '</div>';
    document.body.appendChild(tooltip);

    const archiveData = (typeof window !== 'undefined' && window.ARCHIVE_CATEGORY_DATA) || null;

    // Magazine folder slug → display name (for the description line).
    const FOLDER_LABELS = {
      'Al-Kawakib': 'Al-Kawakib',
      'Al-Mawed': 'Al-Mawed',
      'Al-Rissalah': 'Al-Rissalah',
      'Al-Thqafa': 'Al-Thqafa',
      'Al-alam': 'Al-Alam',
      'Al-ethnayn wa Aldonya': 'Al-Ethnayn wa Aldonya',
      'Al-ethnayn wa aldonya 2': 'Al-Ethnayn wa Aldonya 2',
      'Al-ethnayn wa aldonya 3': 'Al-Ethnayn wa Aldonya 3',
    };

    // Pull "<magazine folder>/<filename>" off the image src — same scheme as
    // loadAllArchiveImages() emits — so we can look the document up in the
    // archive_classification data.
    function imgPathParts(img) {
      if (!img) return null;
      const raw = img.getAttribute('src') || img.src || '';
      if (!raw) return null;
      const path = raw.split(/[?#]/)[0];
      const parts = path.split('/').filter(Boolean);
      if (parts.length < 2) return null;
      return {
        folder: decodeURIComponent(parts[parts.length - 2]),
        file: decodeURIComponent(parts[parts.length - 1]),
      };
    }

    // Inject hover indicator into every figure once
    document.querySelectorAll('#main .sc-gLDymS').forEach((fig) => {
      if (fig.querySelector('.hover-indicator')) return;
      const ind = document.createElement('span');
      ind.className = 'hover-indicator';
      ind.textContent = '↔';
      fig.appendChild(ind);
    });

    function dataFor(fig) {
      const img = fig.querySelector('img');
      const parts = imgPathParts(img);
      let category = '—';
      let magazine = '';
      let translation = '';

      if (parts) {
        magazine = FOLDER_LABELS[parts.folder] || parts.folder;
        const entry = archiveData ? archiveData[`library/${parts.folder}/|${parts.file}`] : null;
        if (entry && entry.primary) category = entry.primary.toUpperCase();

        if (window.TRANSLATIONS) {
          const tEntry = window.TRANSLATIONS[parts.folder + '/' + parts.file];
          if (tEntry && tEntry.headline) translation = tEntry.headline;
        }
      }

      if (window.findIndexRowByImg && img) {
        const row = window.findIndexRowByImg(img.getAttribute('src') || img.src);
        if (row) {
          const cat = (row.querySelector('.col-medium')?.textContent || '').trim().toUpperCase();
          const mag = (row.querySelector('.col-section')?.textContent || '').trim();
          if (cat) category = cat;
          if (mag) magazine = mag;
        }
      }

      return { category, magazine, translation };
    }

    function positionTooltipNearCursor(mx, my) {
      const OFFSET_X = 18;          // right of cursor
      const OFFSET_Y = 18;          // below cursor
      const tw = tooltip.offsetWidth;
      const th = tooltip.offsetHeight;
      let x = mx + OFFSET_X;
      let y = my + OFFSET_Y;
      // Flip to the left of the cursor if it would overflow right
      if (x + tw > window.innerWidth - 8) x = mx - tw - OFFSET_X;
      // Flip above the cursor if it would overflow bottom
      if (y + th > window.innerHeight - 8) y = my - th - OFFSET_Y;
      // Final safety clamp
      x = Math.max(8, x);
      y = Math.max(8, y);
      tooltip.style.left = x + 'px';
      tooltip.style.top  = y + 'px';
    }

    function fillTooltip(data) {
      const catEl = tooltip.querySelector('.tip-category');
      const magEl = tooltip.querySelector('.tip-magazine');
      const trEl = tooltip.querySelector('.tip-translation');
      catEl.textContent = data.category || '—';
      magEl.textContent = data.magazine || '';
      trEl.textContent = data.translation || '';
      catEl.style.display = data.category && data.category !== '—' ? '' : 'none';
      magEl.style.display = data.magazine ? '' : 'none';
      trEl.style.display = data.translation ? '' : 'none';
    }

    function showTooltip(fig, e) {
      fillTooltip(dataFor(fig));
      tooltip.classList.add('visible');
      positionTooltipNearCursor(e.clientX, e.clientY);
    }

    function hideTooltip() {
      tooltip.classList.remove('visible');
    }

    const main = document.getElementById('main');
    main.addEventListener('mouseover', (e) => {
      const fig = e.target.closest('.sc-gLDymS');
      if (!fig) return;
      if (document.body.classList.contains('canvas-text-mode')) return;
      // Skip while dragging the canvas
      if (document.body.classList.contains('is-panning')) return;
      showTooltip(fig, e);
    });
    // Follow the cursor while hovering a figure
    main.addEventListener('mousemove', (e) => {
      if (document.body.classList.contains('canvas-text-mode')) { hideTooltip(); return; }
      if (!tooltip.classList.contains('visible')) return;
      if (document.body.classList.contains('is-panning')) { hideTooltip(); return; }
      positionTooltipNearCursor(e.clientX, e.clientY);
    });
    main.addEventListener('mouseout', (e) => {
      const fig = e.target.closest('.sc-gLDymS');
      if (!fig) return;
      const related = e.relatedTarget;
      if (related && fig.contains(related)) return;
      hideTooltip();
    });
    // Always hide tooltip when leaving the main area or starting a pan
    document.addEventListener('mousedown', hideTooltip);
    window._figTooltip = { show: showTooltip, hide: hideTooltip, move: positionTooltipNearCursor };
  })();

  // ── Canvas detail panel (related images) ─────────────────────────────────
  (function setupCanvasDetailPanel() {
    var panel    = document.getElementById('cdp');
    var listEl   = document.getElementById('cdp-list');
    var catBadge = document.getElementById('cdp-cat-badge');
    var closeBtn = document.getElementById('cdp-close');
    if (!panel || !listEl) return;

    var archive = (typeof window !== 'undefined' && window.ARCHIVE_CATEGORY_DATA) || null;

    function imgParts(img) {
      var raw = (img && (img.getAttribute('src') || img.src)) || '';
      if (!raw) return null;
      var parts = raw.split(/[?#]/)[0].split('/').filter(Boolean);
      if (parts.length < 2) return null;
      return { folder: decodeURIComponent(parts[parts.length - 2]), file: decodeURIComponent(parts[parts.length - 1]) };
    }

    function archiveKey(folder, file) { return 'library/' + folder + '/|' + file; }

    function categoryFor(folder, file) {
      if (!archive) return '';
      var e = archive[archiveKey(folder, file)];
      return (e && e.primary) || '';
    }

    function magLabel(folder) {
      var m = window.MAGAZINE_META && window.MAGAZINE_META[folder];
      return (m && m.name) || folder;
    }

    function openPanel(clickedFig) {
      var img = clickedFig.querySelector('img');
      var p = imgParts(img);
      if (!p) return;
      var cat = categoryFor(p.folder, p.file);

      var allFigs = Array.from(document.querySelectorAll('#main .sc-gLDymS'));
      var related = [];
      allFigs.forEach(function(fig) {
        if (fig === clickedFig) return;
        var fi = imgParts(fig.querySelector('img'));
        if (!fi) return;
        var fc = categoryFor(fi.folder, fi.file);
        if (cat && fc !== cat) return;
        if (!cat && fi.folder !== p.folder) return;
        related.push({ fig: fig, folder: fi.folder, file: fi.file });
      });

      related.sort(function(a, b) {
        var ha = Math.sin((a.folder + a.file).length * 7.3921) * 9999;
        var hb = Math.sin((b.folder + b.file).length * 7.3921) * 9999;
        return (ha - Math.floor(ha)) - (hb - Math.floor(hb));
      });
      related = related.slice(0, 20);

      catBadge.textContent = cat || magLabel(p.folder);

      listEl.innerHTML = '';
      if (related.length === 0) {
        listEl.innerHTML = '<div id="cdp-empty">No related documents found.</div>';
      } else {
        related.forEach(function(r) {
          var mag    = magLabel(r.folder);
          var rCat   = categoryFor(r.folder, r.file);
          var srcImg = r.fig.querySelector('img');
          var srcVal = srcImg ? (srcImg.getAttribute('src') || '') : '';

          var item = document.createElement('div');
          item.className = 'cdp-item';
          item.innerHTML =
            '<div class="cdp-item__img-wrap"><img src="' + srcVal + '" alt="" loading="lazy" decoding="async"></div>' +
            '<div class="cdp-item__caption">' +
              '<div class="cdp-item__mag">' + mag + '</div>' +
              (rCat ? '<span class="cdp-item__tag">' + rCat + '</span>' : '') +
            '</div>';

          item.addEventListener('click', function() {
            closePanel();
            r.fig.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
          });

          listEl.appendChild(item);
        });
      }

      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
    }

    function closePanel() {
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
    }

    closeBtn.addEventListener('click', closePanel);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closePanel(); });

    // Clicking a document no longer opens the related-documents side panel.
  })();

  // ── Page transition helper ─────────────────────────────────────────────
  //    Adds the `.is-covering` class to slide the dark-green overlay down,
  //    runs `callback` once the slide-down completes (so the user never sees
  //    the swap), then adds `.is-leaving` to peel it back up with a concave
  //    bottom edge. CSS handles the actual transform + path morph.
  const _PT_DURATION = 1200;
  let _pageTransitioning = false;
  function withPageTransition(callback) {
    return new Promise((resolve) => {
      const overlay = document.getElementById('pageTransition');
      // If the overlay is missing or a previous run somehow left the busy
      // flag stuck, still run the callback so the navigation works — losing
      // the visual flourish is preferable to a dead button.
      if (!overlay || _pageTransitioning) {
        if (callback) callback();
        resolve();
        return;
      }
      _pageTransitioning = true;

      // Silent reset back to the default off-screen-above state in case the
      // previous cycle left the overlay at translateY(100%) (below viewport).
      // Without this snap, adding `is-covering` would animate the overlay
      // back up across the viewport instead of dropping in fresh from above.
      overlay.classList.add('no-transition');
      overlay.classList.remove('is-covering', 'is-leaving');
      void overlay.offsetWidth;
      overlay.classList.remove('no-transition');
      void overlay.offsetWidth;

      // Phase 1: slide DOWN to cover, the convex bottom curve flattens.
      overlay.classList.add('is-covering');

      setTimeout(() => {
        if (callback) callback();
        // Phase 2: continue DOWN off the bottom; the now-trailing TOP edge
        // dips inward as the overlay falls away. Same motion direction as
        // phase 1 → user reads it as one continuous sweep.
        overlay.classList.remove('is-covering');
        overlay.classList.add('is-leaving');

        setTimeout(() => {
          // Silent reset for the next cycle.
          overlay.classList.add('no-transition');
          overlay.classList.remove('is-leaving');
          void overlay.offsetWidth;
          overlay.classList.remove('no-transition');
          _pageTransitioning = false;
          resolve();
        }, _PT_DURATION);
      }, _PT_DURATION);
    });
  }
  window.withPageTransition = withPageTransition;

  modeTabs.forEach((b) =>
    b.addEventListener('click', () => {
      const target = b.dataset.mode;
      // Skip the transition if we're already on the target mode.
      if (body.classList.contains('mode-' + target)) return;
      withPageTransition(() => setMode(target));
    })
  );

  // Initial mode (no transition on first load).
  // Body already carries mode-image in HTML so the story layout never paints;
  // gallery boot runs once after the canvas pan code is ready (see below).
  if (body.classList.contains('mode-image')) {
    modeTabs.forEach((b) =>
      b.classList.toggle('active', b.dataset.mode === 'image')
    );
    closeAll();
  } else {
    setMode('image');
  }

  // Re-scatter on resize when in image mode (positions are in vw)
  let resizeTimer;
  window.addEventListener('resize', () => {
    if (!body.classList.contains('mode-image')) return;
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      // Preserve the current layout across resizes instead of always
      // snapping back to scatter.
      if (body.classList.contains('canvas-text-mode') || !body.classList.contains('canvas-gridorder')) {
        if (!body.classList.contains('ordered')) applyImageScatter();
      } else {
        applyImageGridOrder();
      }
    }, 150);
  });

  // ── Transform-based canvas + momentum (vis-map pattern) ─────────────
  (function enableCanvasPan() {
    let MAP_W = 9000, MAP_H = 6000;
    // Zoom-out floor. The scatter canvas stops at 0.78 (chosen limit). The
    // "Organise" grid view frames itself at 0.562 to fit the whole grid, so
    // it gets a lower floor; otherwise wheel-zoom there would snap the grid
    // in and you couldn't see all of it.
    const SCATTER_MIN_SCALE = 0.78;
    const GRID_MIN_SCALE = 0.5;
    const MAX_SCALE = 3;
    const currentMinScale = () =>
      body.classList.contains('canvas-gridorder') ? GRID_MIN_SCALE : SCATTER_MIN_SCALE;
    const map = document.getElementById('main');
    let _px = -(MAP_W / 2 - innerWidth / 2);
    let _py = -(MAP_H / 2 - innerHeight / 2);
    let _scale = 1.4;
    let vx = 0, vy = 0, rafId = null;
    let dragging = false, lastMX = 0, lastMY = 0;
    let throwVx = 0, throwVy = 0;

    const isActive = () =>
      body.classList.contains('mode-image') &&
      !body.classList.contains('ordered') &&
      !body.classList.contains('canvas-organized') &&
      !body.classList.contains('intro-active');

    function applyTransform() {
      map.style.transformOrigin = '0 0';
      // translate3d forces the browser to promote #main to its own GPU layer,
      // so panning ~1272 figures becomes a compositor-only op instead of a
      // main-thread repaint.
      map.style.transform = `translate3d(${_px}px, ${_py}px, 0) scale(${_scale})`;
    }
    // Read-only view of the current pan/zoom. Lets the reveal + parallax code
    // compute each figure's on-screen position from its inline left/top
    // (screen = map · scale + offset) instead of getBoundingClientRect —
    // which forced a full layout of ~1272 absolutely-positioned figures.
    window._canvasView = function () { return { x: _px, y: _py, scale: _scale }; };
    const minX = () => Math.min(0, innerWidth  - MAP_W * _scale);
    const minY = () => Math.min(0, innerHeight - MAP_H * _scale);

    // Grid mode resizes the pannable area to exactly fit the real content
    // (the justified-row grid is deliberately narrow + tall, not a square);
    // scatter resets it back to 9000×6000. No artificial floor here — a
    // floor previously forced MAP_W to stay ≥9000 even when the grid's real
    // content was only ~3000px wide, which meant the pan clamp still allowed
    // scrolling into empty space past the actual content's right edge.
    // Figures render outside #main's box (overflow:visible), so only the pan
    // clamp needs to know the new extent.
    window._setCanvasBounds = function (w, h) {
      MAP_W = w || 9000;
      MAP_H = h || 6000;
      const mX = minX(), mY = minY();
      if (_px < mX) _px = mX;
      if (_py < mY) _py = mY;
      if (_px > 0) _px = 0;
      if (_py > 0) _py = 0;
      applyTransform();
    };

    // Zoom so the canvas point under (cx, cy) stays under (cx, cy).
    function zoomAt(cx, cy, factor) {
      const newScale = Math.max(currentMinScale(), Math.min(MAX_SCALE, _scale * factor));
      if (newScale === _scale) return;
      const ratio = newScale / _scale;
      _px = cx - (cx - _px) * ratio;
      _py = cy - (cy - _py) * ratio;
      _scale = newScale;
      // Re-clamp to bounds at the new scale
      const mX = minX(), mY = minY();
      if (_px > 0) _px = 0;
      if (_px < mX) _px = mX;
      if (_py > 0) _py = 0;
      if (_py < mY) _py = mY;
      applyTransform();
      if (window._afterPan) window._afterPan();
    }

    function loop() {
      // If a figure drag starts mid-throw, suspend canvas physics so the two
      // interactions don't compete for the main thread.
      if (figDragging) { rafId = requestAnimationFrame(loop); return; }
      vx *= 0.88; vy *= 0.88;
      _px += vx;  _py += vy;
      const mX = minX(), mY = minY();
      // Hard stop at edges (no spring-back / bounce)
      if (_px > 0)  { _px = 0;  vx = 0; }
      if (_px < mX) { _px = mX; vx = 0; }
      if (_py > 0)  { _py = 0;  vy = 0; }
      if (_py < mY) { _py = mY; vy = 0; }
      applyTransform();
      if (window._afterPan) window._afterPan();
      if (Math.abs(vx) < 0.08 && Math.abs(vy) < 0.08) {
        vx = 0; vy = 0; rafId = null;
        if (window._afterPan) window._afterPan();
      } else {
        rafId = requestAnimationFrame(loop);
      }
    }
    function startLoop() {
      if (!rafId) rafId = requestAnimationFrame(loop);
    }

    // Wheel → velocity (or zoom when ctrl/cmd is held — also catches trackpad pinch)
    window.addEventListener('wheel', (e) => {
      if (!isActive()) return;
      if (e.target.closest('.index-panel')) return;
      if (e.target.closest('#preview-page')) return;
      if (e.target.closest('.adx-overlay')) return;
      if (e.target.closest('#about-page')) return;

      // Trackpad pinch is delivered to the browser as ctrl+wheel
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        // Smooth exponential zoom (handles deltaMode 0/1/2 uniformly because
        // we only use the sign/relative magnitude of deltaY)
        const factor = Math.exp(-e.deltaY * 0.01);
        zoomAt(e.clientX, e.clientY, factor);
        return;
      }

      if (e.altKey) return;
      e.preventDefault();
      const s = e.deltaMode === 0 ? 1 : e.deltaMode === 1 ? 20 : 300;
      vx += -e.deltaX * 0.35 * s;
      vy += -e.deltaY * 0.35 * s;
      const CAP = 50;
      if (vx >  CAP) vx =  CAP;
      if (vx < -CAP) vx = -CAP;
      if (vy >  CAP) vy =  CAP;
      if (vy < -CAP) vy = -CAP;
      startLoop();
    }, { passive: false });

    // Per-figure drag state (separate from canvas pan).
    // figDragDX/DY accumulate the total drag offset so we can apply it as a
    // GPU-composited transform instead of writing style.left/top each frame
    // (writing left/top would reflow the entire 1272-figure map).
    let figDragging = false;
    let figDragTarget = null;
    let figDragLastX = 0, figDragLastY = 0;
    let figDragDX = 0,   figDragDY = 0;
    let _zCounter = 200;

    // Drag → 1:1 move + throw on release (canvas pan OR per-figure drag)
    window.addEventListener('mousedown', (e) => {
      if (!isActive()) return;
      if (body.classList.contains('ordered')) return;
      if (e.button !== 0) return;
      if (e.target.closest('.sc-ivnBVK, .index-panel, .artifact-stack, .category-page, button, a')) return;
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }

      // If the click landed on a figure → drag that figure individually
      const fig = e.target.closest('.sc-gLDymS');
      if (fig) {
        figDragging = true;
        figDragTarget = fig;
        figDragLastX = e.clientX;
        figDragLastY = e.clientY;
        figDragDX = 0; figDragDY = 0;
        fig.style.zIndex = String(++_zCounter);  // bring to front
        fig.style.willChange = 'transform';       // hint compositor to prep a layer
        body.classList.add('is-panning');
        e.preventDefault();
        return;
      }

      // Otherwise → pan the canvas
      dragging = true;
      lastMX = e.clientX; lastMY = e.clientY;
      throwVx = 0; throwVy = 0;
      body.classList.add('is-panning');
      e.preventDefault();
    });
    // Mousemove fires far more often than the display refreshes (125–1000Hz
    // mice vs 60–120Hz screens). Handlers only update numbers; the actual
    // style write happens at most once per frame via this rAF, so a fast
    // mouse can't queue up redundant style/recalc work and stall the drag.
    let _moveRaf = 0;
    function _applyMoveFrame() {
      _moveRaf = 0;
      if (figDragging && figDragTarget) {
        // GPU-only translate — no reflow of the 1272-child map. Must be
        // `!important`: every figure keeps its `popping-in` class, whose
        // `animation: pop-in … both` retains `transform: scale(1)` via
        // fill-mode, and a filled animation outranks a normal inline style.
        // (The parallax writes its transform `!important` for the same reason.)
        figDragTarget.style.setProperty(
          'transform',
          'translate3d(' + figDragDX + 'px,' + figDragDY + 'px,0)',
          'important'
        );
      } else if (dragging) {
        applyTransform();
        if (window._afterPan) window._afterPan();
      }
    }
    function _scheduleMoveFrame() {
      if (!_moveRaf) _moveRaf = requestAnimationFrame(_applyMoveFrame);
    }

    window.addEventListener('mousemove', (e) => {
      // Per-figure drag takes priority
      if (figDragging && figDragTarget) {
        figDragDX += e.clientX - figDragLastX;
        figDragDY += e.clientY - figDragLastY;
        figDragLastX = e.clientX;
        figDragLastY = e.clientY;
        _scheduleMoveFrame();
        return;
      }
      if (!dragging) return;
      const dx = e.clientX - lastMX, dy = e.clientY - lastMY;
      throwVx = dx; throwVy = dy;
      _px += dx; _py += dy;
      // Hard-clamp to bounds during drag (no overshoot)
      const mX = minX(), mY = minY();
      if (_px > 0) _px = 0;
      if (_px < mX) _px = mX;
      if (_py > 0) _py = 0;
      if (_py < mY) _py = mY;
      lastMX = e.clientX; lastMY = e.clientY;
      _scheduleMoveFrame();
    });
    function stopDrag() {
      if (_moveRaf) { cancelAnimationFrame(_moveRaf); _moveRaf = 0; }
      // End per-figure drag with no momentum
      if (figDragging) {
        if (figDragTarget && (figDragDX !== 0 || figDragDY !== 0)) {
          // Commit the drag transform back to left/top so future interactions
          // (pan hit-testing, index lookups) see the settled position. One
          // reflow at end of drag is fine; one per frame during drag was not.
          const left = parseFloat(figDragTarget.style.left) || 0;
          const top  = parseFloat(figDragTarget.style.top)  || 0;
          figDragTarget.style.left = (left + figDragDX) + 'px';
          figDragTarget.style.top  = (top  + figDragDY) + 'px';
          figDragTarget.style.transform = '';
          figDragTarget.style.willChange = '';
        } else if (figDragTarget) {
          figDragTarget.style.willChange = '';
        }
        figDragging = false;
        figDragTarget = null;
        figDragDX = 0; figDragDY = 0;
        body.classList.remove('is-panning');
        return;
      }
      if (!dragging) return;
      dragging = false;
      body.classList.remove('is-panning');
      vx = Math.max(-40, Math.min(40, throwVx * 3));
      vy = Math.max(-40, Math.min(40, throwVy * 3));
      startLoop();
    }
    window.addEventListener('mouseup', stopDrag);
    window.addEventListener('mouseleave', stopDrag);

    // Touch (single-finger pan/drag OR two-finger pinch-zoom)
    let pinchActive = false, pinchStartDist = 0, pinchStartScale = 1;
    function touchDist(t1, t2) {
      const dx = t1.clientX - t2.clientX, dy = t1.clientY - t2.clientY;
      return Math.sqrt(dx * dx + dy * dy);
    }
    function touchMid(t1, t2) {
      return { x: (t1.clientX + t2.clientX) / 2, y: (t1.clientY + t2.clientY) / 2 };
    }

    window.addEventListener('touchstart', (e) => {
      if (!isActive()) return;
      if (body.classList.contains('ordered')) return;
      if (e.target.closest('.sc-ivnBVK, .index-panel, .artifact-stack, .category-page, button, a')) return;
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }

      if (e.touches.length === 2) {
        pinchActive = true;
        pinchStartDist  = touchDist(e.touches[0], e.touches[1]);
        pinchStartScale = _scale;
        dragging = false;
        figDragging = false; figDragTarget = null;
        return;
      }
      if (e.touches.length !== 1) return;
      const t = e.touches[0];
      const fig = e.target.closest('.sc-gLDymS');
      if (fig) {
        figDragging = true;
        figDragTarget = fig;
        figDragLastX = t.clientX;
        figDragLastY = t.clientY;
        figDragDX = 0; figDragDY = 0;
        fig.style.zIndex = String(++_zCounter);
        fig.style.willChange = 'transform';
        return;
      }
      dragging = true;
      lastMX = t.clientX; lastMY = t.clientY;
      throwVx = 0; throwVy = 0;
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      // Pinch
      if (pinchActive && e.touches.length === 2) {
        const dist  = touchDist(e.touches[0], e.touches[1]);
        const mid   = touchMid(e.touches[0], e.touches[1]);
        const factor = dist / pinchStartDist;
        const target = pinchStartScale * factor;
        zoomAt(mid.x, mid.y, target / _scale);
        return;
      }
      if (e.touches.length !== 1) return;
      const t = e.touches[0];
      if (figDragging && figDragTarget) {
        figDragDX += t.clientX - figDragLastX;
        figDragDY += t.clientY - figDragLastY;
        figDragLastX = t.clientX;
        figDragLastY = t.clientY;
        _scheduleMoveFrame();
        return;
      }
      if (!dragging) return;
      const dx = t.clientX - lastMX, dy = t.clientY - lastMY;
      throwVx = dx; throwVy = dy;
      _px += dx; _py += dy;
      const mX = minX(), mY = minY();
      if (_px > 0) _px = 0;
      if (_px < mX) _px = mX;
      if (_py > 0) _py = 0;
      if (_py < mY) _py = mY;
      lastMX = t.clientX; lastMY = t.clientY;
      _scheduleMoveFrame();
    }, { passive: true });
    window.addEventListener('touchend', (e) => {
      if (pinchActive && e.touches.length < 2) {
        pinchActive = false;
        if (window._afterPan) window._afterPan();
        return;
      }
      stopDrag();
    });

    // Centering hook called when (re-)entering unordered IMAGE mode
    window.centerCanvas = function (scale) {
      if (!isActive()) return;
      _scale = scale || 1.4;
      _px = innerWidth  / 2 - (MAP_W / 2) * _scale;
      _py = innerHeight / 2 - (MAP_H / 2) * _scale;
      vx = 0; vy = 0;
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      applyTransform();
    };
    function _clampOffsets() {
      const mX = minX(), mY = minY();
      if (_px > 0) _px = 0; if (_px < mX) _px = mX;
      if (_py > 0) _py = 0; if (_py < mY) _py = mY;
    }
    // Instantly zoom to `scale` about the current screen centre — keeps the
    // canvas point under the middle of the viewport fixed, so the view zooms
    // in place instead of jumping to the (grid) map centre. No lateral pan.
    window.setCanvasZoomInPlace = function (scale) {
      if (!isActive()) return;
      const ax = innerWidth / 2, ay = innerHeight / 2;
      const cx = (ax - _px) / _scale, cy = (ay - _py) / _scale;
      _scale = scale;
      _px = ax - cx * _scale;
      _py = ay - cy * _scale;
      _clampOffsets();
      vx = 0; vy = 0;
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      applyTransform();
    };
    // Animated version — zooms about the screen centre over `duration` ms via
    // the same cheap per-frame rAF the pan loop uses. A CSS `transition` on
    // #main instead would promote the whole 28000×14000 grid to one giant
    // compositor layer and freeze the renderer, so we must NOT do that.
    window.animateCanvasZoomInPlace = function (targetScale, duration, done) {
      if (!isActive()) { if (done) done(); return; }
      const ax = innerWidth / 2, ay = innerHeight / 2;
      const cx = (ax - _px) / _scale, cy = (ay - _py) / _scale;   // fixed canvas point
      const s0 = _scale, s1 = targetScale;
      const t0 = performance.now();
      vx = 0; vy = 0;
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      rafId = requestAnimationFrame(function step(now) {
        const k = Math.min(1, (now - t0) / duration);
        const e = 1 - Math.pow(1 - k, 3);   // easeOutCubic
        _scale = s0 + (s1 - s0) * e;
        _px = ax - cx * _scale;
        _py = ay - cy * _scale;
        _clampOffsets();
        applyTransform();
        if (window._afterPan) window._afterPan();   // reveal figures entering the widening frame
        if (k < 1) { rafId = requestAnimationFrame(step); }
        else { rafId = null; if (done) done(); }
      });
    };
    // Reset hook called when leaving the mode
    window.resetCanvas = function () {
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      vx = 0; vy = 0;
      _scale = 1;
      map.style.transform = '';
    };

    // Initial paint (in case page loads directly into image mode)
    applyTransform();
  })();

  // Single gallery boot — scatter, center, reveal canvas, then pop-in once.
  requestAnimationFrame(() => requestAnimationFrame(bootGallery));

  // Order button: toggle between scattered (default) and ordered grid view.
  // The swap is hidden behind the full-screen page transition — by the time
  // the overlay covers the viewport, the DOM rearrangement is already done.
  let _orderBusy = false;

  function applyGridLayout() {
    // Masonry via CSS columns — no explicit position needed
    document.querySelectorAll('#main .sc-gLDymS').forEach(fig => {
      fig.style.gridColumn = '';
      fig.style.gridRow    = '';
      fig.removeAttribute('data-grid-featured');
    });
  }

  function resetGridLayout() {
    document.querySelectorAll('#main .sc-gLDymS').forEach(fig => {
      fig.style.gridColumn = '';
      fig.style.gridRow    = '';
      fig.removeAttribute('data-grid-featured');
    });
  }

  window.applyGridLayout        = applyGridLayout;
  window.resetGridLayout        = resetGridLayout;
  window.groupFiguresByCategory = groupFiguresByCategory;
  window.clearImageScatter      = clearImageScatter;
  window.resetPopInState        = resetPopInState;
  window.triggerPopIn           = triggerPopIn;

  document.getElementById('order-btn').addEventListener('click', async () => {
    if (_orderBusy) return;
    if (!body.classList.contains('mode-image')) return;
    const nowOrdered = !body.classList.contains('ordered');
    if (nowOrdered && body.classList.contains('canvas-text-mode')) return;
    _orderBusy = true;

    const orderBtn = document.getElementById('order-btn');
    orderBtn.classList.toggle('active', nowOrdered);
    const _btnLabel = orderBtn.querySelector('.taxonomy-bar__btn-label');
    if (_btnLabel) _btnLabel.textContent = nowOrdered ? 'Shuffle' : 'Grid';
    else orderBtn.textContent = nowOrdered ? 'Shuffle' : 'Grid';

    await withPageTransition(() => {
      body.classList.toggle('ordered', nowOrdered);
      if (nowOrdered) {
        clearImageScatter();
        groupFiguresByCategory();
        if (window.resetCanvas) window.resetCanvas();
        if (window._galleryParallaxReset) window._galleryParallaxReset();
        window.scrollTo(0, 0);
        resetPopInState();
        requestAnimationFrame(applyGridLayout);
      } else {
        if (window.resetOrderDocFocus) window.resetOrderDocFocus();
        restoreFiguresOriginalOrder();
        resetGridLayout();
        if (!restoreScatterFromCache()) applyImageScatter();
        if (window.centerCanvas) window.centerCanvas();
        resetPopInState();
      }
    });

    if (nowOrdered) {
      requestAnimationFrame(() => requestAnimationFrame(triggerPopIn));
    } else {
      triggerPopIn();
    }
    _orderBusy = false;
  });

  // ── Cold-load kick: make sure figures pop in without needing a scroll ───
  // The initial pop-in inside setMode('image') runs in a single RAF, before
  // the canvas pan IIFE has finished applying its centering transform and
  // before most archive images have intrinsic dimensions. That early call to
  // queueVisibleFigures often finds zero figures inside the viewport, so the
  // figures stay at opacity:0 until a pan event fires queueVisibleFigures
  // again. Re-triggering here guarantees one solid queue pass.
  // ── Category filter: a table-style panel at bottom-left that hides
  //    figures whose archive Primary_Category doesn't match the active row.
  //    Includes:
  //      • per-row count derived from window.ARCHIVE_CATEGORY_DATA
  //      • drag-to-move via the left handle
  //      • Search… box filters which category rows are visible
  //      • Count column header toggles ascending/descending sort
  //      • + button resets the filter back to "All"
  // ── Order metadata tooltip: when the user hovers a figure in ORDER view,
  //    populate the fixed bottom-right card with that figure's ref number,
  //    category label and a short italic description (taken from the
  //    CATEGORY_DESCRIPTIONS map already defined above).
  (function setupOrderMeta() {
    const panel = document.getElementById('orderMeta');
    if (!panel) return;
    const refEl  = document.getElementById('orderMetaRef');
    const catEl  = document.getElementById('orderMetaCat');
    const descEl = document.getElementById('orderMetaDesc');
    const archive = (typeof window !== 'undefined' && window.ARCHIVE_CATEGORY_DATA) || null;

    function categoryForFig(fig) {
      if (!archive || !fig) return '';
      const img = fig.querySelector('img');
      if (!img) return '';
      const raw = img.getAttribute('src') || img.src || '';
      if (!raw) return '';
      const path = raw.split(/[?#]/)[0];
      const parts = path.split('/').filter(Boolean);
      if (parts.length < 2) return '';
      const folder = decodeURIComponent(parts[parts.length - 2]);
      const file = decodeURIComponent(parts[parts.length - 1]);
      const entry = archive[`library/${folder}/|${file}`];
      return (entry && entry.primary) || '';
    }
    function refForFig(fig) {
      const cap = fig.querySelector('figcaption p, figcaption')?.textContent.trim() || '';
      const m = cap.match(/\[(.+?)\]/);
      return m ? '[' + m[1] + ']' : '';
    }

    function showFor(fig) {
      if (!fig) return;
      if (!body.classList.contains('mode-image') || !body.classList.contains('ordered')) return;
      const cat = categoryForFig(fig);
      if (!cat) return;
      refEl.textContent  = refForFig(fig);
      catEl.textContent  = cat.toUpperCase();
      descEl.textContent = CATEGORY_DESCRIPTIONS[cat] || '';
      panel.classList.add('is-active');
    }
    function hide() { panel.classList.remove('is-active'); }

    document.addEventListener('mouseover', (e) => {
      const fig = e.target.closest('#main .sc-gLDymS');
      if (fig) showFor(fig);
    });
    // Hide whenever ORDER is exited (mode change or toggle).
    document.addEventListener('mode-change', hide);
  })();

  (function setupArtifactPanel() {
    const stack = document.getElementById('artifactStack');
    const indexTab = document.getElementById('artifactIndexTab');
    const closeBtn = document.getElementById('artifactCardClose');
    const titleEl = document.getElementById('artifactTitle');
    const subtitleEl = document.getElementById('artifactSubtitle');
    const metaEl = document.getElementById('artifactMeta');
    const periodEl = document.getElementById('artifactPeriod');
    const descEl = document.getElementById('artifactDesc');
    const notesEl = document.getElementById('artifactNotes');
    const readingEl = document.getElementById('artifactReadingText');
    const rowsContainer = document.getElementById('artifactFilterRows');
    if (!stack || !rowsContainer) return;

    const archive = (typeof window !== 'undefined' && window.ARCHIVE_CATEGORY_DATA) || null;
    if (!archive) {
      console.warn('[bronzewoman] ARCHIVE_CATEGORY_DATA not loaded — artifact panel filter will be inert');
    }

    const rows = Array.from(rowsContainer.querySelectorAll('.artifact-filter-row'));
    const sectionToggles = stack.querySelectorAll('.artifact-section__toggle');
    const detailsPanel = document.getElementById('artifactDetailsPanel');
    const readingPanel = document.getElementById('artifactReadingPanel');

    const DEFAULT = {
      title: 'On the Impulse to Notate',
      subtitle: 'Darwish Alami Library',
      meta: 'ARCHIVE, RESEARCH, DESIGN',
      period: '2024 — PRESENT',
      desc: 'A scattered field of Arab magazine clippings — portraits, advertisements, street scenes, and leisure pages from mid-century print culture.',
      notes: [],
    };

    const FOLDER_LABELS = {
      'Al-Kawakib': 'Al-Kawakib',
      'Al-Mawed': 'Al-Mawed',
      'Al-Rissalah': 'Al-Rissalah',
      'Al-Thqafa': 'Al-Thqafa',
      'Al-alam': 'Al-Alam',
      'Al-ethnayn wa Aldonya': 'Al-Ethnayn wa Aldonya',
      'Al-ethnayn wa aldonya 2': 'Al-Ethnayn wa Aldonya 2',
      'Al-ethnayn wa aldonya 3': 'Al-Ethnayn wa Aldonya 3',
    };

    let activeCat = 'all';

    function imgPathParts(img) {
      if (!img) return null;
      const raw = img.getAttribute('src') || img.src || '';
      if (!raw) return null;
      const path = raw.split(/[?#]/)[0];
      const parts = path.split('/').filter(Boolean);
      if (parts.length < 2) return null;
      return {
        folder: decodeURIComponent(parts[parts.length - 2]),
        file: decodeURIComponent(parts[parts.length - 1]),
      };
    }

    function figCategory(fig) {
      if (!archive || !fig) return '';
      const parts = imgPathParts(fig.querySelector('img'));
      if (!parts) return '';
      const entry = archive[`library/${parts.folder}/|${parts.file}`];
      return (entry && entry.primary) || '';
    }

    function refreshCounts() {
      const counts = { 'People': 0, 'Desires': 0,
                       'Leisure': 0, 'Street': 0 };
      let total = 0;
      if (archive) {
        Object.values(archive).forEach((entry) => {
          if (!entry) return;
          if (counts.hasOwnProperty(entry.primary)) counts[entry.primary] += 1;
          total += 1;
        });
      }
      rows.forEach((row) => {
        const cat = row.dataset.cat;
        const countCell = row.querySelector('[data-count]');
        if (!countCell) return;
        const value = cat === 'all' ? total : (counts[cat] || 0);
        countCell.textContent = String(value);
        countCell.dataset.count = String(value);
      });
    }

    function applyFilter(cat) {
      activeCat = cat;
      const figs = document.querySelectorAll('#main .sc-gLDymS');
      if (cat === 'all') {
        figs.forEach((fig) => fig.classList.remove('filter-hidden'));
      } else {
        figs.forEach((fig) => {
          if (figCategory(fig) === cat) fig.classList.remove('filter-hidden');
          else fig.classList.add('filter-hidden');
        });
      }
      if (cat === 'all') {
        readingEl.textContent = 'Select a category in Details to read its description.';
      } else {
        readingEl.textContent = CATEGORY_DESCRIPTIONS[cat] || '';
      }
    }

    function selectRow(targetRow) {
      rows.forEach((row) => row.classList.remove('active'));
      targetRow.classList.add('active');
      applyFilter(targetRow.dataset.cat);
    }

    window.selectGalleryCategory = function (cat, filterOnly) {
      const row = rows.find((r) => r.dataset.cat === cat);
      if (!row) return;
      rows.forEach((r) => r.classList.remove('active'));
      row.classList.add('active');
      if (filterOnly !== false) applyFilter(cat);
    };

    window.filterGalleryByCategory = function (cat) { applyFilter(cat); };

    function setDefaultContent() {
      titleEl.textContent = DEFAULT.title;
      subtitleEl.textContent = DEFAULT.subtitle;
      metaEl.textContent = DEFAULT.meta;
      periodEl.textContent = DEFAULT.period;
      descEl.textContent = DEFAULT.desc;
      notesEl.innerHTML = '';
    }

    function showForFig(fig) {
      if (!body.classList.contains('mode-image') || body.classList.contains('ordered')) return;
      if (!fig || fig.classList.contains('filter-hidden')) return;

      const cap = (fig.querySelector('figcaption p')?.textContent || '').trim();
      const refMatch = cap.match(/\[(.+?)\]/);
      const ref = refMatch ? refMatch[1] : '';
      const fragment = fig.closest('.sc-blLrKi');
      const h3 = fragment?.querySelector('.sc-irTrJD');
      let section = '', page = '';
      if (h3) {
        const text = h3.textContent.trim();
        const m = text.match(/^(.+?),\s*P\.\s*(.+)$/);
        if (m) { section = m[1].trim(); page = m[2].trim(); }
        else section = text;
      }

      const parts = imgPathParts(fig.querySelector('img'));
      let folder = '';
      let cat = '';
      if (parts) {
        folder = FOLDER_LABELS[parts.folder] || parts.folder;
        const entry = archive ? archive[`library/${parts.folder}/|${parts.file}`] : null;
        if (entry && entry.primary) cat = entry.primary;
      }

      titleEl.textContent = ref ? '[' + ref + ']' : DEFAULT.title;
      subtitleEl.textContent = cat || 'Uncategorized document';
      metaEl.textContent = folder ? folder.toUpperCase() : 'MAGAZINE ARCHIVE';
      periodEl.textContent = section
        ? (section + (page ? ', P. ' + page : '')).toUpperCase()
        : DEFAULT.period;
      descEl.textContent = section
        ? section + (page ? ', p. ' + page : '') + (folder ? ' — from the ' + folder + ' archive.' : '')
        : (folder ? 'From the ' + folder + ' archive of Arab magazine clippings.' : DEFAULT.desc);

      notesEl.innerHTML = '';
      if (cat && CATEGORY_DESCRIPTIONS[cat]) {
        const li = document.createElement('li');
        li.textContent = CATEGORY_DESCRIPTIONS[cat];
        notesEl.appendChild(li);
      }
      stack.classList.remove('is-collapsed');
    }

    rowsContainer.addEventListener('click', (e) => {
      const row = e.target.closest('.artifact-filter-row');
      if (!row) return;
      const cat = row.dataset.cat;
      if (cat === 'all') {
        selectRow(row);
        return;
      }
      if (window.openCategoryPage) window.openCategoryPage(cat);
    });

    sectionToggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const panel = btn.getAttribute('aria-controls') === 'artifactDetailsPanel'
          ? detailsPanel : readingPanel;
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
        panel.hidden = open;
      });
    });

    closeBtn.addEventListener('click', () => {
      stack.classList.add('is-collapsed');
    });

    indexTab.addEventListener('click', (e) => {
      e.stopPropagation();
      stack.classList.remove('is-collapsed');
      indexBtn.click();
    });

    document.getElementById('main').addEventListener('mouseover', (e) => {
      const fig = e.target.closest('.sc-gLDymS');
      if (!fig) return;
      if (document.body.classList.contains('is-panning')) return;
      showForFig(fig);
    });

    document.getElementById('main').addEventListener('mouseout', (e) => {
      const fig = e.target.closest('.sc-gLDymS');
      if (!fig) return;
      const related = e.relatedTarget;
      if (related && fig.contains(related)) return;
      setDefaultContent();
    });

    refreshCounts();
    setDefaultContent();
  })();

  (function setupCategoryPages() {
    const page = document.getElementById('categoryPage');
    const titleEl = document.getElementById('categoryPageTitle');
    const taglineEl = document.getElementById('categoryPageTagline');
    const bodyEl = document.getElementById('categoryPageBody');
    const nextBtn = document.getElementById('categoryPageNext');
    if (!page || !titleEl || !bodyEl || !nextBtn) return;

    let currentCat = null;
    let busy = false;

    function renderCategory(cat) {
      const content = CATEGORY_PAGE_CONTENT[cat];
      if (!content) return;
      currentCat = cat;
      titleEl.textContent = cat;
      taglineEl.textContent = content.subcategory || '';
      bodyEl.innerHTML = content.paragraphs
        .map((p) => '<p>' + p + '</p>')
        .join('');
      // Populate 5 images from this category in the READ-page figure style
      const imagesEl = document.getElementById('categoryPageImages');
      if (imagesEl) {
        imagesEl.innerHTML = '';
        const allFigs = Array.from(document.querySelectorAll('#main .sc-gLDymS:not(.is-uncategorized)'));
        const catFigs = allFigs.filter((fig) => getCategoryForFig(fig) === cat);
        catFigs.slice().sort(() => Math.random() - 0.5).slice(0, 4).forEach((fig) => {
          const srcImg = fig.querySelector('img');
          if (!srcImg) return;
          const capText = (fig.querySelector('figcaption p')?.textContent || '').trim();
          const figEl = document.createElement('figure');
          figEl.className = 'category-page__img-fig';
          const imgEl = document.createElement('img');
          imgEl.src = srcImg.getAttribute('src') || srcImg.src;
          imgEl.alt = srcImg.alt || '';
          const cap = document.createElement('figcaption');
          cap.textContent = capText;
          const ind = document.createElement('span');
          ind.className = 'hover-indicator';
          ind.textContent = '↔';
          figEl.appendChild(imgEl);
          figEl.appendChild(cap);
          figEl.appendChild(ind);
          figEl._srcFig = fig;
          imagesEl.appendChild(figEl);
        });
      }
      if (window.selectGalleryCategory) window.selectGalleryCategory(cat, false);
    }

    // Set up image strip hover handlers once (not per renderCategory call)
    (function () {
      const imagesEl = document.getElementById('categoryPageImages');
      if (!imagesEl) return;
      imagesEl.addEventListener('mouseover', (e) => {
        const item = e.target.closest('.category-page__img-fig');
        if (!item || !item._srcFig) return;
        if (window._figTooltip) window._figTooltip.show(item._srcFig, e);
      });
      imagesEl.addEventListener('mousemove', (e) => {
        if (window._figTooltip) window._figTooltip.move(e.clientX, e.clientY);
      });
      imagesEl.addEventListener('mouseout', (e) => {
        const item = e.target.closest('.category-page__img-fig');
        if (!item) return;
        if (e.relatedTarget && item.contains(e.relatedTarget)) return;
        if (window._figTooltip) window._figTooltip.hide();
      });
    })();

    function showPage() {
      page.hidden = false;
      page.setAttribute('aria-hidden', 'false');
      body.classList.add('category-page-open');
      requestAnimationFrame(() => {
        page.classList.add('is-visible');
      });
    }

    function hidePage(applyFilter) {
      page.classList.remove('is-visible');
      body.classList.remove('category-page-open');
      window.setTimeout(() => {
        page.hidden = true;
        page.setAttribute('aria-hidden', 'true');
        if (applyFilter && currentCat && window.selectGalleryCategory) {
          window.selectGalleryCategory(currentCat, true);
        } else if (window.selectGalleryCategory) {
          window.selectGalleryCategory('all', true);
        }
        currentCat = null;
        busy = false;
      }, 420);
    }

    function openCategoryPage(cat) {
      if (busy || !body.classList.contains('mode-image') || body.classList.contains('ordered')) return;
      if (!CATEGORY_PAGE_CONTENT[cat]) return;
      busy = true;
      const stack = document.getElementById('artifactStack');
      if (stack) stack.classList.add('is-collapsed');
      if (typeof withPageTransition === 'function') {
        withPageTransition(() => {
          renderCategory(cat);
          showPage();
        }).then(() => { busy = false; });
      } else {
        renderCategory(cat);
        showPage();
        busy = false;
      }
    }
    window.openCategoryPage = openCategoryPage;
    // Exposed so the taxonomy bar's INDEX button can dismiss an open
    // category page and return to the full gallery cloud.
    window.closeCategoryPage = function (applyFilter) {
      if (!body.classList.contains('category-page-open')) return;
      if (busy) return;
      busy = true;
      if (typeof withPageTransition === 'function') {
        withPageTransition(() => hidePage(applyFilter !== false)).then(() => { busy = false; });
      } else {
        hidePage(applyFilter !== false);
        busy = false;
      }
    };

    function goNext() {
      if (busy || !currentCat) return;
      busy = true;
      if (typeof withPageTransition === 'function') {
        withPageTransition(() => hidePage(true)).then(() => { busy = false; });
      } else {
        hidePage(true);
      }
    }

    nextBtn.addEventListener('click', goNext);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && currentCat) {
        if (busy) return;
        busy = true;
        if (typeof withPageTransition === 'function') {
          withPageTransition(() => hidePage(false)).then(() => { busy = false; });
        } else {
          hidePage(false);
        }
      }
    });
  })();

  (function setupOrderDocFocus() {
    const overlay = document.getElementById('orderDocFocus');
    const media = document.getElementById('orderDocFocusMedia');
    const caption = document.getElementById('orderDocFocusCaption');
    const refEl  = document.getElementById('orderDocFocusRef');
    const descEl = document.getElementById('orderDocFocusDesc');
    const arEl   = document.getElementById('orderDocFocusAr');
    if (!overlay || !media || !caption) return;

    // Per-document descriptions sourced from kawakib_descriptions.js
    // (currently only Al-Kawakib is documented). Lookup is by filename.
    const DESCRIPTIONS = (typeof window !== 'undefined' && window.KAWAKIB_DESCRIPTIONS) || {};
    function descForImg(img) {
      if (!img) return null;
      const raw = img.getAttribute('src') || img.src || '';
      if (!raw) return null;
      const path = raw.split(/[?#]/)[0];
      const file = decodeURIComponent(path.split('/').filter(Boolean).pop() || '');
      return DESCRIPTIONS[file] || null;
    }

    const SHRINK_MS = 700;
    const IMAGE_FADE_MS = 520;
    const SHRINK_SCALE = 0.16;
    const SHRINK_OPACITY = 0.5;
    const SHRINK_EASING = 'cubic-bezier(0.4, 0, 0.2, 1)';
    let focusBusy = false;

    function orderedFigures() {
      return [...document.querySelectorAll('#main .sc-gLDymS:not(.is-uncategorized):not(.filter-hidden)')];
    }

    function primeFigures(figs) {
      figs.forEach((fig) => {
        fig.classList.add('order-revealed');
        fig.classList.remove('popping-in');
        fig.style.animation = 'none';
        fig.style.opacity = '1';
        fig.style.transition = 'none';
        fig.style.setProperty('scale', '1', 'important');
        fig.style.transformOrigin = 'center center';
      });
    }

    function clearFigureScaleStyles(figs) {
      figs.forEach((fig) => {
        fig.style.removeProperty('scale');
        fig.style.removeProperty('transition');
        fig.style.removeProperty('animation');
        fig.style.removeProperty('opacity');
        fig.style.removeProperty('transform-origin');
      });
    }

    function shrinkFigures(figs) {
      primeFigures(figs);
      void document.body.offsetWidth;
      figs.forEach((fig) => {
        fig.style.transition = `scale ${SHRINK_MS}ms ${SHRINK_EASING}, opacity ${SHRINK_MS}ms ease`;
      });
      void document.body.offsetWidth;
      requestAnimationFrame(() => {
        figs.forEach((fig) => {
          fig.style.setProperty('scale', String(SHRINK_SCALE), 'important');
          fig.style.setProperty('opacity', String(SHRINK_OPACITY), 'important');
        });
      });
    }

    function growFigures(figs) {
      figs.forEach((fig) => {
        fig.style.transition = `scale ${SHRINK_MS}ms ${SHRINK_EASING}, opacity ${SHRINK_MS}ms ease`;
        fig.style.transformOrigin = 'center center';
      });
      void document.body.offsetWidth;
      requestAnimationFrame(() => {
        figs.forEach((fig) => {
          fig.style.setProperty('scale', '1', 'important');
          fig.style.setProperty('opacity', '1', 'important');
        });
      });
    }

    function resetOrderDocFocus() {
      const figs = orderedFigures();
      body.classList.remove('order-doc-shrinking', 'order-doc-active');
      overlay.classList.remove('is-image-visible');
      overlay.hidden = true;
      overlay.setAttribute('aria-hidden', 'true');
      media.innerHTML = '';
      if (refEl)  refEl.textContent = '';
      if (descEl) descEl.textContent = '';
      if (arEl)   arEl.textContent = '';
      figs.forEach((fig) => fig.classList.add('order-revealed'));
      clearFigureScaleStyles(figs);
      focusBusy = false;
    }
    window.resetOrderDocFocus = resetOrderDocFocus;

    function isFocusOpen() {
      return body.classList.contains('order-doc-active');
    }

    function closeOrderDocFocus() {
      if (!isFocusOpen() || focusBusy) return;
      const figs = orderedFigures();
      focusBusy = true;
      overlay.classList.remove('is-image-visible');
      body.classList.remove('order-doc-active');
      window.setTimeout(() => {
        growFigures(figs);
        window.setTimeout(() => {
          resetOrderDocFocus();
        }, SHRINK_MS + 40);
      }, IMAGE_FADE_MS + 80);
    }

    function openOrderDocFocus(fig) {
      if (focusBusy || !body.classList.contains('mode-image') || !body.classList.contains('ordered')) return;
      const img = fig.querySelector('img');
      if (!img) return;

      focusBusy = true;
      const bigImg = img.cloneNode(true);
      bigImg.removeAttribute('loading');
      // The grid figure shows a 512px thumb — the focus view wants the scan.
      if (window.FULL_SRC) bigImg.src = window.FULL_SRC(bigImg.getAttribute('src') || '');
      bigImg.style.filter = 'none';
      bigImg.style.mixBlendMode = 'normal';
      media.innerHTML = '';
      media.appendChild(bigImg);
      const refLabel = fig.querySelector('figcaption p, figcaption')?.textContent.trim() || '';
      const meta = descForImg(img);
      if (refEl)  refEl.textContent  = refLabel;
      if (descEl) descEl.textContent = (meta && meta.en) ? meta.en : '';
      if (arEl)   arEl.textContent   = (meta && meta.ar) ? meta.ar : '';

      overlay.hidden = false;
      overlay.setAttribute('aria-hidden', 'false');
      overlay.classList.remove('is-image-visible');

      const figs = orderedFigures();
      body.classList.add('order-doc-shrinking');
      shrinkFigures(figs);

      window.setTimeout(() => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            overlay.classList.add('is-image-visible');
            body.classList.add('order-doc-active');
            focusBusy = false;
          });
        });
      }, SHRINK_MS);
    }

    document.getElementById('main').addEventListener('click', (e) => {
      const fig = e.target.closest('.sc-gLDymS');
      if (!fig || isFocusOpen() || focusBusy) return;
      if (!body.classList.contains('mode-image') || !body.classList.contains('ordered')) return;
      if (fig.classList.contains('is-uncategorized') || fig.classList.contains('filter-hidden')) return;
      e.preventDefault();
      openOrderDocFocus(fig);
    });

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay || e.target.classList.contains('order-doc-focus__backdrop')) {
        closeOrderDocFocus();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeOrderDocFocus();
    });
  })();

  // ── Taxonomy filter bar: tag each chapter intro + cases-title banner +
  //    case-study fragment with `data-cat`, then toggle .taxonomy-hidden
  //    when a category button is clicked. INDEX (`data-cat="all"`) clears
  //    the filter. Hide is via display:none for sharp, instant relayout.
  (function setupTaxonomyBar() {
    const bar = document.getElementById('taxonomyBar');
    if (!bar) return;

    const CASE_CATS = {
      'fragment-ch1':   'People',
      'fragment-ch2':   'Desires',
      'fragment-ch3':   'Leisure',
      'fragment-ch4':   'Street',
      'fragment-case-01': 'People',
      'fragment-case-02': 'People',
      'fragment-case-03': 'People',
      'fragment-case-04': 'Desires',
      'fragment-case-05': 'Desires',
      'fragment-case-06': 'Desires',
      'fragment-case-07': 'Desires',
      'fragment-case-08': 'Leisure',
      'fragment-case-09': 'Leisure',
      'fragment-case-10': 'Leisure',
      'fragment-case-11': 'Leisure',
      'fragment-case-12': 'Street',
      'fragment-case-13': 'Street',
      'fragment-case-14': 'Street',
      'fragment-case-15': 'Street',
      'title-cases-people':   'People',
      'title-cases-desires':  'Desires',
      'title-cases-leisure':  'Leisure',
      'title-cases-street':   'Street',
    };
    Object.entries(CASE_CATS).forEach(([id, cat]) => {
      const el = document.getElementById(id);
      if (el) el.dataset.cat = cat;
    });

    const targets = Object.keys(CASE_CATS)
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    function applyFilter(activeCat) {
      const showAll = (activeCat === 'all');
      targets.forEach((el) => {
        if (showAll || el.dataset.cat === activeCat) {
          el.classList.remove('taxonomy-hidden');
        } else {
          el.classList.add('taxonomy-hidden');
        }
      });
    }

    // Tab buttons open/close their panels
    const panelTabs = bar.querySelectorAll('.taxonomy-bar__tab[data-panel]');
    function closeAllPanels() {
      bar.querySelectorAll('.taxonomy-bar__panel.is-open').forEach((p) => p.classList.remove('is-open'));
      panelTabs.forEach((t) => t.classList.remove('is-open'));
    }
    panelTabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.stopPropagation();
        const panelId = tab.dataset.panel === 'cat' ? 'catPanel' : 'magPanel';
        const panel = document.getElementById(panelId);
        if (!panel) return;
        const wasOpen = panel.classList.contains('is-open');
        closeAllPanels();
        if (!wasOpen) {
          panel.classList.add('is-open');
          tab.classList.add('is-open');
        }
      });
    });
    document.addEventListener('click', (e) => {
      if (!bar.contains(e.target)) closeAllPanels();
    }, true);

    /* ── Gallery action bar wiring ── */
    const gabFilter = document.getElementById('gab-filter-btn');
    const gabGrid   = document.getElementById('gab-grid-btn');
    if (gabFilter) {
      // Builds a per-document metadata card matching the canvas hover tooltip:
      // category tab, magazine name, and translation headline.
      const TEXT_FOLDER_LABELS = {
        'Al-Kawakib': 'Al-Kawakib',
        'Al-Mawed': 'Al-Mawed',
        'Al-Rissalah': 'Al-Rissalah',
        'Al-Thqafa': 'Al-Thqafa',
        'Al-alam': 'Al-Alam',
        'Al-ethnayn wa Aldonya': 'Al-Ethnayn wa Aldonya',
        'Al-ethnayn wa aldonya 2': 'Al-Ethnayn wa Aldonya 2',
        'Al-ethnayn wa aldonya 3': 'Al-Ethnayn wa Aldonya 3',
      };

      function buildTextCardData(fig) {
        const img = fig.querySelector('img');
        if (!img) return null;

        const src = img.getAttribute('src') || img.src;
        const srcPath = src.split(/[?#]/)[0];
        const srcParts = srcPath.split('/').filter(Boolean);
        const folder = srcParts.length >= 2 ? decodeURIComponent(srcParts[srcParts.length - 2]) : '';
        const file = srcParts.length >= 1 ? decodeURIComponent(srcParts[srcParts.length - 1]) : '';
        const transKey = folder && file ? folder + '/' + file : '';

        let category = '—';
        let magazine = folder ? (TEXT_FOLDER_LABELS[folder] || folder) : '';
        let headline = '';

        const row = window.findIndexRowByImg ? window.findIndexRowByImg(src) : null;
        if (row) {
          category = ((row.querySelector('.col-medium') || {}).textContent || '—').trim().toUpperCase();
          magazine = ((row.querySelector('.col-section') || {}).textContent || magazine).trim();
        }

        if (transKey && window.TRANSLATIONS && window.TRANSLATIONS[transKey]?.headline) {
          headline = window.TRANSLATIONS[transKey].headline;
        }

        const archiveData = window.ARCHIVE_CATEGORY_DATA;
        if (category === '—' && archiveData && folder && file) {
          const entry = archiveData['library/' + folder + '/|' + file];
          if (entry && entry.primary) category = entry.primary.toUpperCase();
        }

        return { category, magazine, headline, row };
      }

      function ensureTextCard(fig) {
        const existing = fig.querySelector('.doc-text-card');
        if (existing) existing.remove();
        if (!fig.querySelector('img')) return;
        const d = buildTextCardData(fig);
        if (!d) return;
        const catLabel = (d.category && d.category !== '—') ? d.category : '';
        const card = document.createElement('div');
        card.className = 'doc-text-card';
        card.innerHTML =
          (catLabel ? '<div class="doc-text-card__cat">' + catLabel + '</div>' : '') +
          '<div class="doc-text-card__body">' +
            (d.magazine ? '<div class="doc-text-card__mag">' + d.magazine + '</div>' : '') +
            (d.headline ? '<div class="doc-text-card__headline">' + d.headline + '</div>' : '') +
          '</div>';
        card.addEventListener('click', (e) => {
          e.stopPropagation();
          if (d.row && window.openArchiveDoc) window.openArchiveDoc(d.row);
        });
        fig.appendChild(card);
      }

      // Stagger a pop-in for the text cards currently in the viewport (only —
      // off-screen cards just appear, matching the scatter figure pop-in).
      function popInVisibleTextCards() {
        const W = window.innerWidth, H = window.innerHeight;
        const cx = W / 2, cy = H / 2;
        const visible = [];
        document.querySelectorAll('#main .sc-gLDymS').forEach((fig) => {
          const card = fig.querySelector('.doc-text-card');
          if (!card) return;
          const r = fig.getBoundingClientRect();
          if (r.top < H && r.bottom > 0 && r.left < W && r.right > 0) {
            const d = Math.hypot((r.left + r.right) / 2 - cx, (r.top + r.bottom) / 2 - cy);
            visible.push({ card, d });
          }
        });
        visible.sort((a, b) => a.d - b.d);
        // Clear any prior run, then set staggered delays. `both` fill mode holds
        // the 0% (hidden) keyframe during each card's delay so nothing flashes.
        visible.forEach(({ card }, i) => {
          card.classList.remove('text-card-pop');
          card.style.animationDelay = (i * 40) + 'ms';
        });
        void document.body.offsetWidth;
        visible.forEach(({ card }) => card.classList.add('text-card-pop'));
      }

      gabFilter.addEventListener('click', (e) => {
        e.stopPropagation();
        const enteringText = !document.body.classList.contains('canvas-text-mode');
        if (enteringText && window.forceCanvasScatter) {
          window.forceCanvasScatter();
        }
        const isTextMode = document.body.classList.toggle('canvas-text-mode');
        gabFilter.textContent = isTextMode ? '[IMAGE]' : '[TEXT]';
        if (isTextMode) {
          document.querySelectorAll('#main .sc-gLDymS').forEach(ensureTextCard);
          if (window._figTooltip) window._figTooltip.hide();
          requestAnimationFrame(popInVisibleTextCards);
        }
      });
    }

    if (gabGrid) {
      // Deterministic pseudo-random in [0,1) from a seed — same technique
      // used elsewhere in this file for the canvas scatter, so a rebuild of
      // the grid always gives each document the same rotation/jitter.
      function orgRand(seed) {
        const x = Math.sin(seed * 12.9898) * 43758.5453;
        return x - Math.floor(x);
      }

      function buildOrgGrid() {
        const inner = document.getElementById('org-grid-inner');
        if (!inner) return;
        inner.innerHTML = '';
        document.querySelectorAll('#main .sc-gLDymS').forEach((fig, i) => {
          const img = fig.querySelector('img');
          if (!img) return;
          const src = img.getAttribute('src') || img.src;
          const row = window.findIndexRowByImg ? window.findIndexRowByImg(src) : null;

          const card = document.createElement('div');
          card.className = 'org-card';
          card.innerHTML = `<img src="${src}" loading="lazy" alt="" decoding="async">`;
          card.addEventListener('click', () => {
            if (row && window.openArchiveDoc) window.openArchiveDoc(row);
          });

          // Small per-card rotation (-6°..6°) and vertical jitter (-18px..18px)
          const rotation = (orgRand(i * 7.13 + 1) - 0.5) * 12;
          const offsetY = (orgRand(i * 3.71 + 5) - 0.5) * 36;
          card.style.transform = `rotate(${rotation.toFixed(2)}deg) translateY(${offsetY.toFixed(1)}px)`;

          inner.appendChild(card);
        });
        document.getElementById('org-grid-scroll').scrollTop = 0;
      }

      function clearOrgGrid() {
        const inner = document.getElementById('org-grid-inner');
        if (inner) inner.innerHTML = '';
      }

      gabGrid.addEventListener('click', () => {
        const isOrganised = !document.body.classList.contains('canvas-gridorder');
        if (isOrganised && document.body.classList.contains('canvas-text-mode')) return;
        // Ordered grid lives on the canvas itself (not the old scroll overlay):
        if (isOrganised) {
          // Animated transition: the on-screen documents glide AND grow from
          // their scattered spot/size into their ordered grid slot, while the
          // whole canvas zooms out to frame the field. Grid mode also swaps
          // every image to a larger CSS size (260px vs the 170px scatter
          // size) via an instant !important rule keyed off `canvas-gridorder`
          // — so the FIRST (old-state) measurement below MUST happen before
          // that class is added, otherwise "old size" and "new size" would
          // already be identical and the image would still pop instantly.
          const DUR = 850;
          const EASE = 'cubic-bezier(0.22, 1, 0.32, 1)';
          const map = document.getElementById('main');
          const figs = Array.from(document.querySelectorAll('#main .sc-gLDymS'));
          // FIRST — remember position + rendered image size for figures that
          // are both revealed AND actually on screen right now (only these
          // need to animate; anything off-screen can snap silently).
          const W = window.innerWidth, H = window.innerHeight;
          const movers = figs.filter(f => {
            if (!f.classList.contains('order-revealed')) return false;
            const r = f.getBoundingClientRect();
            return r.right > 0 && r.left < W && r.bottom > 0 && r.top < H;
          });
          const firsts = new Map();
          movers.forEach(f => {
            const img = f.querySelector('img');
            firsts.set(f, {
              l: parseFloat(f.style.left) || 0,
              t: parseFloat(f.style.top)  || 0,
              h: img ? img.offsetHeight : 0,
            });
          });
          // NOW toggle the class + label, and lay out the grid (grows the
          // pannable canvas + triggers the CSS rule that swaps every image to
          // the larger grid-mode size).
          document.body.classList.add('canvas-gridorder');
          gabGrid.textContent = 'SCATTER';
          applyImageGridOrder();
          // INVERT — offset + shrink the movers back onto their old rect (no anim).
          movers.forEach(f => {
            const img = f.querySelector('img');
            const nl = parseFloat(f.style.left) || 0, nt = parseFloat(f.style.top) || 0;
            const nh = img ? img.offsetHeight : 0;
            const first = firsts.get(f);
            const scale = (first.h && nh) ? (first.h / nh) : 1;
            f.style.transition = 'none';
            f.style.transformOrigin = '0 0';
            f.style.transform = `translate(${first.l - nl}px, ${first.t - nt}px) scale(${scale})`;
          });
          void map.offsetWidth;   // flush the inverted state before animating
          // PLAY — glide+grow the visible docs into their grid slots while the
          // canvas zooms out via the cheap rAF loop (NOT a CSS transition on #main).
          requestAnimationFrame(() => {
            movers.forEach(f => {
              f.style.transition = `transform ${DUR}ms ${EASE}`;
              f.style.transform = 'translate(0px, 0px) scale(1)';
            });
            if (window.animateCanvasZoomInPlace) window.animateCanvasZoomInPlace(0.562238, DUR);
            else if (window.setCanvasZoomInPlace) window.setCanvasZoomInPlace(0.562238);
          });
          // CLEANUP — drop the temporary figure transitions once settled, and
          // re-assert the final framing as a safety net (guarantees the grid
          // lands at the right zoom even if the animation was interrupted).
          setTimeout(() => {
            movers.forEach(f => { f.style.transition = ''; f.style.transform = ''; f.style.transformOrigin = ''; });
            if (window.setCanvasZoomInPlace) window.setCanvasZoomInPlace(0.562238);
            queueVisibleFigures();
          }, DUR + 100);
        } else {
          document.body.classList.remove('canvas-gridorder');
          gabGrid.textContent = 'Organise';
          if (!restoreScatterFromCache()) applyImageScatter();
          if (window.centerCanvas) window.centerCanvas();
          resetPopInState();
          requestAnimationFrame(() => requestAnimationFrame(triggerPopIn));
        }
      });
    }

    const buttons = bar.querySelectorAll('.taxonomy-bar__btn');
    bar.addEventListener('click', (e) => {
      const btn = e.target.closest('.taxonomy-bar__btn');
      if (!btn) return;

      // Deselect everything first
      buttons.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
      // Close panels after selection
      closeAllPanels();

      if (btn.dataset.mag !== undefined) {
        // ── Magazine filter ──────────────────────────────────────────
        const mag = btn.dataset.mag;
        // Keep category "All" visually active (magazine filter ≠ category filter)
        const catAllBtn = bar.querySelector('.taxonomy-bar__btn[data-cat="all"]');
        if (catAllBtn) { catAllBtn.classList.add('is-active'); catAllBtn.setAttribute('aria-selected', 'true'); }
        // Reset READ-mode fragment filter to all
        applyFilter('all');
        // Apply magazine filter in gallery
        if (typeof window.filterGalleryByMagazine === 'function') {
          window.filterGalleryByMagazine(mag);
        }
        // Close any open category page
        if (typeof window.closeCategoryPage === 'function') {
          window.closeCategoryPage(false);
        }
      } else {
        // ── Category filter ──────────────────────────────────────────
        const cat = btn.dataset.cat;
        // STORY mode: hide chapter/case fragments that don't match.
        applyFilter(cat);
        if (cat === 'all') {
          if (typeof window.closeCategoryPage === 'function') {
            window.closeCategoryPage(false);
          }
          if (typeof window.selectGalleryCategory === 'function') {
            window.selectGalleryCategory('all', true);
          }
        } else if (typeof window.openCategoryPage === 'function') {
          window.openCategoryPage(cat);
        }
      }
    });
  })();

  // ── Intro layer: magazine-style scroll — one paragraph per screen, then canvas.
  (function setupGalleryIntroLayer() {
    const layer = document.getElementById('galleryIntroLayer');
    const slides = layer ? Array.from(layer.querySelectorAll('.gallery-intro-slide')) : [];
    if (!layer || !slides.length) return;
    document.body.classList.add('intro-active');
    const trailLayer = document.createElement('div');
    trailLayer.className = 'intro-cursor-trail';
    trailLayer.setAttribute('aria-hidden', 'true');
    document.body.appendChild(trailLayer);
    const dotCursor = document.createElement('div');
    dotCursor.className = 'intro-dot-cursor';
    dotCursor.setAttribute('aria-hidden', 'true');
    document.body.appendChild(dotCursor);

    let imagePool = [];
    let poolReady = false;
    let lastSpawnX = 0;
    let lastSpawnY = 0;
    let lastSpawnT = 0;
    let lastMoveT = Date.now();
    const MAX_TRAIL = 40;
    const SPAWN_INTERVAL_MS = 85;
    const SPAWN_MIN_DIST = 24;
    const IDLE_DROP_MS = 1200;
    const IDLE_DROP_TICK_MS = 180;
    const TRAIL_FADE_MS = 320;
    let idleDropTimer = null;

    function fadeOutTrailDoc(img) {
      if (!img || !img.parentNode || img.classList.contains('is-fading-out')) return;
      const rot = img.dataset.rot || '0';
      img.classList.remove('is-visible');
      img.classList.add('is-fading-out');
      img.style.transform = 'rotate(' + rot + 'deg) scale(0.72)';
      setTimeout(function() {
        if (img.parentNode) img.remove();
      }, TRAIL_FADE_MS);
    }

    function dropIdleTrailDocs() {
      if (dismissed) return;
      if (Date.now() - lastMoveT < IDLE_DROP_MS) return;
      const oldest = trailLayer.querySelector('.intro-cursor-trail__doc:not(.is-fading-out)');
      if (oldest) fadeOutTrailDoc(oldest);
    }

    idleDropTimer = setInterval(dropIdleTrailDocs, IDLE_DROP_TICK_MS);

    function buildImagePool() {
      if (poolReady) return;
      const seen = new Set();
      document.querySelectorAll('#main .sc-gLDymS img[src]').forEach(function(img) {
        const src = img.getAttribute('src');
        if (src && !seen.has(src)) {
          seen.add(src);
          imagePool.push(src);
        }
      });
      if (!imagePool.length) {
        imagePool = [
          'Al-Mawed/mawed_0112.jpg', 'Al-Mawed/mawed_0167.jpg', 'Al-Kawakib/kawakib_0019.jpg',
          'Al-alam/alam_0055.jpg', 'Al-alam/alam_0062.jpg', 'Al-ethnayn wa aldonya 3/ethnayn3_0100.jpg'
        ];
      }
      poolReady = true;
    }

    function spawnTrailDoc(x, y) {
      if (dismissed || !imagePool.length) return;
      const size = 95 + Math.random() * 105;
      const angle = Math.random() * Math.PI * 2;
      const dist = 35 + Math.random() * 110;
      const rot = (Math.random() - 0.5) * 18;
      const img = document.createElement('img');
      img.className = 'intro-cursor-trail__doc';
      img.src = imagePool[Math.floor(Math.random() * imagePool.length)];
      img.alt = '';
      img.style.width = size + 'px';
      img.style.left = (x + Math.cos(angle) * dist - size * 0.5) + 'px';
      img.style.top = (y + Math.sin(angle) * dist - size * 0.42) + 'px';
      img.style.transform = 'rotate(' + rot + 'deg) scale(0.35)';
      img.dataset.rot = String(rot);
      trailLayer.appendChild(img);
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          img.classList.add('is-visible');
          img.style.transform = 'rotate(' + rot + 'deg) scale(1)';
        });
      });
      while (trailLayer.children.length > MAX_TRAIL) {
        trailLayer.firstChild.remove();
      }
    }

    function onIntroMove(e) {
      dotCursor.style.left = e.clientX + 'px';
      dotCursor.style.top = e.clientY + 'px';
      lastMoveT = Date.now();
      buildImagePool();
      const now = Date.now();
      const dx = e.clientX - lastSpawnX;
      const dy = e.clientY - lastSpawnY;
      if (now - lastSpawnT < SPAWN_INTERVAL_MS && Math.hypot(dx, dy) < SPAWN_MIN_DIST) return;
      lastSpawnX = e.clientX;
      lastSpawnY = e.clientY;
      lastSpawnT = now;
      spawnTrailDoc(e.clientX, e.clientY);
    }
    window.addEventListener('mousemove', onIntroMove);

    let index = 0;
    let animating = false;
    let dismissed = false;
    let touchStartY = null;
    let lastTouchAdvanceT = 0;
    const FADE_OUT_MS = 620;
    const FADE_IN_MS = 1100;

    function goTo(nextIndex) {
      if (animating || dismissed) return Promise.resolve();
      if (nextIndex < 0 || nextIndex >= slides.length || nextIndex === index) return Promise.resolve();
      animating = true;
      const current = slides[index];
      const next = slides[nextIndex];
      current.classList.remove('is-active');
      return new Promise(function(resolve) {
        setTimeout(function() {
          index = nextIndex;
          next.classList.add('is-active');
          setTimeout(function() {
            animating = false;
            resolve();
          }, FADE_IN_MS);
        }, FADE_OUT_MS);
      });
    }

    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      cleanup();
      const overlay = document.getElementById('pageTransition');
      if (overlay) overlay.classList.add('is-intro-exit');

      function enterCanvas() {
        layer.remove();
        document.body.classList.remove('intro-active');
        if (window.redrawDotGrid) window.redrawDotGrid();
        resetPopInState();
        applyImageScatter();
        if (window.centerCanvas) window.centerCanvas();
      }

      if (typeof withPageTransition === 'function') {
        withPageTransition(enterCanvas).then(function() {
          if (overlay) overlay.classList.remove('is-intro-exit');
          if (window.triggerPopIn) window.triggerPopIn();
        });
      } else {
        enterCanvas();
        if (overlay) overlay.classList.remove('is-intro-exit');
        if (window.triggerPopIn) window.triggerPopIn();
      }
    }

    function advanceForward() {
      if (dismissed || animating) return;
      if (index < slides.length - 1) goTo(index + 1);
      else dismiss();
    }

    function onWheel(e) {
      if (dismissed || animating) return;
      e.preventDefault();
      e.stopPropagation();
      if (e.deltaY > 25) {
        advanceForward();
      } else if (e.deltaY < -25 && index > 0) {
        goTo(index - 1);
      }
    }

    function onTouchStart(e) {
      if (dismissed) return;
      touchStartY = e.changedTouches[0].clientY;
    }

    function onTouchEnd(e) {
      if (dismissed || touchStartY == null || animating) return;
      const delta = touchStartY - e.changedTouches[0].clientY;
      touchStartY = null;
      if (Math.abs(delta) < 40) {
        lastTouchAdvanceT = Date.now();
        advanceForward();
        return;
      }
      if (delta > 0) {
        lastTouchAdvanceT = Date.now();
        advanceForward();
      } else if (index > 0) {
        goTo(index - 1);
      }
    }

    function onClick(e) {
      if (dismissed || animating) return;
      if (Date.now() - lastTouchAdvanceT < 500) return;
      e.preventDefault();
      advanceForward();
    }

    function onKeydown(e) {
      if (dismissed || animating) return;
      if (e.key === 'Escape') {
        dismiss();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        advanceForward();
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
        e.preventDefault();
        if (index > 0) goTo(index - 1);
      }
    }

    function cleanup() {
      layer.removeEventListener('wheel', onWheel, { capture: true });
      layer.removeEventListener('click', onClick);
      layer.removeEventListener('touchstart', onTouchStart);
      layer.removeEventListener('touchend', onTouchEnd);
      window.removeEventListener('keydown', onKeydown);
      window.removeEventListener('mousemove', onIntroMove);
      if (idleDropTimer) clearInterval(idleDropTimer);
      dotCursor.remove();
      trailLayer.remove();
    }

    layer.addEventListener('wheel', onWheel, { passive: false, capture: true });
    layer.addEventListener('click', onClick);
    layer.addEventListener('touchstart', onTouchStart, { passive: true });
    layer.addEventListener('touchend', onTouchEnd, { passive: true });
    window.addEventListener('keydown', onKeydown);
  })();

  (function kickInitialPopIn() {
    // After images decode, queue any figures that were not measurable on first boot.
    // Do not reset pop-in state — that causes a visible flicker on refresh.
    function tryQueueMore() {
      if (!body.classList.contains('mode-image') || body.classList.contains('ordered')) return;
      if (!_galleryBootComplete) {
        bootGallery();
        return;
      }
      queueVisibleFigures();
    }
    if (document.readyState === 'complete') {
      setTimeout(tryQueueMore, 80);
    } else {
      window.addEventListener('load', () => setTimeout(tryQueueMore, 80), { once: true });
    }
  })();

</script>


<!-- ═══════════════════════════════════════════════════════════════
     STORY VIEW — Figma canvas + per-image mouse parallax
     Shown as a fixed overlay whenever the STORY tab is active.
═══════════════════════════════════════════════════════════════ -->
<style>
  #story-view {
    display: none;
    position: fixed;
    top: calc(var(--header-h) + 68px);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 600;
    background: #0048f5;
    overflow: hidden;
  }
  body.mode-text-image #story-view { display: block; }

  #story-view .sv-outer {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    background: #0048f5;
  }

  #story-view .sv-canvas {
    position: relative;
    width: 1440px;
    height: 4422px;
    background: #0048f5;
    font-family: 'ABC Monument Grotesk Unlicensed Trial', sans-serif;
  }

  /* ── Horizontal scroll section ── */
  #story-view .sv-h-rail {
    height: 300vh;
    position: relative;
    width: 100%;
  }
  #story-view .sv-h-sticky {
    position: sticky;
    top: 0;
    width: 1440px;
    overflow: hidden;
    /* height & zoom set by JS */
  }
  #story-view .sv-h-inner {
    display: flex;
    width: calc(3 * 1440px);
    height: 100%;
    will-change: transform;
  }
  #story-view .sv-h-panel {
    flex-shrink: 0;
    width: 1440px;
    height: 100%;
    position: relative;
  }

  /* Hero */
  #story-view .t-hero {
    position: absolute;
    left: 24px;
    top: 290px;
    width: auto;
    max-width: calc(100% - 128px);
    margin: 0;
    font-style: normal;
    font-weight: 500;
    font-size: 10rem;
    line-height: 90%;
    color: #F7F7F7;
    text-align: left;
  }
  #story-view .t-intro {
    position: absolute; left: 283px; top: 890px; width: 873px;
    font-weight: 500; font-size: 20px; line-height: normal;
    text-align: center; color: #f7f7f7;
  }

  /* Section labels */
  #story-view .sv-section-label {
    position: absolute; width: 1181px;
    font-style: italic; font-weight: 400; font-size: 78px;
    line-height: 1; text-align: center; color: #f7f7f7;
    left: 50%; transform: translateX(-50%);
  }

  /* Category intro texts */
  #story-view .sv-cat {
    position: absolute;
    font-weight: 400; font-size: 35px; line-height: 1; color: #f7f7f7;
  }

  /* Analysis body texts */
  #story-view .sv-body {
    position: absolute;
    font-weight: 400; font-size: 18px; line-height: normal;
    color: #f7f7f7; width: 467px;
    text-transform: uppercase;
  }

  /* Images — will-change so browser promotes to own layer for smooth parallax */
  #story-view .sv-fig {
    position: absolute;
    overflow: hidden;
    will-change: transform;
    transition: box-shadow 0.35s ease;
  }
  #story-view .sv-fig img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    pointer-events: none; user-select: none;
    opacity: 1 !important;
  }

  /* Closing */
  #story-view .t-closing {
    position: absolute; left: 415px; top: 12789px; width: 617px;
    font-weight: 400; font-size: 14px; line-height: normal;
    text-align: center; color: #f7f7f7;
    text-transform: uppercase;
  }

  /* Face portrait grid */
  #story-view .sv-face-cell {
    position: absolute;
    background: #0048f5;
    border-radius: 3px;
    box-shadow: inset 0 4px 4px rgba(64,0,250,0.25);
  }
  #story-view .sv-face {
    position: absolute;
    overflow: visible;
    pointer-events: none;
    user-select: none;
  }
  #story-view .sv-face img {
    width: 100%; height: 100%; object-fit: contain; display: block;
    pointer-events: none; user-select: none;
    opacity: 1 !important;
  }

  /* Hide category bar in story mode (keep header nav visible) */
  body.mode-text-image .taxonomy-bar { display: none !important; }

  [data-tip] { cursor: default; }
  #story-view .sv-fig { cursor: default; }
</style>

<div id="story-view">
<div class="sv-outer">
<div class="sv-canvas" id="sv-canvas">

  <!-- HERO -->
  <h1 class="t-hero">The<br>subconscious<br>Architecture</h1>
  <p class="t-intro">This page is an active reconstruction of a generation's visual subconscious, anchored in my grandfather's memory. Rather than passive history, it analyzes how mid-century magazines functioned as architects of daily trends and shared dreams, permanently engraving themselves into the identities of those who consumed them.</p>

  <!-- INTRO IMAGE CLUSTER -->
  <div class="sv-fig" data-depth="0.70" style="left:456px;top:1121px;width:211px;height:276px;"><img src="Al-ethnayn wa aldonya 3/ethnayn3_0100.jpeg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="0.50" style="left:1041px;top:1171px;width:172px;height:250px;"><img src="Al-alam/alam_0038.jpg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="1.10" style="left:116px;top:1397px;width:287px;height:208px;"><img src="Al-ethnayn wa aldonya 3/ethnayn3_0111.jpeg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="0.85" style="left:720px;top:1523px;width:235px;height:298px;"><img src="Al-ethnayn wa aldonya 3/ethnayn3_0106.jpeg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="0.60" style="left:1041px;top:1906px;width:205px;height:284px;"><img src="Al-ethnayn wa aldonya 2/ethnayn2_0166.jpeg" alt="" loading="lazy" decoding="async"></div>

  <!-- CATEGORY INTROS -->
  <p class="sv-cat" data-tip="people" style="left:386px;top:1973px;width:591px;">Retouched portraits exposes the industrialized gaze that dictated how my grandfather's generation perceived itself.</p>
  <div class="sv-fig" data-depth="0.65" style="left:83px;top:2190px;width:303px;height:221px;"><img src="Al-Kawakib/kawakib_0022.jpg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="0.65" style="left:682px;top:2255px;width:186px;height:243px;"><img src="Al-ethnayn wa aldonya 3/ethnayn3_0030.jpeg" alt="" loading="lazy" decoding="async"></div>

  <p class="sv-cat" data-tip="desires" style="left:76px;top:2588px;width:534px;">Commercial advertisements maps how mass-produced goods became intimate, urgent longings permanently etched into his mind.</p>
  <div class="sv-fig" data-depth="0.75" style="left:842px;top:2609px;width:357px;height:257px;"><img src="Al-Kawakib/kawakib_0004.jpg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="0.90" style="left:218px;top:2784px;width:227px;height:164px;"><img src="assest/car2.png" alt="" style="object-fit:contain;" loading="lazy" decoding="async"></div>

  <p class="sv-cat" data-tip="leisure" style="left:833px;top:3016px;width:534px;">Print media fragments interrogate how manufactured leisure rituals became curated refuges from everyday political anxieties.</p>
  <div class="sv-fig" data-depth="0.80" style="left:320px;top:3066px;width:290px;height:202px;"><img src="Al-ethnayn wa aldonya 2/ethnayn2_0258.jpeg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="1.20" style="left:788px;top:3239px;width:179px;height:234px;"><img src="Al-ethnayn wa aldonya 3/ethnayn3_0022.jpeg" alt="" loading="lazy" decoding="async"></div>

  <p class="sv-cat" data-tip="street" style="left:365px;top:3556px;width:534px;">Urban fragments capture the volatile stage where editorial illusions collided with the raw reality of his street.</p>
  <div class="sv-fig" data-depth="0.70" style="left:1010px;top:3580px;width:196px;height:318px;"><img src="Al-alam/alam_0117.jpg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="0.85" style="left:128px;top:3775px;width:214px;height:298px;"><img src="Al-ethnayn wa aldonya 2/ethnayn2_0180.jpeg" alt="" loading="lazy" decoding="async"></div>
  <div class="sv-fig" data-depth="0.75" style="left:625px;top:3878px;width:190px;height:262px;"><img src="Al-ethnayn wa aldonya 3/ethnayn3_0062.jpeg" alt="" loading="lazy" decoding="async"></div>

</div><!-- /sv-canvas -->

</div><!-- /sv-outer -->
</div><!-- /story-view -->

<script>
(function () {
  'use strict';

  /* ── 1. CSS zoom: scale 1440px canvas to viewport width ─────── */
  var canvas = document.getElementById('sv-canvas');

  function scaleCanvas() {
    canvas.style.zoom = document.documentElement.clientWidth / 1440;
  }

  window.addEventListener('resize', scaleCanvas);

  new MutationObserver(function () {
    if (document.body.classList.contains('mode-text-image')) scaleCanvas();
  }).observe(document.body, { attributes: true, attributeFilter: ['class'] });

  scaleCanvas();

  /* ── 2. Per-image mouse parallax ────────────────────────────────
     Each .sv-fig carries a data-depth attribute (0.5 = slow, 1.2 = fast).
     Mouse position is normalised to ±0.5. The images receive a small
     translate3d offset, inverse to cursor direction, smoothed with LERP.
     MAX values are in canvas-space px — they scale with zoom automatically.
  ─────────────────────────────────────────────────────────────────── */
  var MAX_X  = 90;    // max horizontal drift in canvas px
  var MAX_Y  = 58;    // max vertical   drift in canvas px
  var EASE   = 0.055; // LERP factor

  var figs = [];      // {el, depth, cx, cy}
  var mouseNX = 0.5;
  var mouseNY = 0.5;
  var rafId   = null;

  function initParallax() {
    var nodes = document.querySelectorAll('#story-view .sv-fig[data-depth]');
    figs = Array.prototype.map.call(nodes, function (el) {
      return { el: el, depth: parseFloat(el.dataset.depth) || 0.7, cx: 0, cy: 0 };
    });
  }

  function lerp(a, b, t) { return a + (b - a) * t; }

  function tick() {
    if (document.body.classList.contains('mode-text-image')) {
      var dx = mouseNX - 0.5;
      var dy = mouseNY - 0.5;
      for (var i = 0; i < figs.length; i++) {
        var f  = figs[i];
        var tx = -dx * MAX_X * f.depth;
        var ty = -dy * MAX_Y * f.depth;
        f.cx = lerp(f.cx, tx, EASE);
        f.cy = lerp(f.cy, ty, EASE);
        f.el.style.transform =
          'translate3d(' + f.cx.toFixed(2) + 'px,' + f.cy.toFixed(2) + 'px,0)';
      }
    }
    rafId = requestAnimationFrame(tick);
  }

  window.addEventListener('mousemove', function (e) {
    mouseNX = e.clientX / window.innerWidth;
    mouseNY = e.clientY / window.innerHeight;
  }, { passive: true });

  /* Build image list and start loop on first STORY activation */
  var ready = false;
  new MutationObserver(function () {
    if (document.body.classList.contains('mode-text-image') && !ready) {
      ready = true;
      initParallax();
      tick();
    }
  }).observe(document.body, { attributes: true, attributeFilter: ['class'] });

})();
</script>

<!-- Story hover tooltip (same .img-tooltip as canvas) -->
<script>
(function () {
  var storyView = document.getElementById('story-view');
  if (!storyView) return;

  var tooltip = document.createElement('div');
  tooltip.className = 'img-tooltip';
  tooltip.innerHTML =
    '<div class="tip-category"></div>' +
    '<div class="tip-body">' +
      '<div class="tip-magazine"></div>' +
      '<div class="tip-translation"></div>' +
    '</div>';
  document.body.appendChild(tooltip);

  var TIPS = {
    people:
      "Architecting People isolates the highly stylized, heavily retouched studio portraits and magazine covers that dominated the era's aesthetics. These were the exact faces my grandfather and his peers looked up to on newsstands, accepting them as the gold standard of modern style and beauty. We look past the individuals to expose the industrialized gaze that dictated how a generation was taught to perceive itself.",
    desires:
      "Behind the perfect faces lay the promises of a better life. Desires merges commercial advertisements with the glossy lifestyle pages of publications like Al-Mawed. These images fully furnished the domestic aspirations of the time—the modern appliance, the sleek car, the celebrity lifestyle. We map how commercial goods became intimate, urgent longings, permanently etched into their minds as the very definition of a successful, modern life.",
    leisure:
      "Modernity did not just organize labor; it strictly manufactured free time. Leisure interrogates the manufactured spaces of escape—the beaches, cinemas, and concert halls. These fragments reveal how print media taught the middle class how to enjoy their modern temporalities. These highly aestheticized rituals of public joy became the brightest shards in their memory, offering a curated refuge from daily routines and political anxieties.",
    street:
      "Finally, the manufactured dream collides with the literal asphalt my grandfather walked upon. Street captures the public sphere—its political friction, workers' labor, and rising modernist architecture. The street was the volatile stage where editorial illusions met raw reality. Here, we see the city through their eyes, tracing the exact moments where grand political ideologies intersected with the quiet struggle of daily life."
  };

  var FOLDER_LABELS = {
    'Al-Kawakib': 'Al-Kawakib',
    'Al-Mawed': 'Al-Mawed',
    'Al-Rissalah': 'Al-Rissalah',
    'Al-Thqafa': 'Al-Thqafa',
    'Al-alam': 'Al-Alam',
    'Al-ethnayn wa Aldonya': 'Al-Ethnayn wa Aldonya',
    'Al-ethnayn wa aldonya 2': 'Al-Ethnayn wa Aldonya 2',
    'Al-ethnayn wa aldonya 3': 'Al-Ethnayn wa Aldonya 3'
  };

  function pathPartsFromSrc(raw) {
    var path = (raw || '').split(/[?#]/)[0];
    var parts = path.split('/').filter(Boolean);
    if (parts.length < 2) return null;
    return {
      folder: decodeURIComponent(parts[parts.length - 2]),
      file: decodeURIComponent(parts[parts.length - 1]),
      src: path
    };
  }

  function dataForFig(fig) {
    var img = fig.querySelector('img');
    if (!img) return null;
    var parts = pathPartsFromSrc(img.getAttribute('src') || img.src);
    if (!parts) return null;

    var category = '—';
    var magazine = FOLDER_LABELS[parts.folder] || parts.folder;
    var translation = '';
    var tKey = parts.folder + '/' + parts.file;

    if (window.findIndexRowByImg) {
      var row = window.findIndexRowByImg(parts.src);
      if (row) {
        category = ((row.querySelector('.col-medium') || {}).textContent || '—').trim().toUpperCase();
        magazine = ((row.querySelector('.col-section') || {}).textContent || magazine).trim();
      }
    }

    if (window.TRANSLATIONS && window.TRANSLATIONS[tKey] && window.TRANSLATIONS[tKey].headline) {
      translation = window.TRANSLATIONS[tKey].headline;
    }

    var archiveData = window.ARCHIVE_CATEGORY_DATA;
    if (category === '—' && archiveData) {
      var entry = archiveData['library/' + parts.folder + '/|' + parts.file];
      if (entry && entry.primary) category = entry.primary.toUpperCase();
    }

    return { category: category, magazine: magazine, translation: translation };
  }

  function dataForTip(el) {
    var key = el.dataset.tip || '';
    return {
      category: key ? key.toUpperCase() : '—',
      magazine: '',
      translation: TIPS[key] || ''
    };
  }

  function positionNearCursor(mx, my) {
    var OFFSET_X = 18;
    var OFFSET_Y = 18;
    var tw = tooltip.offsetWidth;
    var th = tooltip.offsetHeight;
    var x = mx + OFFSET_X;
    var y = my + OFFSET_Y;
    if (x + tw > window.innerWidth - 8) x = mx - tw - OFFSET_X;
    if (y + th > window.innerHeight - 8) y = my - th - OFFSET_Y;
    x = Math.max(8, x);
    y = Math.max(8, y);
    tooltip.style.left = x + 'px';
    tooltip.style.top = y + 'px';
  }

  function showData(data, e) {
    if (!data) { hideTooltip(); return; }
    var catEl = tooltip.querySelector('.tip-category');
    var magEl = tooltip.querySelector('.tip-magazine');
    var trEl = tooltip.querySelector('.tip-translation');
    catEl.textContent = data.category || '—';
    magEl.textContent = data.magazine || '';
    trEl.textContent = data.translation || '';
    catEl.style.display = data.category && data.category !== '—' ? '' : 'none';
    magEl.style.display = data.magazine ? '' : 'none';
    trEl.style.display = data.translation ? '' : 'none';
    tooltip.classList.add('visible');
    positionNearCursor(e.clientX, e.clientY);
  }

  function hideTooltip() {
    tooltip.classList.remove('visible');
  }

  storyView.addEventListener('mouseover', function (e) {
    if (!document.body.classList.contains('mode-text-image')) return;
    var fig = e.target.closest('.sv-fig');
    if (fig) {
      showData(dataForFig(fig), e);
      return;
    }
    var tipEl = e.target.closest('[data-tip]');
    if (tipEl) showData(dataForTip(tipEl), e);
  });

  storyView.addEventListener('mousemove', function (e) {
    if (!tooltip.classList.contains('visible')) return;
    if (!document.body.classList.contains('mode-text-image')) { hideTooltip(); return; }
    positionNearCursor(e.clientX, e.clientY);
  }, { passive: true });

  storyView.addEventListener('mouseout', function (e) {
    var target = e.target.closest('.sv-fig') || e.target.closest('[data-tip]');
    if (!target) return;
    var related = e.relatedTarget;
    if (related && target.contains(related)) return;
    hideTooltip();
  });

  storyView.addEventListener('mouseleave', hideTooltip);

  new MutationObserver(function () {
    if (!document.body.classList.contains('mode-text-image')) hideTooltip();
  }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
})();
</script>

<!-- ── Gallery mouse-parallax (same system as parallax-grid.html) ── -->
<script>
(function () {
  'use strict';

  var MAX_X = 110, MAX_Y = 70, EASE = 0.062;
  var mouseNX = 0.5, mouseNY = 0.5;
  var figs = [];

  function depthFor(idx) {
    var x = Math.sin((idx + 1) * 9.7239) * 43758.5453;
    return 0.40 + (x - Math.floor(x)) * 0.90;
  }

  function lerp(a, b, t) { return a + (b - a) * t; }

  function buildFigs() {
    var nodes = document.querySelectorAll('#main .sc-gLDymS');
    figs = Array.prototype.map.call(nodes, function (el, i) {
      return { el: el, depth: depthFor(i), cx: 0, cy: 0, ready: false };
    });
  }

  var _tickActive = false;
  var _mouseDirty = false;

  function resetParallax() {
    for (var i = 0; i < figs.length; i++) {
      figs[i].cx = 0; figs[i].cy = 0;
      figs[i].el.style.removeProperty('transform');
    }
  }
  window._galleryParallaxReset = resetParallax;

  function tick() {
    _tickActive = false;
    if (!document.body.classList.contains('mode-image')) return;
    if (document.body.classList.contains('ordered')) return;
    // Suspend during pan/drag: the parallax's !important transform would race
    // with the drag/pan transform and cause the visible freeze/flicker.
    if (document.body.classList.contains('is-panning')) return;
    var dx = mouseNX - 0.5;
    var dy = mouseNY - 0.5;
    var needsMore = false;
    // Cull with math from inline left/top + the pan transform: 'order-revealed'
    // only means "was on screen at some point", so after exploring the canvas
    // hundreds of figures stayed in this loop even when far off-screen.
    var view = window._canvasView ? window._canvasView() : null;
    var vw = window.innerWidth, vh = window.innerHeight;
    var PAD = 260 + MAX_X; // figure footprint + max parallax travel
    for (var i = 0; i < figs.length; i++) {
      var f = figs[i];
      if (!f.el.classList.contains('order-revealed')) continue;
      if (view) {
        var fl = parseFloat(f.el.style.left);
        if (!isNaN(fl)) {
          var ft = parseFloat(f.el.style.top) || 0;
          var sx = fl * view.scale + view.x;
          var sy = ft * view.scale + view.y;
          var ext = 560 * view.scale;
          if (sx > vw + PAD || sy > vh + PAD || sx + ext < -PAD || sy + ext < -PAD) continue;
        }
      }
      var tx = -dx * MAX_X * f.depth;
      var ty = -dy * MAX_Y * f.depth;
      f.cx = lerp(f.cx, tx, EASE);
      f.cy = lerp(f.cy, ty, EASE);
      if (Math.abs(f.cx - tx) > 0.05 || Math.abs(f.cy - ty) > 0.05) needsMore = true;

      if (!f.ready) {
        // Wait for the pop-in animation to finish before stomping its transform.
        // Tracked via delegated animationstart/end flags — the old per-frame
        // getAnimations() call allocated arrays for every visible figure on
        // every frame of mouse movement.
        if (f.el.classList.contains('popping-in') && !f.el._popInDone) continue;
        f.ready = true;
      }

      f.el.style.setProperty(
        'transform',
        'translate3d(' + f.cx.toFixed(2) + 'px,' + f.cy.toFixed(2) + 'px,0)',
        'important'
      );
    }
    _mouseDirty = false;
    if (needsMore) {
      _tickActive = true;
      requestAnimationFrame(tick);
    }
  }

  function kickTick() {
    if (!_tickActive) {
      _tickActive = true;
      requestAnimationFrame(tick);
    }
  }

  window.addEventListener('mousemove', function (e) {
    mouseNX = e.clientX / window.innerWidth;
    mouseNY = e.clientY / window.innerHeight;
    _mouseDirty = true;
    kickTick();
  }, { passive: true });

  /* Track pop-in animation state per figure so tick() doesn't have to call
     getAnimations() every frame. Delegated on #main: one pair of listeners
     instead of ~1272. */
  var _parallaxMain = document.getElementById('main');
  if (_parallaxMain) {
    _parallaxMain.addEventListener('animationstart', function (e) {
      if (e.animationName === 'pop-in') e.target._popInDone = false;
    });
    _parallaxMain.addEventListener('animationend', function (e) {
      if (e.animationName === 'pop-in') e.target._popInDone = true;
    });
  }

  /* Hook into _afterPan — buildFigs only needed on mode/scatter changes, not every pan */
  var _prev = window._afterPan;
  window._afterPan = function () {
    if (_prev) _prev();
    kickTick();
  };

  /* Also rebuild on mode switch and on load */
  new MutationObserver(function () {
    if (document.body.classList.contains('mode-image')) setTimeout(buildFigs, 120);
  }).observe(document.body, { attributes: true, attributeFilter: ['class'] });

  window.addEventListener('load', function () { setTimeout(buildFigs, 200); });

  buildFigs();
  tick();
})();
</script>

<!-- ── Category page image parallax ── -->
<script>
(function () {
  'use strict';

  var MAX_X = 55, MAX_Y = 35, EASE = 0.055;
  var mouseNX = 0.5, mouseNY = 0.5;
  var items = [];
  var rafId = null;

  // Fixed depths per scatter position (1=top-left, 2=top-right, 3=left, 4=bottom)
  var DEPTHS = [0.75, 0.38, 0.88, 0.52];

  function lerp(a, b, t) { return a + (b - a) * t; }

  function buildItems() {
    var nodes = document.querySelectorAll('.category-page__img-fig');
    items = Array.prototype.map.call(nodes, function (el, i) {
      return { el: el, depth: DEPTHS[i] !== undefined ? DEPTHS[i] : 0.5, cx: 0, cy: 0 };
    });
  }

  function tick() {
    rafId = null;
    if (!document.body.classList.contains('category-page-open')) return;
    var dx = mouseNX - 0.5;
    var dy = mouseNY - 0.5;
    var needsMore = false;
    for (var i = 0; i < items.length; i++) {
      var f = items[i];
      var tx = -dx * MAX_X * f.depth;
      var ty = -dy * MAX_Y * f.depth;
      f.cx = lerp(f.cx, tx, EASE);
      f.cy = lerp(f.cy, ty, EASE);
      if (Math.abs(f.cx - tx) > 0.05 || Math.abs(f.cy - ty) > 0.05) needsMore = true;
      f.el.style.transform = 'translate3d(' + f.cx.toFixed(2) + 'px,' + f.cy.toFixed(2) + 'px,0)';
    }
    if (needsMore) rafId = requestAnimationFrame(tick);
  }

  function kickTick() {
    if (!rafId) rafId = requestAnimationFrame(tick);
  }

  window.addEventListener('mousemove', function (e) {
    if (!document.body.classList.contains('category-page-open')) return;
    mouseNX = e.clientX / window.innerWidth;
    mouseNY = e.clientY / window.innerHeight;
    kickTick();
  }, { passive: true });

  // Rebuild items whenever category-page-open is toggled on
  new MutationObserver(function () {
    if (document.body.classList.contains('category-page-open')) {
      setTimeout(function () { buildItems(); kickTick(); }, 60);
    }
  }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
})();
</script>

<style>
  #grid-nav { display: none !important; }

  #grid-action-bar {
    display: none;
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1200;
    width: 226px;
    height: 54px;
    flex-direction: row;
    font-family: 'ABC Monument Grotesk Mono Unlicensed Trial', 'IBM Plex Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  body.mode-image.ordered #grid-action-bar { display: flex; }
  #grid-action-bar .gab-filter {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #4000FA;
    color: #FFFDFB;
    cursor: pointer;
    border: none;
    padding: 0;
    font: inherit;
  }
  #grid-action-bar .gab-cloud {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFDFB;
    color: #4000FA;
    cursor: pointer;
    border: 1.5px solid #4000FA;
    border-left: none;
    padding: 0;
    font: inherit;
  }
  #grid-action-bar .gab-filter:hover { background: #2e00c4; }
  #grid-action-bar .gab-cloud:hover { background: #F5F0E8; }
  body.mode-image.ordered .artifact-index-tab { display: none !important; }

  .grid-nav__group {
    display: flex;
    align-items: stretch;
    position: relative;
  }
  .grid-nav__group--modes {
    background: rgba(237, 237, 227, 0.95);
    border: 1px solid rgba(30, 20, 10, 0.15);
    border-right: none;
  }
  .grid-nav__group--filters {
    background: #4000FA;
    border: 1px solid #4000FA;
  }
  .grid-nav__group--index {
    background: #4000FA;
    border: 1px solid #4000FA;
  }
  .grid-nav__btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 10px 22px;
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    border: none;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
  }
  .grid-nav__group--modes .grid-nav__btn { color: rgba(30, 20, 10, 0.6); border-right: 1px solid rgba(30, 20, 10, 0.13); }
  .grid-nav__group--modes .grid-nav__btn:last-child { border-right: none; }
  .grid-nav__group--modes .grid-nav__btn:hover { background: rgba(30,20,10,0.05); color: rgba(30,20,10,0.9); }
  .grid-nav__group--modes .grid-nav__btn.is-active { color: #4000FA; }
  .grid-nav__group--filters .grid-nav__btn { color: #FFFDFB; border-right: 1px solid rgba(255, 253, 251, 0.25); font-size: 13px; transition: font-size 150ms ease, background 150ms ease; }
  .grid-nav__group--filters .grid-nav__btn:last-child { border-right: none; }
  .grid-nav__group--filters .grid-nav__btn:hover { background: rgba(247,247,245,0.10); font-size: 20px; color: #FFFDFB; }
  .grid-nav__group--filters .grid-nav__btn.is-open { background: rgba(247,247,245,0.15); }
  .grid-nav__group--index .grid-nav__btn { color: #F7F7F5; }
  .grid-nav__group--index .grid-nav__btn:hover { background: rgba(0,0,0,0.08); }
  .grid-nav__dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    flex-shrink: 0;
  }
  .grid-nav__btn.is-active .grid-nav__dot { background: currentColor; }

  /* Filter panels that open upward */
  .grid-nav__panel {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 0;
    min-width: 160px;
    background: #4000FA;
    border: 1px solid rgba(255, 253, 251, 0.25);
    border-bottom: none;
    z-index: 10;
  }
  .grid-nav__panel.is-open { display: block; }
  .grid-nav__panel--mag { left: auto; right: 0; }
  .grid-nav__panel ul { list-style: none; margin: 0; padding: 0; }
  .grid-nav__panel li:last-child .grid-nav__filter-btn { border-bottom: none; }
  .grid-nav__filter-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 8px 16px;
    background: none;
    border: none;
    border-bottom: 1px solid rgba(255, 253, 251, 0.20);
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 253, 251, 0.65);
    cursor: pointer;
    text-align: left;
    white-space: nowrap;
  }
  .grid-nav__filter-btn { transition: font-size 150ms ease, color 150ms ease, background 150ms ease; }
  .grid-nav__filter-btn:hover { background: rgba(247,247,245,0.10); color: rgba(255, 253, 251, 0.65); font-size: 13px; }
  .grid-nav__filter-btn.is-active { color: #FFFDFB; }
  .grid-nav__filter-btn.is-active .grid-nav__dot { background: currentColor; }
</style>

<!-- ───────── Grid action bar ───────── -->
<div id="grid-action-bar">
  <button class="gab-filter" id="grid-gab-filter-btn">Filter</button>
  <button class="gab-cloud" id="grid-gab-cloud-btn">#Cloud</button>
</div>

<nav id="grid-nav" aria-label="Grid navigation">
  <div class="grid-nav__group grid-nav__group--filters">
    <button class="grid-nav__btn" id="grid-nav-cat">Category</button>
    <div class="grid-nav__panel" id="grid-panel-cat">
      <ul>
        <li><button class="grid-nav__filter-btn is-active" data-gcat="all"><span class="grid-nav__dot"></span>All</button></li>
        <li><button class="grid-nav__filter-btn" data-gcat="People"><span class="grid-nav__dot"></span>People</button></li>
        <li><button class="grid-nav__filter-btn" data-gcat="Leisure"><span class="grid-nav__dot"></span>Leisure</button></li>
        <li><button class="grid-nav__filter-btn" data-gcat="Desires"><span class="grid-nav__dot"></span>Desires</button></li>
        <li><button class="grid-nav__filter-btn" data-gcat="Street"><span class="grid-nav__dot"></span>Street</button></li>
      </ul>
    </div>
    <button class="grid-nav__btn" id="grid-nav-mag">Magazine</button>
    <div class="grid-nav__panel grid-nav__panel--mag" id="grid-panel-mag">
      <ul>
        <li><button class="grid-nav__filter-btn is-active" data-gmag="all"><span class="grid-nav__dot"></span>All</button></li>
        <li><button class="grid-nav__filter-btn" data-gmag="Al-Ethnayn wa Aldonya"><span class="grid-nav__dot"></span>Al-Ethnayn Wa Aldoyna</button></li>
        <li><button class="grid-nav__filter-btn" data-gmag="Al-Kawakib"><span class="grid-nav__dot"></span>Al-Kawakib</button></li>
        <li><button class="grid-nav__filter-btn" data-gmag="Al-Alam"><span class="grid-nav__dot"></span>Al-Alam</button></li>
        <li><button class="grid-nav__filter-btn" data-gmag="Al-Mawed"><span class="grid-nav__dot"></span>Al-Mwaed</button></li>
      </ul>
    </div>
  </div>
</nav>

<script>
(function () {
  // Filter panels toggle
  const catBtn = document.getElementById('grid-nav-cat');
  const magBtn = document.getElementById('grid-nav-mag');
  const catPanel = document.getElementById('grid-panel-cat');
  const magPanel = document.getElementById('grid-panel-mag');

  function closeAll() {
    catPanel.classList.remove('is-open');
    magPanel.classList.remove('is-open');
    catBtn.classList.remove('is-open');
    magBtn.classList.remove('is-open');
  }

  catBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = catPanel.classList.contains('is-open');
    closeAll();
    if (!open) { catPanel.classList.add('is-open'); catBtn.classList.add('is-open'); }
  });
  magBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = magPanel.classList.contains('is-open');
    closeAll();
    if (!open) { magPanel.classList.add('is-open'); magBtn.classList.add('is-open'); }
  });
  document.addEventListener('click', closeAll);

  /* ── Grid action bar wiring ── */
  const gridGabFilter = document.getElementById('grid-gab-filter-btn');
  const gridGabCloud  = document.getElementById('grid-gab-cloud-btn');
  if (gridGabFilter) {
    gridGabFilter.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = catPanel.classList.contains('is-open');
      closeAll();
      if (!wasOpen) catPanel.classList.add('is-open');
    });
  }
  if (gridGabCloud) {
    gridGabCloud.addEventListener('click', () => {
      document.getElementById('order-btn')?.click();
    });
  }

  // Category filter
  const catBtns = catPanel.querySelectorAll('.grid-nav__filter-btn[data-gcat]');
  catBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      catBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const cat = btn.dataset.gcat;
      if (typeof window.filterGalleryByCategory === 'function') {
        window.filterGalleryByCategory(cat);
      }
      var lp = document.getElementById('grid-split__left');
      if (lp) lp.scrollTo({ top: 0, behavior: 'smooth' });
      else window.scrollTo({ top: 0, behavior: 'smooth' });
      closeAll();
    });
  });

  // Magazine filter
  const magBtns = magPanel.querySelectorAll('.grid-nav__filter-btn[data-gmag]');
  magBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      magBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const mag = btn.dataset.gmag;
      if (typeof window.filterGalleryByMagazine === 'function') window.filterGalleryByMagazine(mag);
      closeAll();
    });
  });
})();
</script>

<!-- Grid hover tooltip -->
<style>
  #grid-fig-tooltip {
    position: fixed;
    z-index: 1200;
    pointer-events: none;
    width: 320px;
    background: #F7F7F5;
    border: 1px solid #4000FA;
    padding: 18px 22px;
    font-family: 'ABC Monument Grotesk Mono Unlicensed Trial', 'IBM Plex Mono', 'Courier New', monospace;
    font-weight: 400;
    font-size: 12px;
    line-height: 1.7;
    color: #4000FA;
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  #grid-fig-tooltip.gft-visible { opacity: 1; }
</style>
<div id="grid-fig-tooltip"></div>
<script>
(function () {
  var FOLDERS = [
    { match: /al-kawakib/i,                  magazine: 'Al-Kawakib',          country: 'Egypt',    volume: '' },
    { match: /al-ethnayn|ethnayn/i,           magazine: 'Al-Ethnayn wa Aldonya', country: 'Egypt',  volume: '' },
    { match: /al-alam|alam/i,                 magazine: 'Al-Alam',             country: 'Morocco',  volume: '139' },
    { match: /al-mawed|mawed/i,               magazine: 'Al-Mawed',            country: 'Lebanon',  volume: '15–99' },
    { match: /al-rissalah|rissalah/i,         magazine: 'Al-Rissalah',         country: 'Egypt',    volume: '' },
    { match: /al-thaqafa|thaqafa/i,           magazine: 'Al-Thaqafa',          country: 'Egypt',    volume: '' }
  ];

  function metaFromSrc(src) {
    var folder = decodeURIComponent(src).split('/').slice(-2, -1)[0] || '';
    for (var i = 0; i < FOLDERS.length; i++) {
      if (FOLDERS[i].match.test(folder)) return FOLDERS[i];
    }
    return null;
  }

  var tip = document.getElementById('grid-fig-tooltip');
  var PAD = 18;
  var curr = null;

  function pos(e) {
    var x = e.clientX + PAD, y = e.clientY + PAD;
    var w = tip.offsetWidth, h = tip.offsetHeight;
    if (x + w > window.innerWidth)  x = e.clientX - w - PAD;
    if (y + h > window.innerHeight) y = e.clientY - h - PAD;
    tip.style.left = x + 'px';
    tip.style.top  = y + 'px';
  }

  document.addEventListener('mouseover', function (e) {
    if (!document.body.classList.contains('ordered')) return;
    var fig = e.target.closest('#main .sc-gLDymS');
    if (fig === curr) return;
    curr = fig;
    if (!fig) { tip.classList.remove('gft-visible'); return; }
    var img = fig.querySelector('img');
    if (!img) { tip.classList.remove('gft-visible'); return; }
    var m = metaFromSrc(img.getAttribute('src') || '');
    if (!m) { tip.classList.remove('gft-visible'); return; }
    tip.textContent = 'This document is from ' + m.magazine + ', made in ' + m.country + (m.volume ? ', vol. ' + m.volume : '') + '.';
    tip.classList.add('gft-visible');
    pos(e);
  }, false);

  document.addEventListener('mousemove', function (e) {
    if (tip.classList.contains('gft-visible')) pos(e);
  }, { passive: true });

  document.addEventListener('mouseout', function (e) {
    if (!e.target.closest('#main .sc-gLDymS')) { curr = null; tip.classList.remove('gft-visible'); }
  });
})();
</script>

<!-- Grid container -->
<div id="grid-split"></div>
<div id="org-grid-overlay">
  <div id="org-grid-scroll"><div class="org-grid" id="org-grid-inner"></div></div>
</div>

<!-- Grid detail overlay -->
<div id="grid-detail-overlay">
  <div id="grid-detail-box">
    <div id="grid-detail-meta-panel">
      <div id="grid-detail-ref"></div>
      <dl id="grid-detail-dl">
        <dt>Publisher</dt><dd id="gd-publisher"></dd>
        <dt>Headline</dt><dd id="gd-headline" class="meta-no-caps"></dd>
        <dt>Year</dt><dd id="gd-year"></dd>
        <dt>Magazine</dt><dd id="gd-magazine"></dd>
        <dt>Country</dt><dd id="gd-country"></dd>
        <dt>Category</dt><dd id="gd-category"></dd>
      </dl>
      <div class="detail-related">
        <div class="detail-related__label">Related Items</div>
        <div class="detail-related__grid" id="gd-related-grid"></div>
      </div>
    </div>
    <div id="grid-detail-img-panel">
      <button id="grid-detail-close">[close]</button>
      <img id="grid-detail-img" src="" alt="" loading="lazy" decoding="async">
    </div>
  </div>
</div>

<script>
(function () {
  var main      = document.getElementById('main');
  var splitEl   = document.getElementById('grid-split');
  var overlay   = document.getElementById('grid-detail-overlay');
  var detailImg = document.getElementById('grid-detail-img');
  var refEl     = document.getElementById('grid-detail-ref');
  var yearEl       = document.getElementById('gd-year');
  var magEl        = document.getElementById('gd-magazine');
  var publisherEl  = document.getElementById('gd-publisher');
  var headlineEl   = document.getElementById('gd-headline');
  var countryEl    = document.getElementById('gd-country');
  var catEl        = document.getElementById('gd-category');
  var relatedGridEl= document.getElementById('gd-related-grid');
  var closeBtn     = document.getElementById('grid-detail-close');

  function populateRelated(currentSrc, folder) {
    if (!relatedGridEl) return;
    relatedGridEl.innerHTML = '';
    var all = Array.from(document.querySelectorAll('#main .sc-gLDymS img'));
    var pool = all.filter(function(img) {
      var p = imgPathParts(img);
      var s = img.getAttribute('src') || img.src;
      return p && p.folder === folder && s !== currentSrc;
    });
    for (var i = pool.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = pool[i]; pool[i] = pool[j]; pool[j] = t;
    }
    pool.slice(0, 4).forEach(function(img) {
      var s = img.getAttribute('src') || img.src;
      var p = imgPathParts(img);
      var meta = p && window.MAGAZINE_META ? window.MAGAZINE_META[p.folder] : null;
      var label = FOLDER_LABELS[p ? p.folder : ''] || (p ? p.folder : '');
      var date  = meta ? (meta.date || '') : '';
      var fig   = img.closest('.sc-gLDymS');
      var tKey  = p ? (p.folder + '/' + p.file) : '';
      var tEntry = tKey && window.TRANSLATIONS ? window.TRANSLATIONS[tKey] : null;
      var headline = tEntry ? tEntry.headline : '';

      var item = document.createElement('div');
      item.className = 'detail-related__item';

      var ri = document.createElement('img');
      ri.src = s; ri.alt = '';
      item.appendChild(ri);

      var metaRow = document.createElement('div');
      metaRow.className = 'detail-related__item-meta';
      var nameSpan = document.createElement('span');
      nameSpan.textContent = label;
      metaRow.appendChild(nameSpan);
      item.appendChild(metaRow);

      if (headline) {
        var headDiv = document.createElement('div');
        headDiv.className = 'detail-related__item-date';
        headDiv.textContent = headline;
        item.appendChild(headDiv);
      }

      var sep = document.createElement('div');
      sep.className = 'detail-related__item-sep';
      item.appendChild(sep);

      item.addEventListener('click', function() {
        if (fig) openDetail(fig);
      });

      relatedGridEl.appendChild(item);
    });
  }

  var FOLDER_LABELS = {
    'Al-Kawakib': 'Al-Kawakib', 'Al-Mawed': 'Al-Mawed',
    'Al-Rissalah': 'Al-Rissalah', 'Al-Thqafa': 'Al-Thaqafa',
    'Al-alam': 'Al-Alam', 'Al-ethnayn wa Aldonya': 'Al-Ethnayn wa Aldonya',
    'Al-ethnayn wa aldonya 2': 'Al-Ethnayn wa Aldonya 2',
    'Al-ethnayn wa aldonya 3': 'Al-Ethnayn wa Aldonya 3',
  };

  function imgPathParts(img) {
    if (!img) return null;
    var raw = img.getAttribute('src') || img.src || '';
    var path = raw.split(/[?#]/)[0];
    var parts = path.split('/').filter(Boolean);
    if (parts.length < 2) return null;
    return { folder: decodeURIComponent(parts[parts.length - 2]), file: decodeURIComponent(parts[parts.length - 1]) };
  }

  function openDetail(fig) {
    var img = fig.querySelector('img');
    if (!img) return;
    var src = img.getAttribute('src') || img.src;
    if (window.findIndexRowByImg && window.openArchiveDoc) {
      var row = window.findIndexRowByImg(src);
      if (row) { window.openArchiveDoc(row); return; }
    }
    detailImg.src = window.FULL_SRC ? window.FULL_SRC(src) : src;

    var parts = imgPathParts(img);
    var magazine = parts ? (FOLDER_LABELS[parts.folder] || parts.folder) : '';
    var cat = '';
    if (parts && window.ARCHIVE_CATEGORY_DATA) {
      var entry = window.ARCHIVE_CATEGORY_DATA['library/' + parts.folder + '/|' + parts.file];
      if (entry && entry.primary) cat = entry.primary;
    }
    var meta = parts && window.MAGAZINE_META ? window.MAGAZINE_META[parts.folder] : null;
    var tKey = parts ? (parts.folder + '/' + parts.file) : '';
    var tEntry = tKey && window.TRANSLATIONS ? window.TRANSLATIONS[tKey] : null;
    refEl.textContent = tEntry ? tEntry.headline : '';
    publisherEl.textContent = (meta && meta.publisher) ? meta.publisher : '—';
    headlineEl.textContent = tEntry ? tEntry.headline : '—';
    yearEl.textContent    = (meta && meta.date)        ? meta.date        : '—';
    magEl.textContent     = magazine;
    countryEl.textContent = (meta && meta.country)     ? meta.country     : '—';
    catEl.textContent     = cat || '—';
    populateRelated(src, parts ? parts.folder : '');
    overlay.classList.add('open');
  }

  function closeDetail() {
    overlay.classList.remove('open');
    detailImg.src = '';
  }

  closeBtn.addEventListener('click', closeDetail);
  /* no backdrop click — full-screen layout has no empty backdrop area */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeDetail();
  });

  // Click on grid figure to open detail
  document.addEventListener('click', function(e) {
    if (!document.body.classList.contains('ordered')) return;
    var fig = e.target.closest('#grid-split .sc-gLDymS');
    if (fig) { e.stopPropagation(); openDetail(fig); }
  });

  function enterSplit() {
    splitEl.appendChild(main);
    splitEl.style.display = 'block';
  }

  function exitSplit() {
    closeDetail();
    document.body.appendChild(main);
    splitEl.style.display = 'none';
  }

  var wasOrdered = false;
  new MutationObserver(function () {
    var isOrdered    = document.body.classList.contains('ordered');
    var isCanvasGrid = document.body.classList.contains('canvas-grid-only');
    if (isOrdered && !wasOrdered && !isCanvasGrid) { enterSplit(); wasOrdered = true; }
    if (!isOrdered && wasOrdered) { exitSplit(); wasOrdered = false; }
  }).observe(document.body, { attributes: true, attributeFilter: ['class'] });

  var origFilter = window.filterGalleryByCategory;
  window.filterGalleryByCategory = function(cat) {
    if (origFilter) origFilter(cat);
    splitEl.scrollTop = 0;
  };
})();
</script>

<!-- ══════════════ PREVIEW PAGE (full-bleed index) ══════════════ -->
<style>


  /* ── Filter page ── */
  /* Vertical sidebar pinned beneath the Canvas nav button (the left 25% column,
     matching the 4-up nav grid). Groups stack top-to-bottom. */
  #filter-page {
    position: fixed;
    top: calc(var(--header-h) + 68px);
    left: 0;
    width: 25vw;
    bottom: 0;
    z-index: 1600;
    background: #0048f5;
    border-right: 2px solid #0048f5;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-24px);
    transition: opacity 520ms ease, transform 720ms cubic-bezier(0.22, 1, 0.32, 1), visibility 0s linear 720ms;
    font-family: 'ABC Monument Grotesk Mono Unlicensed Trial', 'IBM Plex Mono', monospace;
    box-sizing: border-box;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
    container-name: filter-sidebar;
  }
  #filter-page .adx-close-btn {
    bottom: 3.3rem;
    color: #f7f7f7;
  }
  #filter-page.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
    transition: opacity 520ms ease, transform 720ms cubic-bezier(0.22, 1, 0.32, 1), visibility 0s;
  }

  /* Staggered pop-in for each option row when the panel opens. */
  @keyframes fpRowIn {
    from { opacity: 0; transform: translateX(-14px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  #filter-page.is-open .fp-group-head {
    animation: fpRowIn 680ms cubic-bezier(0.22, 1, 0.32, 1) both;
  }
  #filter-page.is-open .fp-tag {
    animation: fpRowIn 720ms cubic-bezier(0.22, 1, 0.32, 1) both;
  }
  /* Cascade the rows top-to-bottom. Group heads lead each block, options follow. */
  #filter-page.is-open .fp-group:nth-child(1) .fp-group-head { animation-delay: 140ms; }
  #filter-page.is-open .fp-group:nth-child(2) .fp-group-head { animation-delay: 460ms; }
  #filter-page.is-open .fp-group:nth-child(3) .fp-group-head { animation-delay: 780ms; }
  #filter-page.is-open .fp-group:nth-child(1) .fp-tag:nth-child(1) { animation-delay: 200ms; }
  #filter-page.is-open .fp-group:nth-child(1) .fp-tag:nth-child(2) { animation-delay: 260ms; }
  #filter-page.is-open .fp-group:nth-child(1) .fp-tag:nth-child(3) { animation-delay: 320ms; }
  #filter-page.is-open .fp-group:nth-child(1) .fp-tag:nth-child(4) { animation-delay: 380ms; }
  #filter-page.is-open .fp-group:nth-child(1) .fp-tag:nth-child(5) { animation-delay: 440ms; }
  #filter-page.is-open .fp-group:nth-child(2) .fp-tag:nth-child(1) { animation-delay: 520ms; }
  #filter-page.is-open .fp-group:nth-child(2) .fp-tag:nth-child(2) { animation-delay: 580ms; }
  #filter-page.is-open .fp-group:nth-child(2) .fp-tag:nth-child(3) { animation-delay: 640ms; }
  #filter-page.is-open .fp-group:nth-child(2) .fp-tag:nth-child(4) { animation-delay: 700ms; }
  #filter-page.is-open .fp-group:nth-child(2) .fp-tag:nth-child(5) { animation-delay: 760ms; }
  #filter-page.is-open .fp-group:nth-child(2) .fp-tag:nth-child(6) { animation-delay: 820ms; }
  #filter-page.is-open .fp-group:nth-child(2) .fp-tag:nth-child(7) { animation-delay: 880ms; }
  #filter-page.is-open .fp-group:nth-child(3) .fp-tag:nth-child(1) { animation-delay: 840ms; }
  #filter-page.is-open .fp-group:nth-child(3) .fp-tag:nth-child(2) { animation-delay: 900ms; }
  #filter-page.is-open .fp-group:nth-child(3) .fp-tag:nth-child(3) { animation-delay: 960ms; }
  #filter-page.is-open .fp-group:nth-child(3) .fp-tag:nth-child(4) { animation-delay: 1020ms; }
  #filter-page.is-open .fp-group:nth-child(3) .fp-tag:nth-child(5) { animation-delay: 1080ms; }

  @media (prefers-reduced-motion: reduce) {
    #filter-page,
    #filter-page.is-open { transition: opacity 160ms ease, visibility 0s; transform: none; }
    #filter-page.is-open .fp-group-head,
    #filter-page.is-open .fp-tag { animation: none; }
  }
  #filter-close-bar { display: none; }
  #filter-category-head-row {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.65rem;
    min-height: 4.1rem;
    margin: 0;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }
  #filter-body {
    display: block;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 1.5rem 1rem;
  }
  #filter-label { display: none; }
  /* Groups stack vertically, separated by thin light dividers. */
  #filter-groups {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .fp-group {
    padding: 1.1rem 0;
    border-top: none;
    min-width: 0;
  }
  .fp-group:first-child { border-top: none; padding-top: 0; }
  .fp-group:last-child { padding-bottom: 0; }
  .fp-group-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    margin-bottom: 0.6rem;
  }
  .fp-group-head {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 247, 247, 0.75);
    margin-bottom: 0;
  }
  .fp-tags {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  /* Each option: a toggle-box icon + an uppercase label. The filled square
     inside the outlined box sits on the LEFT when unselected and slides to the
     RIGHT when the option is active (a switch metaphor). */
  .fp-tag {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    padding: 0.15rem 0;
    background: transparent;
    border: none;
    font-family: 'ABC Monument Grotesk Unlicensed Trial', sans-serif;
    font-weight: 800;
    /* Scale with sidebar width (cqi), not viewport — keeps proportions
       consistent from 13" MacBook to 27" monitor. */
    font-size: clamp(0.9rem, 8.5cqi, 2.75rem);
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #f7f7f7;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 110ms ease;
  }
  .fp-tag::before {
    content: '';
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 1.28em;
    height: 0.62em;
    border: 0.056em solid #f7f7f7;
    background-color: transparent;
    background-image: linear-gradient(#f7f7f7, #f7f7f7);
    background-repeat: no-repeat;
    background-origin: border-box;
    background-size: 0.39em 0.39em;
    background-position: 0.13em center;
    transition: background-position 380ms cubic-bezier(0.65, 0, 0.35, 1), background-color 380ms ease, background-image 380ms ease;
  }
  .fp-tag:hover { opacity: 0.7; }
  .fp-tag.is-active {
    background: transparent;
    color: #f7f7f7;
  }
  .fp-tag.is-active::before {
    background-color: #f7f7f7;
    background-image: linear-gradient(#0048f5, #0048f5);
    background-position: calc(100% - 0.13em) center;
  }
  /* Facet count: how many documents match this option given the other
     currently-active filters. Sits flush-right, scales with the label. */
  .fp-count {
    margin-left: auto;
    padding-left: 0.6em;
    font-size: 0.42em;
    font-weight: 700;
    line-height: 1;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
  .fp-tag.fp-empty { opacity: 0.4; }

  @media (max-width: 720px) {
    #filter-page { width: min(80vw, 340px); }
  }

  #preview-page {
    position: fixed;
    top: calc(var(--header-h) + 68px);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1500;
    background: #F7F7F5;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 400ms ease, visibility 0s linear 400ms;
    overflow: hidden;
    font-family: 'ABC Monument Grotesk Mono Unlicensed Trial', 'IBM Plex Mono', monospace;
  }
  #preview-page.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 400ms ease, visibility 0s;
  }

  /* Hover preview: above row highlight, below value text. */
  #pv-preview-img {
    position: fixed;
    width: auto;
    height: auto;
    z-index: 2;
    pointer-events: none;
    display: none;
    opacity: 0.9;
    transition: left 520ms cubic-bezier(0.22, 1, 0.32, 1),
                top 520ms cubic-bezier(0.22, 1, 0.32, 1),
                transform 520ms cubic-bezier(0.22, 1, 0.32, 1),
                max-width 520ms cubic-bezier(0.22, 1, 0.32, 1),
                opacity 320ms ease;
  }
  body:has(#preview-page.is-open):not(:has(#filter-page.is-open)) #pv-preview-img {
    top: 50%;
    left: calc(50% - 16rem);
    transform: translate(-50%, -50%) scale(0.85);
    max-width: min(540px, 34vw);
    max-height: min(680px, 68vh);
  }
  /* Filter open: between About and Index nav columns. */
  body:has(#filter-page.is-open) #pv-preview-img {
    top: 50%;
    left: calc(62.5% + 3.5rem);
    transform: translate(-50%, -50%);
    max-width: 420px;
    max-height: 520px;
  }
  @media (max-width: 720px) {
    body:has(#filter-page.is-open) #pv-preview-img {
      left: calc(62.5% + 3.5rem);
    }
    body:has(#preview-page.is-open):not(:has(#filter-page.is-open)) #pv-preview-img {
      max-width: min(420px, 52vw);
      max-height: min(560px, 62vh);
    }
  }
  #pv-meta {
    position: absolute;
    top: calc(var(--header-h) + 1rem);
    left: 2rem;
    max-width: 380px;
    color: #4000FA;
    z-index: 1;
    pointer-events: none;
    font-family: 'ABC Monument Grotesk Mono Unlicensed Trial', 'IBM Plex Mono', monospace;
    font-weight: 400;
  }
  #pv-meta h3 {
    font-family: inherit;
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.9rem;
    color: #4000FA;
  }
  #pv-meta dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.15rem 1.25rem;
    margin: 0;
    font-size: 0.77rem;
    line-height: 1.25;
  }
  #pv-meta dt {
    font-weight: 400;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(64,0,250,0.65);
    align-self: start;
    padding-top: 0.2rem;
  }
  #pv-meta dd { margin: 0; font-weight: 400; text-transform: uppercase; }
  #pv-meta dd:empty, #pv-meta dd:empty + dt { display: none; }

  /* Split view when a row is clicked */
  #preview-page.is-split #pv-table-shell { display: none; }

  /* Index table shell: fixed header + scrollable rows */
  #pv-table-shell {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: left 520ms cubic-bezier(0.22, 1, 0.32, 1);
    will-change: left;
  }
  body:has(#filter-page.is-open) #pv-table-shell {
    left: 0;
  }
  @media (max-width: 720px) {
    body:has(#filter-page.is-open) #pv-table-shell {
      left: 0;
    }
  }
  #pv-table-head {
    flex: 0 0 auto;
  }

  /* Scrollable table rows */
  #pv-table-wrap {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    font-size: 1.18rem;
    font-weight: 500;
    color: #0048f5;
    overflow-y: auto;
  }
  #pv-info-panel {
    display: none;
    position: absolute;
    top: calc(var(--header-h) + 48px); left: 0; bottom: 0;
    width: 25%;
    background: #FFFDFB;
    color: #1c1a16;
    padding: 2.5rem 2rem;
    flex-direction: column;
    gap: 1.4rem;
    overflow-y: auto;
    font-family: 'ABC Monument Grotesk Mono Unlicensed Trial', 'IBM Plex Mono', monospace;
    z-index: 2;
  }
  #preview-page.is-split #pv-info-panel { display: flex; }
  #pv-info-ref {
    font-size: 2.6rem;
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(28,26,22,0.12);
  }
  #pv-info-dl { display: flex; flex-direction: column; }
  #pv-info-dl dt {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.45;
    font-weight: 400;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(28,26,22,0.12);
    margin-top: 1.1rem;
  }
  #pv-info-dl dd {
    font-size: 1rem;
    font-weight: 400;
    text-transform: uppercase;
    margin: 0.4rem 0 0;
    letter-spacing: 0.04em;
  }
  #pv-split-panel {
    display: none;
    position: absolute;
    top: calc(var(--header-h) + 48px); left: 25%; right: 0; bottom: 0;
    width: auto;
    align-items: center;
    justify-content: center;
    border-left: 1px solid #4000FA;
    background: #F7F7F5;
  }
  #preview-page.is-split #pv-split-panel { display: flex; }
  #pv-split-panel img {
    max-width: 90%; max-height: 85vh;
    object-fit: contain; display: block;
  }
  #pv-split-close {
    position: absolute; top: 1rem; right: 1.5rem;
    background: none; border: none; cursor: pointer;
    font-family: 'ABC Monument Grotesk Mono Unlicensed Trial', 'IBM Plex Mono', monospace;
    font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: #4000FA;
  }

  .pv-row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    gap: 0;
    padding: 0.5rem 0;
    border-top: 1px solid rgba(0, 72, 245, 0.22);
    cursor: pointer;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background 120ms ease, color 120ms ease;
    font-weight: 500;
  }
  /* When a filter is applied, the rows that survive re-play the same
     fade-and-slide-in-from-left entrance the filter-page tags use (fpRowIn),
     cascaded one-by-one via an inline animation-delay set in JS. */
  .pv-row.pv-filter-in {
    animation: fpRowIn 560ms cubic-bezier(0.22, 1, 0.32, 1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .pv-row.pv-filter-in { animation: none; }
  }
  .pv-row > div {
    position: relative;
    z-index: 3;
  }
  .pv-row .col-ref {
    grid-column: 1;
    padding-left: 1.25rem;
  }
  .pv-row .col-medium {
    grid-column: 2;
    padding-left: 1.25rem;
  }
  .pv-row .col-section {
    grid-column: 3;
    padding-left: 1.25rem;
  }
  /* Filter open: keep full-width grid — filter overlays col 1; align to nav. */
  body:has(#filter-page.is-open) .pv-row .col-ref {
    grid-column: 2;
  }
  body:has(#filter-page.is-open) .pv-row .col-medium {
    grid-column: 3;
  }
  body:has(#filter-page.is-open) .pv-row .col-section {
    grid-column: 4;
  }
  .pv-row:not(.pv-row-head).is-active {
    background: transparent;
    color: #f5f5f5;
  }
  .pv-row:not(.pv-row-head).is-active::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #0048f5;
    z-index: 0;
    pointer-events: none;
  }
  .pv-row-head {
    cursor: default;
    border-top: none;
    border-bottom: 2px solid #e2e0f5;
    min-height: 4.1rem;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 17px;
    font-weight: 700;
    color: #0048f5;
    background: #e2e0f5;
    position: relative;
    z-index: 4;
    align-items: center;
  }
  .pv-row-head:hover { background: #e2e0f5; }
  .pv-row-head > div {
    cursor: pointer;
    user-select: none;
  }
  .pv-row-head .sort-arrow {
    display: inline-block;
    margin-left: 0.3em;
    font-size: 0.95em;
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .pv-row-head .sort-arrow.active { opacity: 1; }
  #pv-table-head + #pv-table-wrap .pv-row:first-child { border-top: none; }
</style>

<div id="preview-page">
  <div id="pv-meta" style="display:none">
    <h3 id="pv-meta-name"></h3>
    <dl>
      <dt>Publisher</dt><dd id="pv-meta-publisher"></dd>
      <dt>Country</dt><dd id="pv-meta-country"></dd>
      <dt>Language</dt><dd id="pv-meta-lang"></dd>
    </dl>
  </div>
  <div id="pv-info-panel">
    <div id="pv-info-ref"></div>
    <dl id="pv-info-dl">
      <dt>Publisher</dt><dd id="pv-info-publisher"></dd>
      <dt>Headline</dt><dd id="pv-info-headline" class="meta-no-caps"></dd>
      <dt>Year</dt><dd id="pv-info-year"></dd>
      <dt>Magazine</dt><dd id="pv-info-mag"></dd>
      <dt>Country</dt><dd id="pv-info-country"></dd>
      <dt>Category</dt><dd id="pv-info-cat"></dd>
    </dl>
    <div class="detail-related">
      <div class="detail-related__label">Related Items</div>
      <div class="detail-related__grid" id="pv-related-grid"></div>
    </div>
  </div>
  <div id="pv-split-panel">
    <button id="pv-split-close">[close]</button>
    <img id="pv-split-img" src="" alt="" loading="lazy" decoding="async">
  </div>
  <div id="pv-table-shell">
    <div id="pv-table-head" class="pv-row pv-row-head">
      <div class="col-ref" data-pv-sort="reference">REFERENCE <span class="sort-arrow active">&uarr;</span></div>
      <div class="col-medium" data-pv-sort="category">CATEGORY <span class="sort-arrow">&uarr;</span></div>
      <div class="col-section" data-pv-sort="magazine">MAGAZINE <span class="sort-arrow">&uarr;</span></div>
    </div>
    <div id="pv-table-wrap">
      <!-- rows injected by JS -->
      <img id="pv-preview-img" alt="" loading="lazy" decoding="async">
    </div>
  </div>
</div>


<script>
(function () {
  var page     = document.getElementById('preview-page');
  var tableWrap= document.getElementById('pv-table-wrap');
  var pvImg    = document.getElementById('pv-preview-img');

  var infoRefEl      = document.getElementById('pv-info-ref');
  var infoPublisherEl = document.getElementById('pv-info-publisher');
  var infoHeadlineEl = document.getElementById('pv-info-headline');
  var infoYearEl     = document.getElementById('pv-info-year');
  var infoMagEl      = document.getElementById('pv-info-mag');
  var infoCountryEl  = document.getElementById('pv-info-country');
  var infoCatEl      = document.getElementById('pv-info-cat');
  var pvRelatedGrid  = document.getElementById('pv-related-grid');

  function syncPvPreviewAnchor() {
    var fp = document.getElementById('filter-page');
    if (!page.classList.contains('is-open') || (fp && fp.classList.contains('is-open'))) {
      page.style.removeProperty('--pv-preview-top');
      page.style.removeProperty('--pv-preview-left');
      return;
    }
    var filterBtn = document.querySelector('#canvas-subnav .csn-item--filter');
    if (!filterBtn) return;
    var rect = filterBtn.getBoundingClientRect();
    var pageRect = page.getBoundingClientRect();
    var zoneTop = rect.bottom - pageRect.top;
    var centerY = zoneTop + (pageRect.height - zoneTop) / 2;
    page.style.setProperty('--pv-preview-top', centerY + 'px');
    page.style.setProperty('--pv-preview-left', (rect.left + rect.width / 2 - pageRect.left) + 'px');
  }
  window.syncPvPreviewAnchor = syncPvPreviewAnchor;
  window.addEventListener('resize', syncPvPreviewAnchor);

  function pvFolderFromSrc(src) {
    var path = (src || '').split(/[?#]/)[0];
    var parts = path.split('/').filter(Boolean);
    return parts.length >= 2 ? decodeURIComponent(parts[parts.length - 2]) : '';
  }

  function pvPopulateRelated(currentSrc, folder) {
    if (!pvRelatedGrid) return;
    pvRelatedGrid.innerHTML = '';
    var all = Array.from(document.querySelectorAll('#main .sc-gLDymS img'));
    var pool = all.filter(function(img) {
      var s = img.getAttribute('src') || img.src;
      return pvFolderFromSrc(s) === folder && s !== currentSrc;
    });
    for (var i = pool.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = pool[i]; pool[i] = pool[j]; pool[j] = t;
    }
    pool.slice(0, 4).forEach(function(img) {
      var s = img.getAttribute('src') || img.src;
      var fld = pvFolderFromSrc(s);
      var filename = s.split('/').pop();
      var tKey = fld && filename ? (fld + '/' + filename) : '';
      var tEntry = tKey && window.TRANSLATIONS ? window.TRANSLATIONS[tKey] : null;
      var headline = tEntry ? tEntry.headline : '';

      var item = document.createElement('div');
      item.className = 'detail-related__item';

      var ri = document.createElement('img');
      ri.src = s; ri.alt = '';
      item.appendChild(ri);

      var metaRow = document.createElement('div');
      metaRow.className = 'detail-related__item-meta';
      var nameSpan = document.createElement('span');
      nameSpan.textContent = fld || '';
      metaRow.appendChild(nameSpan);
      item.appendChild(metaRow);

      if (headline) {
        var headDiv = document.createElement('div');
        headDiv.className = 'detail-related__item-date';
        headDiv.textContent = headline;
        item.appendChild(headDiv);
      }

      var sep = document.createElement('div');
      sep.className = 'detail-related__item-sep';
      item.appendChild(sep);

      pvRelatedGrid.appendChild(item);
    });
  }

  function showInfoPanel(row) {
    var folder = row.getAttribute('data-folder') || '';
    var imgSrc = row.getAttribute('data-img') || '';
    var filename = imgSrc.split('/').pop();
    var tKey = folder && filename ? (folder + '/' + filename) : '';
    var tEntry = tKey && window.TRANSLATIONS ? window.TRANSLATIONS[tKey] : null;
    infoRefEl.textContent = tEntry ? tEntry.headline : '';
    infoPublisherEl.textContent = (meta && meta.publisher) ? meta.publisher : '—';
    infoHeadlineEl.textContent = tEntry ? tEntry.headline : '—';
    var meta = folder && window.MAGAZINE_META ? window.MAGAZINE_META[folder] : null;
    infoYearEl.textContent    = (meta && meta.date)        ? meta.date        : '—';
    infoMagEl.textContent     = (row.querySelector('.col-section') || {}).textContent || '—';
    infoCountryEl.textContent = (meta && meta.country)     ? meta.country     : '—';
    infoCatEl.textContent     = (row.querySelector('.col-medium') || {}).textContent || '—';
    pvPopulateRelated(imgSrc, folder);
  }

  function populateFromIndex() {
    tableWrap.querySelectorAll('.pv-row').forEach(function(row) { row.remove(); });

    var srcRows = document.querySelectorAll('#index-panel .index-row:not(.index-head)');
    var frag = document.createDocumentFragment();
    srcRows.forEach(function(row) {
      var clone = row.cloneNode(true);
      clone.className = 'pv-row';
      clone.addEventListener('click', function() {
        if (window.openArchiveDoc) window.openArchiveDoc(row);
      });
      frag.appendChild(clone);
    });
    tableWrap.insertBefore(frag, pvImg);
    sortPvByReference();
    pvUpdateSortArrow('reference');
  }

  var pvRows = [];
  function refreshPvRows() {
    pvRows = Array.prototype.slice.call(
      tableWrap.querySelectorAll('.pv-row:not(.pv-row-head)')
    ).filter(function(row) {
      return row.style.display !== 'none';
    });
  }
  window.refreshPvRows = refreshPvRows;

  function pvRowText(row, selector) {
    return ((row.querySelector(selector) || {}).textContent || '').trim().toLowerCase();
  }
  function pvRefNum(row) {
    var stored = row.getAttribute('data-ref-num');
    if (stored) {
      var parsed = parseInt(stored, 10);
      if (isFinite(parsed)) return parsed;
    }
    var t = ((row.querySelector('.col-ref') || {}).textContent || '').trim();
    var m = t.match(/\[([^\]]+)\]/);
    var label = (m ? m[1] : t).trim();
    if (/^\d+$/.test(label)) return parseInt(label, 10);
    var lead = label.match(/^(\d+)/);
    if (lead) return parseInt(lead[1], 10);
    var digits = label.match(/\d+/);
    return digits ? parseInt(digits[0], 10) : Number.MAX_SAFE_INTEGER;
  }
  function pvCompareRef(a, b) {
    var diff = pvRefNum(a) - pvRefNum(b);
    if (diff !== 0) return diff;
    return pvRowText(a, '.col-ref').localeCompare(pvRowText(b, '.col-ref'));
  }
  function sortPvTable(compareFn) {
    var rows = Array.prototype.slice.call(
      tableWrap.querySelectorAll('.pv-row:not(.pv-row-head)')
    );
    rows.sort(compareFn);
    rows.forEach(function(row) { tableWrap.appendChild(row); });
    refreshPvRows();
  }
  function sortPvByReference() {
    sortPvTable(pvCompareRef);
  }
  function sortPvByCategory() {
    sortPvTable(function(a, b) {
      var cat = pvRowText(a, '.col-medium').localeCompare(pvRowText(b, '.col-medium'));
      if (cat !== 0) return cat;
      var mag = pvRowText(a, '.col-section').localeCompare(pvRowText(b, '.col-section'));
      if (mag !== 0) return mag;
      return pvCompareRef(a, b);
    });
  }
  function sortPvByMagazine() {
    sortPvTable(function(a, b) {
      var mag = pvRowText(a, '.col-section').localeCompare(pvRowText(b, '.col-section'));
      if (mag !== 0) return mag;
      var cat = pvRowText(a, '.col-medium').localeCompare(pvRowText(b, '.col-medium'));
      if (cat !== 0) return cat;
      return pvCompareRef(a, b);
    });
  }

  var pvTableHead = document.getElementById('pv-table-head');
  var pvSortFns = {
    reference: sortPvByReference,
    category: sortPvByCategory,
    magazine: sortPvByMagazine,
  };
  function pvUpdateSortArrow(activeKey) {
    if (!pvTableHead) return;
    pvTableHead.querySelectorAll('[data-pv-sort]').forEach(function(cell) {
      var arrow = cell.querySelector('.sort-arrow');
      if (arrow) {
        arrow.classList.toggle('active', cell.getAttribute('data-pv-sort') === activeKey);
      }
    });
  }
  if (pvTableHead) {
    pvTableHead.querySelectorAll('[data-pv-sort]').forEach(function(cell) {
      cell.addEventListener('click', function() {
        var key = cell.getAttribute('data-pv-sort');
        if (pvSortFns[key]) pvSortFns[key]();
        pvUpdateSortArrow(key);
      });
    });
  }

  function open() {
    populateFromIndex();
    tableWrap.scrollTop = 0;
    document.body.style.overflow = 'hidden';
    page.classList.add('is-open');
    // Cascade the rows in on first entry — same fade-and-slide-from-left the
    // filter uses. Called synchronously: populateFromIndex has already put the
    // rows in the DOM and the cascade forces its own reflow to (re)start.
    if (typeof window.animateIndexRowsCascade === 'function') window.animateIndexRowsCascade();
    requestAnimationFrame(function() {
      syncPvPreviewAnchor();
      requestAnimationFrame(syncPvPreviewAnchor);
    });
    if (typeof window.syncFilterCategoryAlign === 'function') {
      requestAnimationFrame(window.syncFilterCategoryAlign);
    }
  }
  function close() {
    document.body.style.overflow = '';
    page.classList.remove('is-open');
    page.classList.remove('is-split');
    document.getElementById('pv-split-img').src = '';
    if (typeof window.syncFilterCategoryAlign === 'function') window.syncFilterCategoryAlign();
  }

  window.closePreview = close;

  /* Live row highlight + preview while scrolling: browsers don't fire mouse
     events when content scrolls under a stationary cursor, so we track the
     last pointer position and resolve the row under it on every scroll tick. */
  var pvActiveRow = null;
  var pvLastX = null, pvLastY = null, pvScrollRaf = null;

  function setActiveRow(row) {
    if (pvActiveRow === row) return;
    if (pvActiveRow) pvActiveRow.classList.remove('is-active');
    pvActiveRow = (row && !row.classList.contains('pv-row-head')) ? row : null;
    if (pvActiveRow) pvActiveRow.classList.add('is-active');
  }

  function findRowAtPointer(x, y) {
    var wrapRect = tableWrap.getBoundingClientRect();
    if (x < wrapRect.left || x > wrapRect.right || y < wrapRect.top || y > wrapRect.bottom) {
      return null;
    }

    var el = document.elementFromPoint(x, y);
    if (el) {
      var hit = el.closest ? el.closest('.pv-row') : null;
      if (hit && !hit.classList.contains('pv-row-head') && tableWrap.contains(hit) && hit.style.display !== 'none') {
        return hit;
      }
    }

    if (!pvRows.length) return null;

    var lo = 0, hi = pvRows.length - 1, found = null;
    while (lo <= hi) {
      var mid = (lo + hi) >> 1;
      var rect = pvRows[mid].getBoundingClientRect();
      if (!rect.height) { lo = mid + 1; continue; }
      if (y < rect.top) hi = mid - 1;
      else if (y >= rect.bottom) lo = mid + 1;
      else { found = pvRows[mid]; break; }
    }
    return found;
  }

  function updateUnderPointer(x, y) {
    var row = findRowAtPointer(x, y);
    if (!row) {
      setActiveRow(null);
      pvImg.style.display = 'none';
      return;
    }
    setActiveRow(row);
    var img = row.getAttribute('data-img');
    if (img) {
      if (pvImg.style.display !== 'block' || pvImg.getAttribute('src') !== img) {
        pvImg.src = img;
        pvImg.style.display = 'block';
      }
    } else {
      pvImg.style.display = 'none';
    }
  }

  function requestPointerUpdate() {
    if (pvLastX == null || pvScrollRaf) return;
    pvScrollRaf = requestAnimationFrame(function() {
      pvScrollRaf = null;
      updateUnderPointer(pvLastX, pvLastY);
    });
  }

  tableWrap.addEventListener('mousemove', function(e) {
    pvLastX = e.clientX; pvLastY = e.clientY;
    updateUnderPointer(pvLastX, pvLastY);
  });
  tableWrap.addEventListener('mouseleave', function() {
    pvLastX = null; pvLastY = null;
    if (pvScrollRaf) cancelAnimationFrame(pvScrollRaf);
    pvScrollRaf = null;
    setActiveRow(null);
    pvImg.style.display = 'none';
  });
  tableWrap.addEventListener('scroll', function() {
    if (pvLastX == null) return;
    updateUnderPointer(pvLastX, pvLastY);
    requestPointerUpdate();
  }, { passive: true });

  document.getElementById('pv-split-close').addEventListener('click', function() {
    page.classList.remove('is-split');
    document.getElementById('pv-split-img').src = '';
    infoRefEl.textContent = '';
    infoYearEl.textContent = '';
    infoMagEl.textContent = '';
    infoCountryEl.textContent = '';
    infoCatEl.textContent = '';
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (page.classList.contains('is-split')) { page.classList.remove('is-split'); return; }
      if (page.classList.contains('is-open')) close();
    }
  });

  /* Add PREVIEW button to the header nav */
  document.addEventListener('DOMContentLoaded', function() {
    var nav = document.querySelector('.mode-tabs');
    if (!nav) return;
    var btn = document.createElement('button');
    btn.textContent = 'PREVIEW';
    btn.addEventListener('click', open);
    nav.appendChild(btn);
  });

  window.openPreview = open;
})();
</script>

<script>
(function () {
  var cnNav    = document.getElementById('canvas-nav');
  var subnav   = document.getElementById('canvas-subnav');
  if (!cnNav || !subnav) return;

  var SUB_ITEMS = {
    canvas:   ['Filter'],
    archive:  ['Al-Kawakib', 'Al-Mawed', 'Al-Rissalah', 'Al-Thaqafa', 'Al-Alam', 'Al-Ethnayn'],
    index:    ['Filter'],
    network:  [],
    festival: [],
    about:    ['Project', 'Magazine'],
  };

  function closeArchiveDocIfOpen() {
    if (typeof window.closeArchiveDoc === 'function') window.closeArchiveDoc({ instant: true });
  }

  function runPageTransition(callback) {
    if (typeof window.withPageTransition === 'function') {
      return window.withPageTransition(callback);
    }
    if (callback) callback();
    return Promise.resolve();
  }

  function closePreviewPage() {
    var pp = document.getElementById('preview-page');
    if (!pp) return;
    document.body.style.overflow = '';
    pp.classList.remove('is-open');
    pp.classList.remove('is-split');
    var splitImg = document.getElementById('pv-split-img');
    if (splitImg) splitImg.src = '';
    if (typeof window.syncFilterCategoryAlign === 'function') window.syncFilterCategoryAlign();
  }

  function isAboutPageOpen() {
    var el = document.getElementById('about-page');
    return el ? el.classList.contains('is-open') : false;
  }

  function getAboutView() {
    var el = document.getElementById('about-page');
    return el ? (el.getAttribute('data-about-view') || 'project') : 'project';
  }

  function setAboutView(view) {
    var el = document.getElementById('about-page');
    if (!el) return;
    el.setAttribute('data-about-view', view);
    el.scrollTop = 0;
    if (view === 'magazine' && typeof window.resetAboutMagazineSlides === 'function') {
      window.resetAboutMagazineSlides();
    }
    showAboutSubnav();
  }

  function showAboutSubnav() {
    subnav.innerHTML = '';
    cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
    var aboutItem = cnNav.querySelector('.cn-item[data-cn-sub="about"]');
    if (aboutItem) aboutItem.classList.add('cn-active-sub');

    var currentView = getAboutView();
    ['project', 'magazine'].forEach(function(view) {
      var el = document.createElement('span');
      el.className = 'csn-item csn-item--filter' + (currentView === view ? ' csn-active' : '');
      el.textContent = '[' + view + ']';
      el.addEventListener('click', function(e) {
        e.stopPropagation();
        var aboutPage = document.getElementById('about-page');
        if (aboutPage && !aboutPage.classList.contains('is-open')) {
          aboutPage.classList.add('is-open');
          aboutPage.setAttribute('aria-hidden', 'false');
          if (aboutItem) aboutItem.classList.add('cn-active-sub');
        }
        setAboutView(view);
      });
      subnav.appendChild(el);
    });

    if (aboutItem) {
      var rect = aboutItem.getBoundingClientRect();
      subnav.style.left = rect.left + 'px';
      subnav.style.width = rect.width + 'px';
      subnav.style.removeProperty('right');
    }
    subnav.classList.add('is-open');
  }

  function isCanvasMode() {
    return document.body.classList.contains('mode-image');
  }

  function isIndexPageOpen() {
    var pp = document.getElementById('preview-page');
    return pp ? pp.classList.contains('is-open') : false;
  }

  function buildSubItems(sub, onClickItem) {
    var items = SUB_ITEMS[sub] || [];
    items.forEach(function(label) {
      var el = document.createElement('span');
      el.className = 'csn-item csn-item--' + label.toLowerCase();
      el.textContent = label;
      el.addEventListener('click', function() { onClickItem(label); });
      subnav.appendChild(el);
    });
  }

  function showCanvasSubnav() {
    subnav.innerHTML = '';
    cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
    var canvasItem = cnNav.querySelector('.cn-item[data-cn-sub="canvas"]');
    if (canvasItem) canvasItem.classList.add('cn-active-sub');
    // Hide the subcategory row while the vertical filter sidebar is open.
    var fpEl = document.getElementById('filter-page');
    if (fpEl && fpEl.classList.contains('is-open')) { subnav.classList.remove('is-open'); return; }
    buildSubItems('canvas', function(label) {
      if (label === 'Filter') { if (typeof window.toggleFilter === 'function') window.toggleFilter(); }
      else if (label === 'Grid') { var g = document.getElementById('gab-grid-btn'); if (g) g.click(); }
    });
    if (canvasItem) {
      var rect = canvasItem.getBoundingClientRect();
      subnav.style.left = rect.left + 'px';
      subnav.style.width = rect.width + 'px';
      subnav.style.removeProperty('right');
    }
    subnav.classList.add('is-open');
  }

  function hasActiveFilter() {
    var fp = document.getElementById('filter-page');
    if (!fp) return false;
    return ['cat', 'mag', 'year'].some(function(dim) {
      var attr = 'data-fp-' + dim;
      var active = fp.querySelectorAll('.fp-tag[' + attr + '].is-active');
      for (var i = 0; i < active.length; i++) {
        if (active[i].getAttribute(attr) !== 'all') return true;
      }
      return false;
    });
  }

  function showIndexSubnav() {
    subnav.innerHTML = '';
    cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
    var indexItem = cnNav.querySelector('.cn-item[data-cn-sub="index"]');
    if (indexItem) indexItem.classList.add('cn-active-sub');
    var fp = document.getElementById('filter-page');
    var filterOpen = fp && fp.classList.contains('is-open');

    // While the vertical filter sidebar is open it visually replaces the
    // subcategory row, so hide the subnav entirely until the filter closes.
    if (filterOpen) { subnav.classList.remove('is-open'); return; }

    var el = document.createElement('span');
    el.className = 'csn-item csn-item--filter' + (filterOpen ? ' csn-active' : '');
    el.textContent = filterOpen ? 'Close' : 'Filter';
    el.addEventListener('click', function() {
      if (typeof window.toggleFilter === 'function') window.toggleFilter();
      showIndexSubnav();
    });
    subnav.appendChild(el);

    if (hasActiveFilter()) {
      var resetEl = document.createElement('span');
      resetEl.className = 'csn-item';
      resetEl.textContent = 'Reset';
      resetEl.addEventListener('click', function() {
        var resetBtn = document.getElementById('filter-reset-btn');
        if (resetBtn) resetBtn.click();
        showIndexSubnav();
      });
      subnav.appendChild(resetEl);
    }

    if (indexItem) {
      var rect = indexItem.getBoundingClientRect();
      subnav.style.left = rect.left + 'px';
      subnav.style.width = rect.width + 'px';
      subnav.style.removeProperty('right');
    }
    subnav.classList.add('is-open');
    if (typeof window.syncPvPreviewAnchor === 'function') {
      requestAnimationFrame(window.syncPvPreviewAnchor);
    }
  }

  function closeSubnav() {
    if (isAboutPageOpen()) { showAboutSubnav(); return; }
    if (isIndexPageOpen()) { showIndexSubnav(); return; }
    if (isCanvasMode()) { showCanvasSubnav(); return; }
    subnav.classList.remove('is-open');
    subnav.innerHTML = '';
    cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
  }

  var _wasCanvas = false;
  function syncActive() {
    var isCanvas = document.body.classList.contains('mode-image');
    var isRead   = document.body.classList.contains('mode-text-image');
    cnNav.querySelectorAll('.cn-item[data-cn-action]').forEach(function(item) {
      var a = item.dataset.cnAction;
      item.classList.toggle('cn-active', (a === 'canvas' && isCanvas) || (a === 'read' && isRead));
    });
    // Canvas / Read modes each need a solid selected state on their nav button.
    // Index and About manage their own via overlay openers. Skip while those
    // overlays are open so we don't steal their highlight.
    var aboutEl = document.getElementById('about-page');
    var aboutOpen = aboutEl && aboutEl.classList.contains('is-open');
    if (isCanvas && !isIndexPageOpen() && !aboutOpen) {
      cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
      var canvasItem = cnNav.querySelector('.cn-item[data-cn-sub="canvas"]');
      if (canvasItem) canvasItem.classList.add('cn-active-sub');
    } else if (isRead && !isIndexPageOpen() && !aboutOpen) {
      cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
      var readItem = cnNav.querySelector('.cn-item[data-cn-action="read"]');
      if (readItem) readItem.classList.add('cn-active-sub');
    }
    if (isCanvas && !_wasCanvas && !isIndexPageOpen() && !isAboutPageOpen()) showCanvasSubnav();
    _wasCanvas = isCanvas;
  }

  function closeAboutPage() {
    var el = document.getElementById('about-page');
    if (!el || !el.classList.contains('is-open')) return;
    el.classList.remove('is-open');
    el.setAttribute('aria-hidden', 'true');
    el.setAttribute('data-about-view', 'project');
    var tab = cnNav.querySelector('.cn-item[data-cn-sub="about"]');
    if (tab) tab.classList.remove('cn-active-sub');
    subnav.classList.remove('is-open');
    subnav.innerHTML = '';
    // Restore the Canvas GRID/FILTER subnav row when returning to canvas mode.
    if (isCanvasMode()) showCanvasSubnav();
  }
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeAboutPage(); });

  cnNav.querySelectorAll('.cn-item').forEach(function(item) {
    item.addEventListener('click', function() {
      var action = item.dataset.cnAction;
      var sub    = item.dataset.cnSub;

      if (sub === 'about') {
        var aboutPage = document.getElementById('about-page');
        if (!aboutPage) return;
        var willOpen = !aboutPage.classList.contains('is-open');
        runPageTransition(function() {
          closeArchiveDocIfOpen();
          closePreviewPage();
          cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
          aboutPage.classList.toggle('is-open', willOpen);
          aboutPage.setAttribute('aria-hidden', willOpen ? 'false' : 'true');
          item.classList.toggle('cn-active-sub', willOpen);
          if (willOpen) {
            if (!aboutPage.getAttribute('data-about-view')) {
              aboutPage.setAttribute('data-about-view', 'project');
            }
            aboutPage.scrollTop = 0;
            showAboutSubnav();
          } else {
            aboutPage.setAttribute('data-about-view', 'project');
            subnav.classList.remove('is-open');
            subnav.innerHTML = '';
            if (isCanvasMode()) showCanvasSubnav();
          }
        }).then(function() {
          if (willOpen && isAboutPageOpen()) showAboutSubnav();
        });
        return;
      }

      if (sub === 'index') {
        if (item.classList.contains('cn-active-sub')) {
          closeSubnav();
          return;
        }
        if (isIndexPageOpen()) {
          showIndexSubnav();
          return;
        }
        runPageTransition(function() {
          closeArchiveDocIfOpen();
          closeAboutPage();
          if (typeof window.openPreview === 'function') window.openPreview();
        });
        return;
      }

      // The About overlay sits above everything except the top nav bar
      // itself — any other nav click should dismiss it first.
      if (sub !== 'about') closeAboutPage();

      if (action === 'canvas') {
        closeArchiveDocIfOpen();
        closePreviewPage();
        var btn = document.querySelector('.mode-tabs button[data-mode="image"]');
        if (btn) btn.click();
        closeSubnav(); return;
      }
      if (action === 'read') {
        closeArchiveDocIfOpen();
        closePreviewPage();
        var btn = document.querySelector('.mode-tabs button[data-mode="text-image"]');
        if (btn) btn.click();
        closeSubnav(); return;
      }

      if (sub) {
        if (sub === 'canvas') {
          closeArchiveDocIfOpen();
          if (isIndexPageOpen()) {
            runPageTransition(function() {
              closeArchiveDocIfOpen();
              closePreviewPage();
              closeAboutPage();
              var canvasBtn = document.querySelector('.mode-tabs button[data-mode="image"]');
              if (canvasBtn && !document.body.classList.contains('mode-image')) canvasBtn.click();
              else showCanvasSubnav();
            });
          } else if (isCanvasMode()) {
            showCanvasSubnav();
          } else {
            closePreviewPage();
            var canvasBtn = document.querySelector('.mode-tabs button[data-mode="image"]');
            if (canvasBtn) canvasBtn.click();
            showCanvasSubnav();
          }
          return;
        }
        if (item.classList.contains('cn-active-sub') && sub !== 'canvas') {
          closeSubnav(); return;
        }
        subnav.innerHTML = '';
        cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
        var subItems = SUB_ITEMS[sub] || [];
        if (!subItems.length) return;
        item.classList.add('cn-active-sub');
        buildSubItems(sub, function(label) {
          if (label === 'Filter') {
            if (typeof window.toggleFilter === 'function') window.toggleFilter();
          } else if (label === 'Grid') {
            var gridBtn = document.getElementById('gab-grid-btn');
            if (gridBtn) gridBtn.click();
          }
          closeSubnav();
        });
        var rect = item.getBoundingClientRect();
        subnav.style.left = rect.left + 'px';
        subnav.style.width = rect.width + 'px';
        subnav.style.removeProperty('right');
        subnav.classList.add('is-open');
      }
    });
  });

  // Swap subnav when index page opens or closes
  var ppEl = document.getElementById('preview-page');
  if (ppEl) {
    new MutationObserver(function() {
      if (ppEl.classList.contains('is-open')) {
        showIndexSubnav();
      } else if (isAboutPageOpen()) {
        showAboutSubnav();
      } else if (isCanvasMode()) {
        showCanvasSubnav();
      } else {
        subnav.classList.remove('is-open');
        subnav.innerHTML = '';
        cnNav.querySelectorAll('.cn-item').forEach(function(i) { i.classList.remove('cn-active-sub'); });
      }
    }).observe(ppEl, { attributes: true, attributeFilter: ['class'] });
  }

  var aboutElObs = document.getElementById('about-page');
  if (aboutElObs) {
    new MutationObserver(function() {
      if (aboutElObs.classList.contains('is-open')) showAboutSubnav();
    }).observe(aboutElObs, { attributes: true, attributeFilter: ['class'] });
  }

  // Rebuild index subnav whenever filter panel opens or closes
  var fpEl = document.getElementById('filter-page');
  if (fpEl) {
    new MutationObserver(function() {
      if (isIndexPageOpen()) showIndexSubnav();
    }).observe(fpEl, { attributes: true, attributeFilter: ['class'] });
  }

  // Sync active state when mode changes
  var modeObs = new MutationObserver(syncActive);
  modeObs.observe(document.body, { attributes: true, attributeFilter: ['class'] });
  syncActive();

  // Close subnav on outside click
  document.addEventListener('click', function(e) {
    if (cnNav.contains(e.target) || subnav.contains(e.target)) return;
    // While the About overlay is open, an outside click shouldn't reset the
    // nav — keep About highlighted instead of falling back to Canvas.
    var aboutEl = document.getElementById('about-page');
    if (aboutEl && aboutEl.classList.contains('is-open')) return;
    closeSubnav();
  });

  window.addEventListener('resize', function() {
    if (isAboutPageOpen()) showAboutSubnav();
  });

  window.refreshAboutSubnav = function() {
    if (isAboutPageOpen()) showAboutSubnav();
  };
  window.refreshIndexSubnav = function() {
    if (isIndexPageOpen()) showIndexSubnav();
  };
  window.refreshFilterSubnav = function() {
    if (isIndexPageOpen()) showIndexSubnav();
    else if (isCanvasMode()) showCanvasSubnav();
  };
})();
</script>

<script>
(function () {
  var aboutPage = document.getElementById('about-page');
  var layer = document.getElementById('aboutMagazineLayer');
  var track = document.getElementById('aboutMagazineTrack');
  var titleEl = document.getElementById('aboutMagazineTitle');
  if (!aboutPage || !layer || !track) return;

  var MAGAZINE_CATALOG = [
    {
      name: 'Al-Mawed',
      folders: ['Al-Mawed'],
      fallback: [
        'Al-Mawed/mawed_0112.jpg', 'Al-Mawed/mawed_0090.jpg', 'Al-Mawed/mawed_0153.jpg',
        'Al-Mawed/mawed_0167.jpg', 'Al-Mawed/mawed_0242.jpg', 'Al-Mawed/mawed_0055.jpg'
      ],
      slides: [
        'Al-Mawed is one of the most prestigious Lebanese art and cultural magazines, founded by journalist Mohamed Badie Serbeyeh in Beirut in 1953. Over the decades, it became the guardian of the archive of the Golden Age of Arabic art.',
        'The magazine accompanied the cinema and music industries of the mid-20th century, distinguished by its exclusive field coverage of behind-the-scenes artistic life and celebrity society in Egypt and Lebanon.',
        'It also dedicated extensive space to fashion, culture, and the visual patterns that shaped the social and aesthetic consciousness of that era, making its historical issues an essential visual and documentary reference for the culture of print media in the Arab world.',
        'The Architecture of Stardom: The magazine did not merely report news; it actively participated in shaping and manufacturing stardom through in-depth interviews and fixed columns that revealed the personal and human dimensions of artists, establishing a direct and close relationship between the public and cultural icons.',
        'Editorial Network and Distribution: The magazine possessed a strong network of correspondents, particularly in Cairo as the capital of Arab cinema. This granted it access to exclusive snapshots and color photographs directly from filming locations, driving high distribution rates across various Arab capitals.',
        'Design and Visual Consciousness: Al-Mawed was characterized by a distinct visual identity that relied on highlighting photography as a primary element on covers and internal pages, alongside a typographic layout that reflected the prevailing aesthetic trends of mid-20th-century print publications.',
        'Specialized Sections: Its pages featured famous segments covering art criticism, social analysis, and permanent columns dedicated to women\u2019s and family affairs, culinary arts, and serialized literary stories published sequentially across consecutive issues.'
      ]
    },
    {
      name: 'Al-Kawakib',
      folders: ['Al-Kawakib'],
      fallback: [
        'Al-Kawakib/kawakib_0019.jpg', 'Al-Kawakib/kawakib_0022.jpg', 'Al-Kawakib/kawakib_0004.jpg',
        'Al-Kawakib/kawakib_0011.jpg', 'Al-Kawakib/kawakib_0012.jpg', 'Al-Kawakib/kawakib_0016.jpg'
      ],
      slides: [
        'Al-Kawakib was one of Egypt\u2019s defining cinema weeklies, published by Dar Al-Hilal. From the early 1960s it mapped the visual world of Arab film \u2014 stars, studios, premieres, and the spectacle of modern celebrity.',
        'The magazine codified the geometry of stardom: cover portraits, studio lighting, and the close-up as the unit through which a generation learned to see itself on screen and in print.',
        'Its pages mixed glamour with commentary \u2014 fashion, leisure, advertising, and the social rituals that circulated around cinema culture across Cairo and the wider Arab world.'
      ]
    },
    {
      name: 'Al-Rissalah',
      folders: ['Al-Rissalah'],
      fallback: [
        'Al-Rissalah/\u0627\u0644\u0631\u0633\u0627\u0644\u0629_1.JPG',
        'Al-Rissalah/\u0627\u0644\u0631\u0633\u0627\u0644\u0629_2.JPG',
        'Al-Rissalah/\u0627\u0644\u0631\u0633\u0627\u0644\u0629_3.JPG',
        'Al-Rissalah/\u0627\u0644\u0631\u0633\u0627\u0644\u0629_4.JPG'
      ],
      slides: [
        'Al-Rissalah was among the most influential literary and cultural reviews in mid-century Egypt, founded in 1942 under the editorship of Ahmed Hassan Al-Zayyat. It shaped the intellectual conversation of its era.',
        'The magazine published criticism, serialized literature, and essays that mediated between classical Arabic culture and the accelerating modernity of the 1940s and beyond.',
        'Preserved in the archive, its issues document how print culture carried authority \u2014 how a weekly could instruct taste, debate politics, and model the educated reader\u2019s relationship to art and society.'
      ]
    },
    {
      name: 'Al-Thqafa',
      folders: ['Al-Thqafa'],
      fallback: [
        'Al-Thqafa/CamScanner 18-05-2026 13.33_1.JPG',
        'Al-Thqafa/CamScanner 18-05-2026 13.33_2.JPG',
        'Al-Thqafa/CamScanner 18-05-2026 13.33_3.JPG',
        'Al-Thqafa/CamScanner 18-05-2026 13.33_4.JPG'
      ],
      slides: [
        'Al-Thqafa addressed itself to the formation of modern cultural consciousness in Egypt, edited by Ahmad Ameen and published from 1939. It positioned the magazine as an instrument of enlightenment.',
        'Its editorial program advanced literature, science, history, and moral philosophy \u2014 treating culture not as leisure but as the deliberate cultivation of a civic mind.',
        'Within the domestic library, these volumes trace how intellectual periodicals competed with cinema weeklies and society magazines for the reader\u2019s interior life.'
      ]
    },
    {
      name: 'Al-Alam',
      folders: ['Al-alam'],
      fallback: [
        'Al-alam/alam_0055.jpg', 'Al-alam/alam_0062.jpg', 'Al-alam/alam_0017.jpg',
        'Al-alam/alam_0020.jpg', 'Al-alam/alam_0107.jpg', 'Al-alam/alam_0064.jpg'
      ],
      slides: [
        'Al-Alam offered Egyptian readers a window onto the world \u2014 global news, geopolitics, and the framing of events beyond the Arab region. Published by Al-Hilal in 1957, it catalogued the entry of international currents into everyday consciousness.',
        'Its pages translated distance into narrative: foreign capitals, diplomatic crises, and the visual vocabulary of a planet shrinking under Cold War attention.',
        'In the archive, Al-Alam marks the vector of external information \u2014 how a generation encountered the world as image, headline, and interpreted event.'
      ]
    },
    {
      name: 'Al-Ethnayn wa Aldonya',
      folders: ['Al-ethnayn wa Aldonya', 'Al-ethnayn wa aldonya 2', 'Al-ethnayn wa aldonya 3'],
      fallback: [
        'Al-ethnayn wa aldonya 3/ethnayn3_0100.jpg', 'Al-ethnayn wa aldonya 3/ethnayn3_0106.jpg',
        'Al-ethnayn wa aldonya 3/ethnayn3_0111.jpg', 'Al-ethnayn wa aldonya 2/ethnayn2_0100.jpg'
      ],
      slides: [
        'Al-Ethnayn wa Aldonya \u2014 Monday and the World \u2014 was Dar Al-Hilal\u2019s celebrated weekly of political satire, social commentary, and changing behavioral norms. Edited by Emil Zeidan from 1956, it read the pulse of Egyptian society with wit and sharp observation.',
        'The magazine mapped public life through caricature, reportage, and essays that tested the boundaries between tradition and modernization.',
        'Its preserved issues document the humor and critique through which readers negotiated daily life \u2014 leisure, politics, gender roles, and the contradictions of a society in rapid transformation.'
      ]
    }
  ];

  var slides = [];
  var floats = Array.from(document.querySelectorAll('.about-magazine-float'));
  var magazineIndex = 0;
  var index = 0;
  var animating = false;
  var animToken = 0;
  var animFallbackTimer = null;
  var touchStartY = null;
  var imagePoolCache = {};

  var FLOAT_W = 240;
  var FLOAT_H_EST = 300;
  var MAGAZINE_OPEN_DELAY_MS = 1000;

  var FOLDER_LABELS = {
    'Al-Kawakib': 'Al-Kawakib',
    'Al-Mawed': 'Al-Mawed',
    'Al-Rissalah': 'Al-Rissalah',
    'Al-Thqafa': 'Al-Thqafa',
    'Al-alam': 'Al-Alam',
    'Al-ethnayn wa Aldonya': 'Al-Ethnayn wa Aldonya',
    'Al-ethnayn wa aldonya 2': 'Al-Ethnayn wa Aldonya 2',
    'Al-ethnayn wa aldonya 3': 'Al-Ethnayn wa Aldonya 3'
  };

  var magTooltip = document.createElement('div');
  magTooltip.className = 'about-magazine-tooltip';
  magTooltip.innerHTML =
    '<span class="tip-ref"></span>' +
    '<span class="tip-medium"></span>' +
    '<div class="tip-desc"></div>' +
    '<div class="tip-headline"></div>';
  document.body.appendChild(magTooltip);
  var activeFloat = null;

  function pathPartsFromSrc(raw) {
    var path = (raw || '').split(/[?#]/)[0];
    var parts = path.split('/').filter(Boolean);
    if (parts.length < 2) return null;
    return {
      folder: decodeURIComponent(parts[parts.length - 2]),
      file: decodeURIComponent(parts[parts.length - 1]),
      src: path
    };
  }

  function dataForFloat(img) {
    var parts = pathPartsFromSrc(img.getAttribute('src') || img.src);
    if (!parts) return { ref: '', medium: '—', desc: '', headline: '' };

    var ref = '';
    var medium = '—';
    var desc = '';
    var headline = '';
    var tKey = parts.folder + '/' + parts.file;

    if (window.findIndexRowByImg) {
      var row = window.findIndexRowByImg(parts.src);
      if (row) {
        ref = ((row.querySelector('.col-ref') || {}).textContent || '').trim();
        medium = ((row.querySelector('.col-medium') || {}).textContent || '—').trim().toUpperCase();
        desc = ((row.querySelector('.col-section') || {}).textContent || '').trim();
      }
    }

    if (window.TRANSLATIONS && window.TRANSLATIONS[tKey] && window.TRANSLATIONS[tKey].headline) {
      headline = window.TRANSLATIONS[tKey].headline;
    }

    var archiveData = window.ARCHIVE_CATEGORY_DATA;
    if (medium === '—' && archiveData) {
      var entry = archiveData['library/' + parts.folder + '/|' + parts.file];
      if (entry && entry.primary) medium = entry.primary.toUpperCase();
    }

    if (window.KAWAKIB_DESCRIPTIONS && window.KAWAKIB_DESCRIPTIONS[parts.file]) {
      var caption = window.KAWAKIB_DESCRIPTIONS[parts.file];
      if (caption && caption.en) desc = caption.en;
    }

    if (!desc) {
      desc = 'From the ' + (FOLDER_LABELS[parts.folder] || parts.folder) + ' archive.';
    }

    return { ref: ref, medium: medium, desc: desc, headline: headline };
  }

  function positionMagTooltip(mx, my) {
    var OFFSET_X = 18;
    var OFFSET_Y = 18;
    var tw = magTooltip.offsetWidth;
    var th = magTooltip.offsetHeight;
    var x = mx + OFFSET_X;
    var y = my + OFFSET_Y;
    if (x + tw > window.innerWidth - 8) x = mx - tw - OFFSET_X;
    if (y + th > window.innerHeight - 8) y = my - th - OFFSET_Y;
    magTooltip.style.left = Math.max(8, x) + 'px';
    magTooltip.style.top = Math.max(8, y) + 'px';
  }

  function hideMagTooltip() {
    magTooltip.classList.remove('is-visible');
    if (activeFloat) {
      activeFloat.classList.remove('is-hover');
      activeFloat = null;
    }
  }

  function showMagTooltip(img, e) {
    if (!isMagazineView() || animating) return;
    var data = dataForFloat(img);
    magTooltip.querySelector('.tip-ref').textContent = data.ref;
    magTooltip.querySelector('.tip-medium').textContent = data.medium;
    magTooltip.querySelector('.tip-desc').textContent = data.desc;
    var hlEl = magTooltip.querySelector('.tip-headline');
    hlEl.textContent = data.headline || '';
    hlEl.style.display = data.headline ? '' : 'none';
    if (activeFloat && activeFloat !== img) activeFloat.classList.remove('is-hover');
    activeFloat = img;
    img.classList.add('is-hover');
    magTooltip.classList.add('is-visible');
    positionMagTooltip(e.clientX, e.clientY);
  }

  layer.addEventListener('mouseover', function(e) {
    var img = e.target.closest('.about-magazine-float');
    if (!img || !layer.contains(img)) return;
    showMagTooltip(img, e);
  });

  layer.addEventListener('mousemove', function(e) {
    if (!magTooltip.classList.contains('is-visible')) return;
    if (!isMagazineView() || animating) { hideMagTooltip(); return; }
    positionMagTooltip(e.clientX, e.clientY);
  });

  layer.addEventListener('mouseout', function(e) {
    var img = e.target.closest('.about-magazine-float');
    if (!img) return;
    var related = e.relatedTarget;
    if (related && img.contains(related)) return;
    hideMagTooltip();
  });

  aboutPage.addEventListener('mouseleave', hideMagTooltip);

  new MutationObserver(function() {
    if (!isMagazineView()) hideMagTooltip();
  }).observe(aboutPage, { attributes: true, attributeFilter: ['data-about-view', 'class'] });

  var getTextSafePct = function() {
    var w = layer.clientWidth || window.innerWidth;
    var textW = Math.min(726, w * 0.9);
    var pad = 28;
    var left = Math.max(0, ((w - textW) / 2 - pad) / w);
    var right = Math.min(1, ((w + textW) / 2 + pad) / w);
    return { left: left, right: right };
  }

  function getFloatBox(img, layerW, layerH) {
    var width = FLOAT_W;
    var height = img.offsetHeight || FLOAT_H_EST;
    var left = 0;
    var top = 0;
    if (img.style.left) {
      left = parseFloat(img.style.left) / 100 * layerW;
      top = parseFloat(img.style.top) / 100 * layerH;
    } else if (img.style.right) {
      left = layerW - parseFloat(img.style.right) / 100 * layerW - width;
      top = parseFloat(img.style.top) / 100 * layerH;
    }
    return { left: left, top: top, right: left + width, bottom: top + height };
  }

  function boxesOverlap(a, b, gap) {
    gap = gap || 24;
    return !(a.right + gap < b.left || a.left - gap > b.right || a.bottom + gap < b.top || a.top - gap > b.bottom);
  }

  function intersectsTextSafe(box, safe, layerW, layerH) {
    var textLeft = safe.left * layerW;
    var textRight = safe.right * layerW;
    var textTop = layerH * 0.16;
    var textBottom = layerH * 0.84;
    return !(box.right < textLeft || box.left > textRight || box.bottom < textTop || box.top > textBottom);
  }

  function placeFloatRandom(img, index, placedBoxes) {
    var layerW = layer.clientWidth;
    var layerH = layer.clientHeight;
    var safe = getTextSafePct();
    var side = index % 2 === 0 ? 'left' : 'right';

    for (var t = 0; t < 60; t++) {
      img.style.bottom = '';
      img.style.top = rnd(8, 70) + '%';

      if (side === 'left') {
        var maxLeft = ((safe.left * layerW) - FLOAT_W - 10) / layerW * 100;
        maxLeft = Math.max(1, Math.min(20, maxLeft));
        if (maxLeft < 1.5) { side = 'right'; continue; }
        img.style.left = rnd(1, maxLeft) + '%';
        img.style.right = '';
      } else {
        var maxRight = (layerW - (safe.right * layerW) - FLOAT_W - 10) / layerW * 100;
        maxRight = Math.max(1, Math.min(20, maxRight));
        if (maxRight < 1.5) { side = 'left'; continue; }
        img.style.right = rnd(1, maxRight) + '%';
        img.style.left = '';
      }

      var box = getFloatBox(img, layerW, layerH);
      var blocked = intersectsTextSafe(box, safe, layerW, layerH);
      if (!blocked) {
        for (var i = 0; i < placedBoxes.length; i++) {
          if (boxesOverlap(box, placedBoxes[i])) { blocked = true; break; }
        }
      }
      if (!blocked) {
        placedBoxes.push(box);
        return;
      }
      if (t % 4 === 3) side = side === 'left' ? 'right' : 'left';
    }

    var loose = [
      function() { img.style.left = rnd(2, 12) + '%'; img.style.top = rnd(10, 35) + '%'; img.style.right = ''; },
      function() { img.style.right = rnd(2, 12) + '%'; img.style.top = rnd(38, 62) + '%'; img.style.left = ''; },
      function() { img.style.right = rnd(3, 14) + '%'; img.style.top = rnd(8, 32) + '%'; img.style.left = ''; },
      function() { img.style.left = rnd(2, 12) + '%'; img.style.top = rnd(55, 78) + '%'; img.style.right = ''; }
    ];
    loose[index % loose.length]();
    placedBoxes.push(getFloatBox(img, layerW, layerH));
  }
  var PARALLAX_MULTIPLIERS = [0.94, 1, 0.97, 1.03];
  var FLOAT_EXIT_MS = 1600;
  var FLOAT_ENTER_MS = 1900;

  function floatTravelDistance(i) {
    var frame = layer || document.getElementById('aboutMagazineLayer');
    var h = (frame && frame.clientHeight) || window.innerHeight;
    return h * 1.18 * PARALLAX_MULTIPLIERS[i % PARALLAX_MULTIPLIERS.length];
  }

  function rnd(min, max) {
    return (min + Math.random() * (max - min)).toFixed(1);
  }

  function shuffle(arr) {
    var copy = arr.slice();
    for (var i = copy.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = copy[i]; copy[i] = copy[j]; copy[j] = t;
    }
    return copy;
  }

  function getImagePool(mag) {
    if (!mag) return [];
    if (imagePoolCache[mag.name]) return imagePoolCache[mag.name];
    var seen = {};
    var pool = [];
    (mag.folders || []).forEach(function(folder) {
      var prefix = folder + '/';
      Object.keys(window.TRANSLATIONS || {}).forEach(function(key) {
        if (key.indexOf(prefix) === 0 && !seen[key]) {
          seen[key] = true;
          pool.push(key);
        }
      });
    });
    if (!pool.length) {
      document.querySelectorAll('img[src]').forEach(function(img) {
        var raw = img.getAttribute('src') || img.src || '';
        var path = raw.split(/[?#]/)[0];
        (mag.folders || []).forEach(function(folder) {
          var idx = path.indexOf(folder + '/');
          if (idx >= 0) {
            var slice = path.slice(idx);
            if (!seen[slice]) { seen[slice] = true; pool.push(slice); }
          }
        });
      });
    }
    imagePoolCache[mag.name] = pool.length ? pool : (mag.fallback || []).slice();
    return imagePoolCache[mag.name];
  }

  function applyFloatLayout(img, zoneIndex, src, placedBoxes) {
    img.style.left = '';
    img.style.right = '';
    img.style.top = '';
    img.style.bottom = '';
    img.src = src;
    placeFloatRandom(img, zoneIndex, placedBoxes || []);
  }

  function randomizeMagazineFloats(opts) {
    opts = opts || {};
    if (!floats.length) return Promise.resolve();
    var mag = MAGAZINE_CATALOG[magazineIndex];
    var pool = getImagePool(mag);
    if (!pool.length) return Promise.resolve();
    var picks = shuffle(pool).slice(0, floats.length);
    var token = animToken;
    var placedBoxes = [];

    floats.forEach(function(img, i) {
      applyFloatLayout(img, i, picks[i] || picks[0], placedBoxes);
      if (opts.enterFromBelow) {
        var dist = floatTravelDistance(i);
        img.style.transition = 'none';
        img.style.transform = 'translateY(' + dist + 'px)';
      } else {
        img.style.transition = 'none';
        img.style.transform = 'translateY(0)';
      }
    });
    if (!opts.enterFromBelow) return Promise.resolve();

    void (floats[0] && floats[0].offsetWidth);
    floats.forEach(function(img) {
      img.style.transition = 'transform ' + FLOAT_ENTER_MS + 'ms cubic-bezier(0.76, 0, 0.24, 1)';
      img.style.transform = 'translateY(0)';
    });
    return waitTransformTransition(floats[0], FLOAT_ENTER_MS + 80, token);
  }

  window.randomizeAboutMagazineFloats = randomizeMagazineFloats;

  function isMagazineView() {
    return aboutPage.classList.contains('is-open')
      && aboutPage.getAttribute('data-about-view') === 'magazine';
  }

  function clearAnimFallback() {
    if (animFallbackTimer) {
      clearTimeout(animFallbackTimer);
      animFallbackTimer = null;
    }
  }

  function releaseAnimating(delay) {
    clearAnimFallback();
    animFallbackTimer = setTimeout(function() {
      animFallbackTimer = null;
      animating = false;
    }, delay);
  }

  function waitOpacityTransition(el, ms, token) {
    return new Promise(function(resolve) {
      if (!el) return resolve();
      var settled = false;
      function finish() {
        if (settled || token !== animToken) return;
        settled = true;
        el.removeEventListener('transitionend', onEnd);
        clearTimeout(timer);
        resolve();
      }
      function onEnd(e) {
        if (e.target !== el || e.propertyName !== 'opacity') return;
        finish();
      }
      var timer = setTimeout(finish, ms);
      el.addEventListener('transitionend', onEnd);
      void el.offsetWidth;
    });
  }

  function fadeTitleOut(token) {
    if (!titleEl) return Promise.resolve();
    titleEl.classList.add('is-fading-out');
    void titleEl.offsetWidth;
    return waitOpacityTransition(titleEl, 700, token);
  }

  function fadeTitleIn(token) {
    if (!titleEl) return Promise.resolve();
    titleEl.classList.remove('is-fading-out');
    void titleEl.offsetWidth;
    return waitOpacityTransition(titleEl, 1200, token);
  }

  function waitTransformTransition(el, ms, token) {
    return new Promise(function(resolve) {
      if (!el) return resolve();
      var settled = false;
      function finish() {
        if (settled || token !== animToken) return;
        settled = true;
        el.removeEventListener('transitionend', onEnd);
        clearTimeout(timer);
        resolve();
      }
      function onEnd(e) {
        if (e.target !== el || e.propertyName !== 'transform') return;
        finish();
      }
      var timer = setTimeout(finish, ms);
      el.addEventListener('transitionend', onEnd);
      void el.offsetWidth;
    });
  }

  function fadeSlideOut(slide, token) {
    if (!slide) return Promise.resolve();
    slide.classList.remove('is-active');
    void slide.offsetWidth;
    return waitOpacityTransition(slide, 700, token);
  }

  function fadeSlideIn(slide, token) {
    if (!slide) return Promise.resolve();
    return new Promise(function(resolve) {
      requestAnimationFrame(function() {
        if (token !== animToken) return resolve();
        slide.classList.add('is-active');
        void slide.offsetWidth;
        waitOpacityTransition(slide, 1200, token).then(resolve);
      });
    });
  }

  function setFloatParallax(direction, animate) {
    floats.forEach(function(img, i) {
      var dist = floatTravelDistance(i);
      var y = direction < 0 ? -dist : direction > 0 ? dist : 0;
      img.style.transition = animate
        ? 'transform ' + FLOAT_EXIT_MS + 'ms cubic-bezier(0.76, 0, 0.24, 1)'
        : 'none';
      img.style.transform = 'translateY(' + y + 'px)';
    });
    if (floats.length) void floats[0].offsetWidth;
    if (!animate && floats.length) {
      floats.forEach(function(img) { img.style.transition = ''; });
    }
  }

  function renderSlides(slideTexts, firstActive) {
    track.innerHTML = slideTexts.map(function(text, i) {
      var active = firstActive && i === 0;
      return '<div class="about-magazine-slide' + (active ? ' is-active' : '') + '"><p>' + text + '</p></div>';
    }).join('');
    slides = Array.from(track.querySelectorAll('.about-magazine-slide'));
    index = 0;
  }

  function playMagazineOpening(token) {
    layer.classList.add('is-opening');
    slides.forEach(function(slide) { slide.classList.remove('is-active'); });

    return new Promise(function(resolve) {
      setTimeout(function() {
        if (token !== animToken) return resolve();
        layer.classList.remove('is-opening');
        var first = slides[0];
        Promise.all([
          fadeSlideIn(first, token),
          randomizeMagazineFloats({ enterFromBelow: true })
        ]).then(resolve);
      }, MAGAZINE_OPEN_DELAY_MS);
    });
  }

  function applyMagazine(mag, opts) {
    opts = opts || {};
    if (titleEl) {
      titleEl.textContent = mag.name;
      titleEl.classList.remove('is-fading-out');
    }
    setFloatParallax(0, false);
    clearAnimFallback();
    if (opts.opening) {
      renderSlides(mag.slides, false);
      return playMagazineOpening(animToken);
    }
    renderSlides(mag.slides, true);
    animating = false;
    return Promise.resolve();
  }

  function loadMagazine(nextMagazineIndex, opts) {
    opts = opts || {};
    var count = MAGAZINE_CATALOG.length;
    if (!count) return Promise.resolve();
    var nextIndex = ((nextMagazineIndex % count) + count) % count;
    if (nextIndex === magazineIndex && slides.length && !opts.force) return Promise.resolve();

    hideMagTooltip();
    var mag = MAGAZINE_CATALOG[nextIndex];
    magazineIndex = nextIndex;
    animToken++;
    var token = animToken;
    clearAnimFallback();
    animating = true;
    releaseAnimating(2800 + FLOAT_EXIT_MS + FLOAT_ENTER_MS);

    if (opts.animate && slides.length) {
      var current = slides[index];
      setFloatParallax(-1, true);
      return Promise.all([
        fadeTitleOut(token),
        waitTransformTransition(floats[0], FLOAT_EXIT_MS + 80, token),
        fadeSlideOut(current, token)
      ]).then(function() {
        if (token !== animToken) return;
        if (titleEl) titleEl.textContent = mag.name;
        renderSlides(mag.slides, false);
        index = 0;
        setFloatParallax(0, false);
        var first = slides[0];
        return Promise.all([
          fadeTitleIn(token),
          fadeSlideIn(first, token),
          randomizeMagazineFloats({ enterFromBelow: true })
        ]);
      }).then(function() {
        if (token !== animToken) return;
        animating = false;
        clearAnimFallback();
      });
    }

    if (titleEl) {
      titleEl.textContent = mag.name;
      titleEl.classList.remove('is-fading-out');
    }
    if (opts.opening) {
      releaseAnimating(MAGAZINE_OPEN_DELAY_MS + 2800);
      return applyMagazine(mag, { opening: true }).then(function() {
        animating = false;
        clearAnimFallback();
      });
    }
    return applyMagazine(mag).then(function() {
      return randomizeMagazineFloats();
    }).then(function() {
      animating = false;
      clearAnimFallback();
    });
  }

  function goTo(nextIndex) {
    if (nextIndex < 0 || nextIndex >= slides.length || nextIndex === index) return;
    hideMagTooltip();
    animToken++;
    var token = animToken;
    clearAnimFallback();
    animating = true;
    releaseAnimating(700 + FLOAT_EXIT_MS + FLOAT_ENTER_MS + 200);

    var current = slides[index];
    setFloatParallax(-1, true);

    return Promise.all([
      fadeSlideOut(current, token),
      waitTransformTransition(floats[0], FLOAT_EXIT_MS + 80, token)
    ]).then(function() {
      if (token !== animToken) return;
      index = nextIndex;
      var next = slides[index];
      setFloatParallax(0, false);
      return Promise.all([
        fadeSlideIn(next, token),
        randomizeMagazineFloats({ enterFromBelow: true })
      ]);
    }).then(function() {
      if (token !== animToken) return;
      animating = false;
      clearAnimFallback();
    });
  }

  window.resetAboutMagazineSlides = function() {
    animToken++;
    clearAnimFallback();
    imagePoolCache = {};
    return loadMagazine(0, { force: true, opening: true });
  };

  if (titleEl) {
    titleEl.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (!isMagazineView() || animating) return;
      loadMagazine(magazineIndex + 1, { animate: true });
    });
  }

  loadMagazine(0, { force: true }).then(function() {
    return randomizeMagazineFloats();
  });

  function onWheel(e) {
    if (!isMagazineView()) return;
    e.preventDefault();
    if (animating) return;
    if (e.deltaY > 25 && index < slides.length - 1) goTo(index + 1);
    else if (e.deltaY < -25 && index > 0) goTo(index - 1);
  }

  layer.addEventListener('wheel', onWheel, { passive: false });
  aboutPage.addEventListener('wheel', function(e) {
    if (!isMagazineView()) return;
    e.preventDefault();
  }, { passive: false });

  layer.addEventListener('touchstart', function(e) {
    if (!isMagazineView()) return;
    touchStartY = e.changedTouches[0].clientY;
  }, { passive: true });

  layer.addEventListener('touchend', function(e) {
    if (!isMagazineView() || touchStartY == null) return;
    var delta = touchStartY - e.changedTouches[0].clientY;
    touchStartY = null;
    if (Math.abs(delta) < 40) return;
    if (delta > 0 && index < slides.length - 1) goTo(index + 1);
    else if (delta < 0 && index > 0) goTo(index - 1);
  }, { passive: true });
})();
</script>




<div id="filter-page">
  <div id="filter-close-bar">
    <button id="filter-close-btn">Close</button>
    <button id="filter-reset-btn">Reset filters</button>
  </div>
  <div id="filter-category-head-row" class="fp-group-head-row">
    <div class="fp-group-head">Category</div>
  </div>
  <div id="filter-body">
    <div id="filter-label">Filter by:</div>
    <div id="filter-groups">
      <div class="fp-group">
        <div class="fp-tags">
          <button class="fp-tag is-active" data-fp-cat="all">All</button>
          <button class="fp-tag" data-fp-cat="People">People</button>
          <button class="fp-tag" data-fp-cat="Desires">Desires</button>
          <button class="fp-tag" data-fp-cat="Leisure">Leisure</button>
          <button class="fp-tag" data-fp-cat="Street">Street</button>
        </div>
      </div>
      <div class="fp-group">
        <div class="fp-group-head">Magazine</div>
        <div class="fp-tags">
          <button class="fp-tag is-active" data-fp-mag="all">All</button>
          <button class="fp-tag" data-fp-mag="Al-Kawakib">Al-Kawakib</button>
          <button class="fp-tag" data-fp-mag="Al-Mawed">Al-Mawed</button>
          <button class="fp-tag" data-fp-mag="Al-Rissalah">Al-Rissalah</button>
          <button class="fp-tag" data-fp-mag="Al-Thqafa">Al-Thaqafa</button>
          <button class="fp-tag" data-fp-mag="Al-Alam">Al-Alam</button>
          <button class="fp-tag" data-fp-mag="Al-Ethnayn wa Aldonya">Al-Ethnayn</button>
        </div>
      </div>
      <div class="fp-group">
        <div class="fp-group-head">Year</div>
        <div class="fp-tags">
          <button class="fp-tag is-active" data-fp-year="all">All</button>
          <button class="fp-tag" data-fp-year="1940s">1940s</button>
          <button class="fp-tag" data-fp-year="1950s">1950s</button>
          <button class="fp-tag" data-fp-year="1960s">1960s</button>
        </div>
      </div>
    </div>
  </div>
  <button type="button" class="adx-close-btn" id="filter-close-bottom" aria-label="Close filter">[close]</button>
</div>

<script>
(function () {
  var fp = document.getElementById('filter-page');
  if (!fp) return;

  function syncFilterCategoryAlign() {
    var headRow = document.getElementById('filter-category-head-row');
    var refCol = document.querySelector('#pv-table-head [data-pv-sort="reference"]');
    var preview = document.getElementById('preview-page');
    if (!headRow || !fp) return;

    headRow.style.marginTop = '';
    headRow.style.minHeight = '';

    if (!fp.classList.contains('is-open') || !preview || !preview.classList.contains('is-open') || !refCol) {
      return;
    }

    var refRect = refCol.getBoundingClientRect();
    var fpRect = fp.getBoundingClientRect();
    headRow.style.minHeight = refRect.height + 'px';
    headRow.style.marginTop = Math.max(0, refRect.top - fpRect.top) + 'px';
  }
  window.syncFilterCategoryAlign = syncFilterCategoryAlign;
  window.addEventListener('resize', syncFilterCategoryAlign);

  function openFilter() {
    fp.classList.add('is-open');
    if (window.updateFilterCounts) window.updateFilterCounts();
    if (window.refreshFilterSubnav) window.refreshFilterSubnav();
    requestAnimationFrame(function() {
      syncFilterCategoryAlign();
      requestAnimationFrame(syncFilterCategoryAlign);
    });
  }
  function closeFilter() {
    fp.classList.remove('is-open');
    syncFilterCategoryAlign();
    if (window.refreshFilterSubnav) window.refreshFilterSubnav();
  }
  function toggleFilter() { fp.classList.contains('is-open') ? closeFilter() : openFilter(); }

  var closeBtn = document.getElementById('filter-close-btn');
  if (closeBtn) closeBtn.addEventListener('click', closeFilter);

  var closeBtnBottom = document.getElementById('filter-close-bottom');
  if (closeBtnBottom) closeBtnBottom.addEventListener('click', closeFilter);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && fp.classList.contains('is-open')) closeFilter();
  });

  function isFilterToggleClick(target) {
    return !!(target && target.closest && target.closest('#gab-filter-btn, .csn-item--filter'));
  }

  document.addEventListener('click', function(e) {
    if (!fp.classList.contains('is-open')) return;
    if (fp.contains(e.target)) return;
    if (isFilterToggleClick(e.target)) return;
    closeFilter();
  }, true);

  var previewPage = document.getElementById('preview-page');
  if (previewPage) {
    previewPage.addEventListener('click', function(e) {
      if (!fp.classList.contains('is-open')) return;
      if (fp.contains(e.target)) return;
      closeFilter();
    });
  }

  document.getElementById('filter-reset-btn').addEventListener('click', function() {
    fp.querySelectorAll('.fp-tag').forEach(function(t) { t.classList.remove('is-active'); });
    fp.querySelector('[data-fp-cat="all"]').classList.add('is-active');
    fp.querySelector('[data-fp-mag="all"]').classList.add('is-active');
    fp.querySelector('[data-fp-year="all"]').classList.add('is-active');
    if (window.filterGalleryByCategory) window.filterGalleryByCategory('all');
    document.querySelectorAll('#main .sc-gLDymS').forEach(function(f) { f.classList.remove('filter-hidden'); });
    document.querySelectorAll('#pv-table-wrap .pv-row:not(.pv-row-head)').forEach(function(row) { row.style.display = ''; });
    updateFilterCounts();
    if (typeof window.refreshPvRows === 'function') window.refreshPvRows();
    animateFilteredIndexRows();
    // Restore the full scatter spread if a filter had compacted it.
    if (window.repackCanvasForFilter) window.repackCanvasForFilter();
  });

  function activeVals(dim) {
    var attr = 'data-fp-' + dim;
    var active = Array.prototype.slice.call(
      fp.querySelectorAll('.fp-tag[' + attr + '].is-active')
    ).map(function(el) { return el.getAttribute(attr); }).filter(Boolean);
    if (!active.length || active.indexOf('all') !== -1) return null;
    return active;
  }

  function matchesDim(vals, actual) {
    if (!vals) return true;
    if (!actual) return false;
    return vals.indexOf(actual) !== -1;
  }

  function matchesCatText(vals, catText) {
    if (!vals) return true;
    var lower = (catText || '').toLowerCase();
    return vals.some(function(v) { return lower === v.toLowerCase(); });
  }

  function matchesMagFolder(vals, folder) {
    if (!vals) return true;
    var f = (folder || '').toLowerCase();
    return vals.some(function(v) { return f.indexOf(v.toLowerCase()) === 0; });
  }

  function toggleFpTag(dim, btn) {
    var attr = 'data-fp-' + dim;
    var val = btn.getAttribute(attr);
    var allBtn = fp.querySelector('.fp-tag[' + attr + '="all"]');
    var sectionBtns = fp.querySelectorAll('.fp-tag[' + attr + ']');

    if (val === 'all') {
      sectionBtns.forEach(function(b) { b.classList.remove('is-active'); });
      if (allBtn) allBtn.classList.add('is-active');
    } else {
      if (allBtn) allBtn.classList.remove('is-active');
      btn.classList.toggle('is-active');
      var activeSpecific = Array.prototype.filter.call(sectionBtns, function(b) {
        return b.getAttribute(attr) !== 'all' && b.classList.contains('is-active');
      });
      if (!activeSpecific.length && allBtn) allBtn.classList.add('is-active');
    }

    applyGalleryFilter();
    applyIndexFilter();
    updateFilterCounts();
    refreshSubnavAfterFilter();
  }

  function applyIndexFilter() {
    var activeCats  = activeVals('cat');
    var activeMags  = activeVals('mag');
    var activeYears = activeVals('year');

    document.querySelectorAll('#pv-table-wrap .pv-row:not(.pv-row-head)').forEach(function(row) {
      var folder  = row.getAttribute('data-folder') || '';
      var catText = (row.querySelector('.col-medium') || {}).textContent || '';

      var catMatch = matchesCatText(activeCats, catText);
      var magMatch = matchesMagFolder(activeMags, folder);

      var yearMatch = true;
      if (activeYears) {
        var meta = window.MAGAZINE_META && window.MAGAZINE_META[folder];
        var dateStr = meta ? (meta.date || '') : '';
        var firstYear = parseInt(dateStr, 10);
        if (!isNaN(firstYear)) {
          var decade = String(Math.floor(firstYear / 10) * 10) + 's';
          yearMatch = activeYears.indexOf(decade) !== -1;
        } else {
          yearMatch = false;
        }
      }

      row.style.display = (catMatch && magMatch && yearMatch) ? '' : 'none';
    });
    if (typeof window.refreshPvRows === 'function') window.refreshPvRows();
    animateFilteredIndexRows();
  }

  // Cascade the surviving rows in one-by-one after a filter change. Only the
  // first STAGGER_CAP visible rows animate (that's all that fits the viewport);
  // the rest just appear, so filtering to a large set like Al-Mawed (~246 rows)
  // never animates hundreds of elements at once. The animation is restarted by
  // removing the class, flushing one reflow, then re-adding it — moving/showing
  // a row doesn't restart a CSS animation on its own.
  function animateFilteredIndexRows() {
    var wrap = document.getElementById('pv-table-wrap');
    if (!wrap) return;
    var rows = wrap.querySelectorAll('.pv-row:not(.pv-row-head)');
    var STEP_MS = 42, HARD_CAP = 60;
    for (var i = 0; i < rows.length; i++) {
      rows[i].classList.remove('pv-filter-in');
      rows[i].style.animationDelay = '';
    }
    void wrap.offsetWidth; // commit the reset so the animation can restart

    // Animate exactly the rows that sit within the visible scroll area, so the
    // last on-screen rows never pop in instantly (a fixed cap couldn't know how
    // many rows fit — that depends on the screen height). All measuring happens
    // before any class writes to avoid layout thrash. HARD_CAP bounds the
    // stagger on very tall screens so the cascade can't run absurdly long.
    var visible = [];
    for (var j = 0; j < rows.length; j++) {
      if (rows[j].style.display !== 'none') visible.push(rows[j]);
    }
    var foldY = wrap.getBoundingClientRect().bottom + 60; // small buffer past the fold
    var animateN = 0;
    while (animateN < visible.length && animateN < HARD_CAP &&
           visible[animateN].getBoundingClientRect().top <= foldY) {
      animateN++;
    }
    if (animateN < 1 && visible.length) animateN = 1;
    for (var m = 0; m < animateN; m++) {
      visible[m].classList.add('pv-filter-in');
      visible[m].style.animationDelay = (m * STEP_MS) + 'ms';
    }
  }
  // Reused by the index page's open() so first-entry uses the same cascade.
  window.animateIndexRowsCascade = animateFilteredIndexRows;

  function refreshSubnavAfterFilter() {
    if (typeof window.refreshIndexSubnav === 'function') window.refreshIndexSubnav();
  }

  // ── Per-document dimension lookups (source of truth = gallery figures) ──
  function figImgParts(fig) {
    var img = fig.querySelector('img');
    if (!img) return null;
    var raw = img.getAttribute('src') || img.src || '';
    if (!raw) return null;
    var parts = raw.split(/[?#]/)[0].split('/').filter(Boolean);
    if (parts.length < 2) return null;
    return {
      folder: decodeURIComponent(parts[parts.length - 2]),
      file: decodeURIComponent(parts[parts.length - 1]),
    };
  }
  function figCat(fig) {
    var archive = window.ARCHIVE_CATEGORY_DATA;
    var p = archive && figImgParts(fig);
    if (!p) return '';
    var entry = archive['library/' + p.folder + '/|' + p.file];
    return (entry && entry.primary) || '';
  }
  function figMag(fig) { return fig.getAttribute('data-magazine') || ''; }
  function figDecade(fig) {
    var p = figImgParts(fig);
    if (!p) return '';
    var meta = window.MAGAZINE_META && window.MAGAZINE_META[p.folder];
    var y = meta ? parseInt(meta.date, 10) : NaN;
    if (isNaN(y)) return '';
    return String(Math.floor(y / 10) * 10) + 's';
  }

  function activeVal(dim) {
    var vals = activeVals(dim);
    return vals ? vals[0] : 'all';
  }

  // Unified gallery filter: a document shows when it matches ALL three
  // active dimensions (category · magazine · year). Within each dimension,
  // multiple selections are OR'd; "All" means no restriction.
  function applyGalleryFilter() {
    var aCat = activeVals('cat'), aMag = activeVals('mag'), aYear = activeVals('year');
    document.querySelectorAll('#main .sc-gLDymS').forEach(function(fig) {
      var show =
        matchesDim(aCat, figCat(fig)) &&
        matchesDim(aMag, figMag(fig)) &&
        matchesDim(aYear, figDecade(fig));
      fig.classList.toggle('filter-hidden', !show);
    });
    // Gather a small result set into a compact, framed cluster (or restore the
    // full spread when the filter is cleared / the set is large).
    if (window.repackCanvasForFilter) window.repackCanvasForFilter();
  }

  // Facet counts: for each option, how many documents would show if it were
  // enabled — honouring the currently-active selection in the OTHER two
  // dimensions.
  function updateFilterCounts() {
    var figs = document.querySelectorAll('#main .sc-gLDymS');
    var dims = [];
    figs.forEach(function(fig) {
      dims.push({ cat: figCat(fig), mag: figMag(fig), year: figDecade(fig) });
    });
    var aCat = activeVals('cat'), aMag = activeVals('mag'), aYear = activeVals('year');

    function countFor(dim, val) {
      var wantCat  = dim === 'cat'  ? (val === 'all' ? null : [val]) : aCat;
      var wantMag  = dim === 'mag'  ? (val === 'all' ? null : [val]) : aMag;
      var wantYear = dim === 'year' ? (val === 'all' ? null : [val]) : aYear;
      var c = 0;
      for (var i = 0; i < dims.length; i++) {
        var d = dims[i];
        if (matchesDim(wantCat, d.cat) &&
            matchesDim(wantMag, d.mag) &&
            matchesDim(wantYear, d.year)) c++;
      }
      return c;
    }

    fp.querySelectorAll('.fp-tag').forEach(function(btn) {
      var dim = null, val = null;
      if (btn.dataset.fpCat != null)       { dim = 'cat';  val = btn.dataset.fpCat; }
      else if (btn.dataset.fpMag != null)  { dim = 'mag';  val = btn.dataset.fpMag; }
      else if (btn.dataset.fpYear != null) { dim = 'year'; val = btn.dataset.fpYear; }
      if (!dim) return;
      var n = countFor(dim, val);
      var span = btn.querySelector('.fp-count');
      if (!span) { span = document.createElement('span'); span.className = 'fp-count'; btn.appendChild(span); }
      span.textContent = n;
      btn.classList.toggle('fp-empty', n === 0 && val !== 'all');
    });
  }
  window.updateFilterCounts = updateFilterCounts;

  fp.querySelectorAll('.fp-tag[data-fp-cat]').forEach(function(btn) {
    btn.addEventListener('click', function() { toggleFpTag('cat', btn); });
  });

  fp.querySelectorAll('.fp-tag[data-fp-mag]').forEach(function(btn) {
    btn.addEventListener('click', function() { toggleFpTag('mag', btn); });
  });

  fp.querySelectorAll('.fp-tag[data-fp-year]').forEach(function(btn) {
    btn.addEventListener('click', function() { toggleFpTag('year', btn); });
  });

  document.getElementById('filter-reset-btn').addEventListener('click', function() {
    refreshSubnavAfterFilter();
  });

  window.openFilter  = openFilter;
  window.closeFilter = closeFilter;
  window.toggleFilter = toggleFilter;

  // Populate counts once the archive/metadata are ready. Retry briefly in case
  // ARCHIVE_CATEGORY_DATA loads slightly after this script.
  (function initCounts(tries) {
    if (window.ARCHIVE_CATEGORY_DATA || tries <= 0) { updateFilterCounts(); if (window.ARCHIVE_CATEGORY_DATA) return; }
    if (tries > 0) setTimeout(function() { initCounts(tries - 1); }, 200);
  })(10);
})();
</script>

