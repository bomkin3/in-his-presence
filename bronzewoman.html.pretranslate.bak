          <span class="order-doc-focus__ref" id="orderDocFocusRef"></span>
          <span class="order-doc-focus__desc" id="orderDocFocusDesc"></span>
          <span class="order-doc-focus__ar" id="orderDocFocusAr" dir="rtl" lang="ar"></span>
        </figcaption>
      </figure>
    </div>

    <!-- ───────── Archive document detail overlay (opened from the Index) ───────── -->
    <div class="adx-overlay" id="adxOverlay" aria-hidden="true">
      <div class="adx-split">
        <aside class="adx-split-meta">
          <div class="adx-meta-main">
          <div class="adx-meta-field adx-meta-field--headline">
            <div class="adx-meta-field__label">Headline</div>
            <h1 class="adx-doc-title" id="adxTitle"></h1>
          </div>

          <div class="adx-meta-row">
            <div class="adx-meta-field">
              <div class="adx-meta-field__label">Publisher</div>
              <div class="adx-meta-field__value"><span class="adx-meta-pill" id="adxPublisher">—</span></div>
            </div>
            <div class="adx-meta-field">
              <div class="adx-meta-field__label">Year</div>
              <div class="adx-meta-field__value"><span class="adx-meta-pill" id="adxYear">—</span></div>
            </div>
